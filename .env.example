# =============================================================================
# SKO website — environment variables
#
# Copy to .env for local development. NEVER commit .env (it is git-ignored).
# On Vercel, configure variables separately for Preview and Production in the
# project environment settings. See docs/14-vercel-preview.md.
#
# RULE: anything prefixed PUBLIC_ is inlined into the browser bundle by Astro.
#       Anything without that prefix must NEVER be referenced from src/ —
#       server-only values are read through process.env in api/contact.ts and
#       passed to the shared functions/ handler, never imported into src/.
# =============================================================================

# --- Sanity (build-time reads; PUBLIC because the build inlines them) --------
# The dataset is PUBLIC and read without a token by design — see ADR-004.
# There is deliberately no SANITY_TOKEN in this file. Do not add one.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2026-01-01

# Leave PUBLIC_SANITY_PROJECT_ID blank to build against local fixture content
# in src/lib/content/fixtures.ts. The build logs which mode it used.

# --- Site -------------------------------------------------------------------
# Local URL only. Leave unset on Vercel Preview to use its generated HTTPS URL.
PUBLIC_SITE_URL=http://localhost:4321
# Local mode only. Vercel supplies VERCEL_ENV; do not copy this development value
# into Vercel's Preview or Production settings.
PUBLIC_DEPLOYMENT_ENV=development
PUBLIC_CONTENT_SOURCE=fixtures
PUBLIC_CONTACT_ENABLED=false

# --- Cloudflare Turnstile ---------------------------------------------------
# Site key is public by design. Secret key is server-only.
# Test keys for local dev: https://developers.cloudflare.com/turnstile/troubleshooting/testing/
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Email delivery (Resend) — SERVER ONLY ----------------------------------
# Keep delivery disabled in Preview; do not add production email credentials.
CONTACT_ENABLED=false
RESEND_API_KEY=
MAIL_FROM=noreply@example.org
CONTACT_TO_EMAIL=
PARTNER_TO_EMAIL=

# --- Analytics --------------------------------------------------------------
PUBLIC_CF_ANALYTICS_TOKEN=

# --- Vercel WAF rate limiting — SERVER ONLY ---------------------------------
# Set true only after blocking protection for /api/contact and /api/contact/
# is published and tested before function execution. A logging rule is not enough.
# This flag acknowledges upstream protection; it does not create a rate limiter.
CONTACT_WAF_RATE_LIMIT_ENABLED=false
