---
import "~/styles/global.css";

import { htmlLang, type Locale } from "~/lib/i18n/config";
import { t } from "~/lib/i18n/utils";
import { getSiteSettings } from "~/lib/content";
import type { CmsImage } from "~/lib/content/types";
import Header from "~/components/layout/Header.astro";
import Footer from "~/components/layout/Footer.astro";
import SeoHead from "~/components/seo/SeoHead.astro";
import { isPreviewDeployment } from "~/lib/config";

interface Props {
  lang: Locale;
  title: string;
  description?: string;
  ogImage?: CmsImage | null;
  noindex?: boolean;
  publishedAt?: string | null;
  /** Extra schema.org node for this page type, e.g. Article or JobPosting. */
  jsonLd?: Record<string, unknown> | null;
}

const { lang, title, description, ogImage, noindex, publishedAt, jsonLd } =
  Astro.props;

const settings = await getSiteSettings();
const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    {
      /*
      Replaced at build time by scripts/csp.mjs with this page's own policy,
      including SHA-256 hashes for its inline structured-data scripts. Must come
      before anything it governs. `frame-ancestors` lives in public/_headers
      because a meta-delivered policy cannot set it.
    */
    }
    <meta http-equiv="Content-Security-Policy" content="__CSP_POLICY__" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#f5f2ea" />

    {
      /*
      Preload only the font this locale sets its body copy in. The other script
      still loads — the language toggle renders "ខ្មែរ" on English pages — but it
      loads lazily with font-display: swap, so it never blocks LCP for one word
      of chrome.
    */
    }
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
      href={lang === "km"
        ? "/fonts/kantumruy-pro-khmer.woff2"
        : "/fonts/hanken-grotesk-latin.woff2"}
    />
    <SeoHead
      lang={lang}
      pathname={pathname}
      title={title}
      description={description}
      ogImage={ogImage}
      noindex={noindex}
      settings={settings}
      publishedAt={publishedAt}
      jsonLd={jsonLd}
    />
  </head>
  <body class="bg-canvas">
    <a
      href="#main"
      class="sr-only-focusable absolute top-3 left-3 z-[100] bg-indigo-700 px-4 py-3 text-[15px] font-medium text-white no-underline"
    >
      {t(lang, "skipToContent")}
    </a>

    {
      isPreviewDeployment && (
        <aside
          class="border-b border-terracotta-700 bg-canvas px-4 py-3 text-center text-[14px] text-terracotta-700"
          aria-label="Preview notice"
        >
          {lang === "km"
            ? "គេហទំព័រសាកល្បង — ខ្លឹមសារ និងព័ត៌មានបរិច្ចាគមិនទាន់ត្រូវបានអនុម័ត។"
            : "Preview website — content and donation details are not yet approved. Do not use this site to make donations."}
        </aside>
      )
    }

    <Header lang={lang} pathname={pathname} settings={settings} />

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <Footer lang={lang} settings={settings} />
  </body>
</html>
