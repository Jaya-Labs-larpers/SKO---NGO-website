---
import '~/styles/global.css';

import { htmlLang, type Locale } from '~/lib/i18n/config';
import { t } from '~/lib/i18n/utils';
import { getSiteSettings } from '~/lib/content';
import type { CmsImage } from '~/lib/content/types';
import Header from '~/components/layout/Header.astro';
import Footer from '~/components/layout/Footer.astro';
import ButterflyCursor from '~/components/media/ButterflyCursor.astro';
import PageLoader from '~/components/layout/PageLoader.astro';
import SeoHead from '~/components/seo/SeoHead.astro';

interface Props {
  lang: Locale;
  title: string;
  description?: string;
  ogImage?: CmsImage | null;
  noindex?: boolean;
  publishedAt?: string | null;
  /** Extra schema.org node for this page type, e.g. Article or BreadcrumbList. */
  jsonLd?: Record<string, unknown> | null;
  /**
   * Float the header over the page's own opening art instead of giving it a
   * white band. Only for pages whose first element is a full-bleed hero that
   * reaches the top of the window.
   */
  headerOverlay?: boolean;
  /** Play the intro (PageLoader) when a visit starts on this page. */
  intro?: boolean;
}

const { lang, title, description, ogImage, noindex, publishedAt, jsonLd, headerOverlay, intro } =
  Astro.props;

const settings = await getSiteSettings();
const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    {
      /*
      Replaced at build time by scripts/csp.mjs with this page's own policy,
      including SHA-256 hashes for its inline structured-data scripts. Must come
      before anything it governs. `frame-ancestors` lives in public/_headers
      because a meta-delivered policy cannot set it.
    */
    }
    <meta http-equiv="Content-Security-Policy" content="__CSP_POLICY__" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0962B7" />

    {
      /*
      Preload only the font this locale sets its body copy in. The other script
      still loads — the language toggle renders "ខ្មែរ" on English pages — but it
      loads lazily with font-display: swap, so it never blocks LCP for one word
      of chrome.
    */
    }
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
      href={lang === 'km' ? '/fonts/kantumruy-pro-khmer.woff2' : '/fonts/inter-latin.woff2'}
    />
    <SeoHead
      lang={lang}
      pathname={pathname}
      title={title}
      description={description}
      ogImage={ogImage}
      noindex={noindex}
      settings={settings}
      publishedAt={publishedAt}
      jsonLd={jsonLd}
    />

    {
      /*
      Marks a page reached by a view transition so it lazy-loads in (Page
      arrival in global.css). pagereveal fires just before the first frame,
      so this has to be inline in the head. The mark is dropped once the
      slowest arrival (270ms late, 900ms long) has played, and on pageswap
      before this page is captured on the way out, so a page brought back from
      the back/forward cache arrives afresh.
    */
    }
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var settled = 0;
        addEventListener('pagereveal', function (event) {
          if (!event.viewTransition) return;
          root.setAttribute('data-arriving', '');
          clearTimeout(settled);
          settled = setTimeout(function () {
            root.removeAttribute('data-arriving');
          }, 1500);
        });
        addEventListener('pageswap', function () {
          clearTimeout(settled);
          root.removeAttribute('data-arriving');
        });
      })();
    </script>
  </head>
  <body class="bg-white">
    {intro && <PageLoader />}

    <a
      href="#main"
      class="sr-only-focusable absolute top-3 left-3 z-[100] rounded-[var(--radius-md)] bg-[color:var(--color-blue-700)] px-4 py-3 text-[15px] font-semibold text-white no-underline"
    >
      {t(lang, 'skipToContent')}
    </a>

    <Header lang={lang} pathname={pathname} settings={settings} overlay={headerOverlay} />

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <Footer lang={lang} settings={settings} pathname={pathname} />

    <ButterflyCursor />

    <script>
      import { revealOnEntry } from '~/lib/reveal';

      revealOnEntry();
    </script>
  </body>
</html>
