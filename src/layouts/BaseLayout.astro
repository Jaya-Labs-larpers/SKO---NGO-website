---
import '~/styles/global.css';

import { htmlLang, type Locale } from '~/lib/i18n/config';
import { t } from '~/lib/i18n/utils';
import { getSiteSettings } from '~/lib/content';
import { gtmId, hasSanity } from '~/lib/config';
import type { CmsImage } from '~/lib/content/types';
import { hasImage, imageSrcSet, imageUrl } from '~/lib/sanity/image';
import Header from '~/components/layout/Header.astro';
import Footer from '~/components/layout/Footer.astro';
import SeoHead from '~/components/seo/SeoHead.astro';

interface Props {
  lang: Locale;
  title: string;
  description?: string;
  ogImage?: CmsImage | null;
  noindex?: boolean;
  plainTitle?: boolean;
  publishedAt?: string | null;
  /** Extra schema.org node for this page type, e.g. Article or BreadcrumbList. */
  jsonLd?: Record<string, unknown> | null;
  /** Extra properties for the Organization node. */
  orgJsonLd?: Record<string, unknown> | null;
  /**
   * Load GTM and Cloudflare Insights. Off on the donate pages, where no
   * third-party script may run alongside the QR codes.
   */
  analytics?: boolean;
  /** The photo that will be the page's largest paint, preloaded from the head. */
  lcpImage?: CmsImage | null;
  /** The `sizes` the page gives that photo, so the preload picks the same file. */
  lcpSizes?: string;
}

const {
  lang,
  title,
  description,
  ogImage,
  noindex,
  plainTitle,
  publishedAt,
  jsonLd,
  orgJsonLd,
  analytics = true,
  lcpImage,
  lcpSizes = '100vw',
} = Astro.props;

const settings = await getSiteSettings();
const lcpSrc = lcpImage && hasImage(lcpImage) ? imageUrl(lcpImage, { width: 828 }) : null;
const lcpSrcset = lcpSrc && lcpImage ? imageSrcSet(lcpImage) : null;
const pathname = Astro.url.pathname;
/*
  GTM waits for the page's own load and then for an idle moment, so its download
  and parse never compete with the first paint. Page views are still counted:
  GTM fires its own page-view from the dataLayer once it starts.
*/
const gtmLoader = gtmId
  ? `(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','${gtmId}');`
  : '';
const gtmSnippet =
  analytics &&
  gtmLoader &&
  `(function(){var go=function(){${gtmLoader}};var idle=function(){(window.requestIdleCallback||function(f){setTimeout(f,1)})(go,{timeout:4000})};if(document.readyState==='complete')idle();else addEventListener('load',idle);})();`;
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    {
      /*
      Replaced at build time by scripts/csp.mjs with this page's own policy,
      including SHA-256 hashes for its inline structured-data scripts. Must come
      before anything it governs. `frame-ancestors` lives in public/_headers
      because a meta-delivered policy cannot set it.
    */
    }
    <meta http-equiv="Content-Security-Policy" content="__CSP_POLICY__" />
    {gtmSnippet && <script is:inline set:html={gtmSnippet} />}
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ffffff" />

    {
      /*
      Preload what the first paint needs, and no more: the locale's body font,
      the display face the headline is set in, and the header logo (only the
      lockup this screen width will show). The other script still loads — the
      language toggle renders "ខ្មែរ" on English pages — but lazily, under
      font-display: swap, so it never blocks LCP for one word of chrome.
    */
    }
    {
      (lang === 'km'
        ? ['kantumruy-pro-khmer', 'source-sans-3-latin']
        : ['source-sans-3-latin', 'manrope-latin']
      ).map((font) => (
        <link
          rel="preload"
          as="font"
          type="font/woff2"
          crossorigin="anonymous"
          href={`/fonts/${font}.woff2`}
        />
      ))
    }
    {hasSanity && <link rel="preconnect" href="https://cdn.sanity.io" />}
    {
      lcpSrc && (
        <link
          rel="preload"
          as="image"
          href={lcpSrc}
          imagesrcset={lcpSrcset ?? undefined}
          imagesizes={lcpSizes}
          fetchpriority="high"
        />
      )
    }
    <link
      rel="preload"
      as="image"
      type="image/svg+xml"
      href="/logo/sko-emblem.svg"
      media="(max-width: 63.999rem)"
    />
    <link
      rel="preload"
      as="image"
      type="image/svg+xml"
      href="/logo/sko-logo-full-colour.svg"
      media="(min-width: 64rem)"
    />
    <SeoHead
      lang={lang}
      pathname={pathname}
      title={title}
      description={description}
      ogImage={ogImage}
      noindex={noindex}
      plainTitle={plainTitle}
      settings={settings}
      publishedAt={publishedAt}
      jsonLd={jsonLd}
      orgJsonLd={orgJsonLd}
      analytics={analytics}
    />
  </head>
  <body class="bg-white">
    {
      analytics && gtmId && (
        <noscript>
          <iframe
            src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
            height="0"
            width="0"
            style="display:none;visibility:hidden"
          />
        </noscript>
      )
    }
    <a
      href="#main"
      class="sr-only-focusable absolute top-3 left-3 z-[100] rounded-[var(--radius-md)] bg-[color:var(--color-blue-700)] px-4 py-3 text-[15px] font-semibold text-white no-underline"
    >
      {t(lang, 'skipToContent')}
    </a>

    <Header lang={lang} pathname={pathname} settings={settings} />

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <Footer lang={lang} settings={settings} />
  </body>
</html>
