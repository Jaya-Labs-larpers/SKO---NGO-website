---
import { htmlLang, locales, ogLocale, type Locale } from '~/lib/i18n/config';
import { alternatePath } from '~/lib/i18n/utils';
import { cfAnalyticsToken, siteUrl } from '~/lib/config';
import type { CmsImage, SiteSettings } from '~/lib/content/types';
import { hasImage, imageUrl } from '~/lib/sanity/image';
import { text } from '~/lib/i18n/utils';

interface Props {
  lang: Locale;
  pathname: string;
  title: string;
  description?: string;
  ogImage?: CmsImage | null;
  noindex?: boolean;
  settings: SiteSettings;
  /** Article publish date, when the page is a news/story item. */
  publishedAt?: string | null;
  /** Extra schema.org node for this page type. */
  jsonLd?: Record<string, unknown> | null;
}

const {
  lang,
  pathname,
  title,
  description,
  ogImage,
  noindex,
  settings,
  publishedAt,
  jsonLd: extraJsonLd,
} = Astro.props;

const orgName = text(settings.orgName, lang);
const fullTitle = title === orgName ? title : `${title} · ${orgName}`;
const canonical = new URL(pathname, siteUrl).href;

const shareImage = ogImage ?? settings.ogImage ?? null;
const shareImageUrl = shareImage && hasImage(shareImage)
  ? imageUrl(shareImage, { width: 1200, height: 630 })
  : null;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NGO',
  name: orgName,
  url: siteUrl,
  ...(settings.email ? { email: settings.email } : {}),
  ...(settings.phone ? { telephone: settings.phone } : {}),
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Phnom Penh',
    addressCountry: 'KH',
    ...(text(settings.address, lang) ? { streetAddress: text(settings.address, lang) } : {}),
  },
  ...(settings.socials && settings.socials.length > 0
    ? { sameAs: settings.socials.map((social) => social.url) }
    : {}),
  foundingDate: '2007',
};
---

<title>{fullTitle}</title>
{description && <meta name="description" content={description} />}
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

{
  locales.map((locale) => (
    <link
      rel="alternate"
      hreflang={htmlLang[locale]}
      href={new URL(alternatePath(pathname, locale), siteUrl).href}
    />
  ))
}
<link rel="alternate" hreflang="x-default" href={new URL(alternatePath(pathname, 'en'), siteUrl).href} />

<meta property="og:type" content={publishedAt ? 'article' : 'website'} />
<meta property="og:site_name" content={orgName} />
<meta property="og:title" content={fullTitle} />
{description && <meta property="og:description" content={description} />}
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={ogLocale[lang]} />
{shareImageUrl && <meta property="og:image" content={shareImageUrl} />}
{publishedAt && <meta property="article:published_time" content={publishedAt} />}

<meta name="twitter:card" content={shareImageUrl ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={fullTitle} />
{description && <meta name="twitter:description" content={description} />}
{shareImageUrl && <meta name="twitter:image" content={shareImageUrl} />}

<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
{extraJsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(extraJsonLd)} />}

{
  cfAnalyticsToken && (
    <script
      is:inline
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon={`{"token": "${cfAnalyticsToken}"}`}
    />
  )
}
