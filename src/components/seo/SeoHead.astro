---
import { htmlLang, locales, ogLocale, type Locale } from '~/lib/i18n/config';
import { alternatePath } from '~/lib/i18n/utils';
import { cfAnalyticsToken, siteUrl, preventIndexing } from '~/lib/config';
import type { CmsImage, SiteSettings } from '~/lib/content/types';
import { hasImage, imageUrl } from '~/lib/sanity/image';
import { text } from '~/lib/i18n/utils';
import { serializeJsonLd } from '~/lib/seo/json-ld';

interface Props {
  lang: Locale;
  pathname: string;
  title: string;
  description?: string;
  ogImage?: CmsImage | null;
  noindex?: boolean;
  /** The title is already complete; do not append the organisation's short name. */
  plainTitle?: boolean;
  settings: SiteSettings;
  /** Article publish date, when the page is a news/story item. */
  publishedAt?: string | null;
  /** Extra schema.org node for this page type. */
  jsonLd?: Record<string, unknown> | null;
  /** Extra properties for the Organization node, e.g. opening hours on the contact page. */
  orgJsonLd?: Record<string, unknown> | null;
}

const {
  lang,
  pathname,
  title,
  description,
  ogImage,
  noindex,
  plainTitle = false,
  settings,
  publishedAt,
  jsonLd: extraJsonLd,
  orgJsonLd,
} = Astro.props;

const orgName = text(settings.orgName, lang);
const brand = settings.orgShortName ?? 'SKO';
const fullTitle = plainTitle ? title : `${title} · ${brand}`;
const canonical = new URL(pathname, siteUrl).href;

const shareImage = ogImage ?? settings.ogImage ?? null;
const shareImagePath =
  shareImage && hasImage(shareImage) ? imageUrl(shareImage, { width: 1200, height: 630 }) : null;
const share = shareImagePath
  ? {
      url: new URL(shareImagePath, siteUrl).href,
      alt: text(shareImage!.alt, lang) || orgName,
      width: null,
      height: null,
      type: null,
    }
  : {
      url: new URL('/og-image.png', siteUrl).href,
      alt: `${orgName} logo`,
      width: 1200,
      height: 630,
      type: 'image/png',
    };

/**
 * Organization node.
 *
 * Deliberately specific. A generative engine asked "which NGOs work on child
 * protection in Phnom Penh?" has to be able to tell this SKO apart from every
 * other organisation sharing those initials — so this carries the alternate
 * name, the registration, the area served and what the organisation actually
 * works on, not just a name and a URL.
 */
const logoUrl =
  settings.logo && hasImage(settings.logo) ? imageUrl(settings.logo, { width: 512 }) : null;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NGO',
  '@id': `${siteUrl}/#organization`,
  name: orgName,
  alternateName: ['SKO', 'Samatapheap Khnom Organization', 'អង្គការសមត្ថភាពខ្ញុំ'],
  url: siteUrl,
  ...(logoUrl ? { logo: logoUrl, image: logoUrl } : {}),
  description: text(settings.tagline, lang) || undefined,
  ...(settings.email ? { email: settings.email } : {}),
  ...(settings.phone ? { telephone: settings.phone } : {}),
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Phnom Penh',
    addressCountry: 'KH',
    ...(text(settings.address, lang)
      ? { streetAddress: text(settings.address, lang).replace(/\s*\n\s*/g, ' ') }
      : {}),
  },
  areaServed: {
    '@type': 'City',
    name: 'Phnom Penh',
    containedInPlace: { '@type': 'Country', name: 'Cambodia' },
  },
  knowsAbout: [
    'Family care',
    'Social work',
    'Child protection',
    'Prevention of family separation',
    'Domestic violence prevention',
    'Psychosocial support',
    'Case management',
    'Family preservation',
    'Gender-based violence prevention',
    "Women's empowerment",
    'Family Development Program (FDP)',
    'Migration and development',
  ],
  legalName: text(settings.orgName, 'en'),
  foundingDate: '2007-04-20',
  identifier: {
    '@type': 'PropertyValue',
    propertyID: 'Ministry of Interior registration',
    value: '457 (សជណ)',
    ...(text(settings.registration, lang)
      ? { description: text(settings.registration, lang) }
      : {}),
  },
  ...(settings.socials && settings.socials.length > 0
    ? {
        sameAs: settings.socials
          .map((social) => social.url)
          .filter((url) => /^https?:\/\//.test(url)),
      }
    : {}),
  ...orgJsonLd,
};

/** WebSite node, so search engines can attribute the site to the organisation. */
const webSiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteUrl}/#website`,
  url: siteUrl,
  name: orgName,
  alternateName: ['SKO'],
  inLanguage: ['en', 'km'],
  publisher: { '@id': `${siteUrl}/#organization` },
};
---

<title>{fullTitle}</title>
{description && <meta name="description" content={description} />}
<link rel="canonical" href={canonical} />
{(noindex || preventIndexing) && <meta name="robots" content="noindex, nofollow" />}

{
  locales.map((locale) => (
    <link
      rel="alternate"
      hreflang={htmlLang[locale]}
      href={new URL(alternatePath(pathname, locale), siteUrl).href}
    />
  ))
}
<link
  rel="alternate"
  hreflang="x-default"
  href={new URL(alternatePath(pathname, 'en'), siteUrl).href}
/>

<meta property="og:type" content={publishedAt ? 'article' : 'website'} />
<meta property="og:site_name" content={orgName} />
<meta property="og:title" content={fullTitle} />
{description && <meta property="og:description" content={description} />}
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={ogLocale[lang]} />
<meta property="og:image" content={share.url} />
{share.type && <meta property="og:image:type" content={share.type} />}
{share.width && <meta property="og:image:width" content={String(share.width)} />}
{share.height && <meta property="og:image:height" content={String(share.height)} />}
<meta property="og:image:alt" content={share.alt} />
{publishedAt && <meta property="article:published_time" content={publishedAt} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
{description && <meta name="twitter:description" content={description} />}
<meta name="twitter:image" content={share.url} />
<meta name="twitter:image:alt" content={share.alt} />

<script is:inline type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />
<script is:inline type="application/ld+json" set:html={serializeJsonLd(webSiteJsonLd)} />
{
  extraJsonLd && (
    <script is:inline type="application/ld+json" set:html={serializeJsonLd(extraJsonLd)} />
  )
}

{
  cfAnalyticsToken && (
    <script
      is:inline
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon={`{"token": "${cfAnalyticsToken}"}`}
    />
  )
}
