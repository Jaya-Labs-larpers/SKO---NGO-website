---
import { htmlLang, locales, ogLocale, type Locale } from '~/lib/i18n/config';
import { alternatePath } from '~/lib/i18n/utils';
import { cfAnalyticsToken, siteUrl, isPreviewDeployment } from '~/lib/config';
import type { CmsImage, SiteSettings } from '~/lib/content/types';
import { hasImage, imageUrl } from '~/lib/sanity/image';
import { text } from '~/lib/i18n/utils';
import { serializeJsonLd } from '~/lib/seo/json-ld';

interface Props {
  lang: Locale;
  pathname: string;
  title: string;
  description?: string;
  ogImage?: CmsImage | null;
  noindex?: boolean;
  settings: SiteSettings;
  /** Article publish date, when the page is a news/story item. */
  publishedAt?: string | null;
  /** Extra schema.org node for this page type. */
  jsonLd?: Record<string, unknown> | null;
}

const {
  lang,
  pathname,
  title,
  description,
  ogImage,
  noindex,
  settings,
  publishedAt,
  jsonLd: extraJsonLd,
} = Astro.props;

const orgName = text(settings.orgName, lang);
const fullTitle = title === orgName ? title : `${title} · ${orgName}`;
const canonical = new URL(pathname, siteUrl).href;

const shareImage = ogImage ?? settings.ogImage ?? null;
const shareImageUrl = shareImage && hasImage(shareImage)
  ? imageUrl(shareImage, { width: 1200, height: 630 })
  : null;

/**
 * Organization node.
 *
 * Deliberately specific. A generative engine asked "which NGOs work on child
 * protection in Phnom Penh?" has to be able to tell this SKO apart from every
 * other organisation sharing those initials — so this carries the alternate
 * name, the registration, the area served and what the organisation actually
 * works on, not just a name and a URL.
 */
const logoUrl = settings.logo && hasImage(settings.logo) ? imageUrl(settings.logo, { width: 512 }) : null;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NGO',
  '@id': `${siteUrl}/#organization`,
  name: orgName,
  alternateName: ['SKO', 'Samatapheap Khnom Organization', 'អង្គការសមត្ថភាពខ្ញុំ'],
  url: siteUrl,
  ...(logoUrl ? { logo: logoUrl, image: logoUrl } : {}),
  description: text(settings.tagline, lang) || undefined,
  ...(settings.email ? { email: settings.email } : {}),
  ...(settings.phone ? { telephone: settings.phone } : {}),
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Phnom Penh',
    addressCountry: 'KH',
    ...(text(settings.address, lang) ? { streetAddress: text(settings.address, lang) } : {}),
  },
  areaServed: {
    '@type': 'City',
    name: 'Phnom Penh',
    containedInPlace: { '@type': 'Country', name: 'Cambodia' },
  },
  knowsAbout: [
    'Family care',
    'Social work',
    'Child protection',
    'Prevention of family separation',
    'Domestic violence prevention',
    'Psychosocial support',
    'Case management',
  ],
  nonprofitStatus: 'NonprofitANBI',
  foundingDate: '2007-04-20',
  ...(text(settings.registration, lang)
    ? {
        identifier: {
          '@type': 'PropertyValue',
          name: 'Ministry of Interior registration',
          value: text(settings.registration, lang),
        },
      }
    : {}),
  ...(settings.socials && settings.socials.length > 0
    ? { sameAs: settings.socials.map((social) => social.url).filter((url) => /^https?:\/\//.test(url)) }
    : {}),
};

/** WebSite node, so search engines can attribute the site to the organisation. */
const webSiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteUrl}/#website`,
  url: siteUrl,
  name: orgName,
  inLanguage: ['en', 'km'],
  publisher: { '@id': `${siteUrl}/#organization` },
};
---

<title>{fullTitle}</title>
{description && <meta name="description" content={description} />}
<link rel="canonical" href={canonical} />
{(noindex || isPreviewDeployment) && <meta name="robots" content="noindex, nofollow" />}

{
  locales.map((locale) => (
    <link
      rel="alternate"
      hreflang={htmlLang[locale]}
      href={new URL(alternatePath(pathname, locale), siteUrl).href}
    />
  ))
}
<link rel="alternate" hreflang="x-default" href={new URL(alternatePath(pathname, 'en'), siteUrl).href} />

<meta property="og:type" content={publishedAt ? 'article' : 'website'} />
<meta property="og:site_name" content={orgName} />
<meta property="og:title" content={fullTitle} />
{description && <meta property="og:description" content={description} />}
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={ogLocale[lang]} />
{shareImageUrl && <meta property="og:image" content={shareImageUrl} />}
{publishedAt && <meta property="article:published_time" content={publishedAt} />}

<meta name="twitter:card" content={shareImageUrl ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={fullTitle} />
{description && <meta name="twitter:description" content={description} />}
{shareImageUrl && <meta name="twitter:image" content={shareImageUrl} />}

<script is:inline type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />
<script is:inline type="application/ld+json" set:html={serializeJsonLd(webSiteJsonLd)} />
{extraJsonLd && <script is:inline type="application/ld+json" set:html={serializeJsonLd(extraJsonLd)} />}

{
  cfAnalyticsToken && (
    <script
      is:inline
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon={`{"token": "${cfAnalyticsToken}"}`}
    />
  )
}
