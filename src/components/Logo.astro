---
/**
 * Logo.astro — the traced SKO vector, served as a cached /logo/*.svg file rather than
 * inlined, so its ~50 KB is not repeated in every page's HTML.
 *
 *   <Logo variant="emblem" height={28} />            header on a phone
 *   <Logo variant="reversed" width={220} />          footer on Deep Navy
 *   <Logo variant="full" width={240} />              light backgrounds (About, reports)
 *
 * Rules (brand guideline): full lockup never below 180px wide — below that use the emblem.
 * Reversed on Deep Navy, photos and cyan blocks. Never recolour, stretch, or move the butterflies.
 * The emblem is NOT a UI icon: header, footer, favicon only.
 */
type Variant =
  'full' | 'reversed' | 'mono' | 'mono-white' | 'emblem' | 'emblem-reversed' | 'emblem-mono';

interface Props {
  variant?: Variant;
  width?: number;
  height?: number;
  class?: string;
  title?: string;
  /** Swap to this lockup from `wideFrom` upward (a `<picture>`, so only one file is fetched). */
  wide?: Variant;
  wideFrom?: string;
  /** Below the fold: the file is not fetched until the logo is near the viewport. */
  lazy?: boolean;
}
const {
  variant = 'full',
  width,
  height,
  class: className = '',
  title = 'Samatapheap Khnom Organization',
  wide,
  wideFrom = '64rem',
  lazy = false,
} = Astro.props;

// Keyed by Variant, not string — an indexed read then yields a definite string.
const files: Record<Variant, string> = {
  full: 'sko-logo-full-colour.svg',
  reversed: 'sko-logo-reversed.svg',
  mono: 'sko-logo-mono-ink.svg',
  'mono-white': 'sko-logo-mono-white.svg',
  emblem: 'sko-emblem.svg',
  'emblem-reversed': 'sko-emblem-reversed.svg',
  'emblem-mono': 'sko-emblem-mono.svg',
};
const file = files[variant];
if (!file) throw new Error(`[Logo] unknown variant "${variant}"`);

const isEmblem = variant.startsWith('emblem');
const ratio = isEmblem ? 728 / 516 : 1384 / 829; // viewBox aspect ratios of the traced files
if (!isEmblem && width && width < 180) {
  console.warn(
    `[Logo] full lockup at ${width}px is below the 180px minimum — use variant="emblem"`,
  );
}
const w = width ?? (height ? Math.round(height * ratio) : undefined);
const h = height ?? (width ? Math.round(width / ratio) : undefined);
const src = `/logo/${file}`;
const wideSrc = wide ? `/logo/${files[wide]}` : null;
---

{
  wideSrc ? (
    <picture>
      <source media={`(min-width: ${wideFrom})`} srcset={wideSrc} />
      <img
        src={src}
        width={w}
        height={h}
        alt={title}
        class={className}
        decoding="async"
        loading={lazy ? 'lazy' : undefined}
      />
    </picture>
  ) : (
    <img
      src={src}
      width={w}
      height={h}
      alt={title}
      class={className}
      decoding="async"
      loading={lazy ? 'lazy' : undefined}
    />
  )
}
