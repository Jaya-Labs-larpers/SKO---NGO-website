---
import type { Locale } from '~/lib/i18n/config';
import type { SiteSettings } from '~/lib/content/types';
import { localizePath, pick, t, text } from '~/lib/i18n/utils';
import { footerNav } from '~/lib/nav';
import Icon from '~/components/ui/Icon.astro';

interface Props {
  lang: Locale;
  settings: SiteSettings;
}

const { lang, settings } = Astro.props;

const orgName = text(settings.orgName, lang);
const shortName = settings.orgShortName ?? 'SKO';
const address = pick(settings.address, lang);
const registration = pick(settings.registration, lang);
const hours = pick(settings.officeHours, lang);
const year = new Date().getFullYear();
---

<footer class="site-footer mt-[var(--spacing-section)] border-t border-line-ink">
  <div class="wrap">
    <div class="grid gap-x-10 gap-y-8 py-10 md:grid-cols-2 lg:grid-cols-[1.4fr_repeat(4,1fr)] lg:py-12">
      <div class="md:col-span-2 lg:col-span-1">
        <p class="text-ink-900">
          <span class="block text-[1.375rem] leading-none font-bold tracking-[-0.03em]">{shortName}</span>
          <span class="mt-1.5 block text-[15px] font-medium">{orgName}</span>
        </p>
        {
          address.value && (
            <p
              class="mt-4 max-w-[30ch] text-[15px] whitespace-pre-line text-ink-600"
              lang={address.isFallback ? address.lang : undefined}
            >
              {address.value}
            </p>
          )
        }
        <p class="mt-3 text-[15px]">
          {settings.phone && <a href={`tel:${settings.phone.replace(/\s+/g, '')}`} class="block">{settings.phone}</a>}
          {settings.email && <a href={`mailto:${settings.email}`} class="block">{settings.email}</a>}
          {
            hours.value && (
              <span class="mt-1 block text-ink-400" lang={hours.isFallback ? hours.lang : undefined}>
                {hours.value}
              </span>
            )
          }
        </p>
        {
          settings.socials && settings.socials.length > 0 && (
            <ul class="mt-4 flex list-none flex-wrap gap-x-4 p-0 text-[15px]">
              {settings.socials.map((social) => (
                <li>
                  <a href={social.url} rel="noopener noreferrer" target="_blank" class="link">
                    {social.platform}
                    <Icon name="arrow-up-right" size={14} />
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      {
        footerNav.map((group) => (
          <nav aria-label={t(lang, group.heading)}>
            <h2 class="label mb-3 text-ink-900">{t(lang, group.heading)}</h2>
            <ul class="list-none p-0">
              {group.items.map((item) => (
                <li>
                  <a
                    href={localizePath(item.path, lang)}
                    class="inline-block py-1.5 text-[15px] text-ink-700 no-underline hover:text-indigo-700 hover:underline"
                  >
                    {t(lang, item.key)}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div
      class="flex flex-col gap-3 border-t border-line py-5 text-[13px] text-ink-400 sm:flex-row sm:items-baseline sm:justify-between"
    >
      <p class="max-w-[64ch]" lang={registration.isFallback ? registration.lang : undefined}>
        © {year} {orgName}{registration.value ? ` · ${registration.value}` : ''}
      </p>
      <p class="flex gap-5">
        <a href={localizePath('/privacy', lang)} class="text-ink-400 no-underline hover:text-ink-900 hover:underline"
          >{t(lang, 'navPrivacy')}</a
        >
        <a href={localizePath('/contact', lang)} class="text-ink-400 no-underline hover:text-ink-900 hover:underline"
          >{t(lang, 'navContact')}</a
        >
      </p>
    </div>
  </div>
</footer>
