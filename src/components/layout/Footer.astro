---
import type { Locale } from '~/lib/i18n/config';
import type { SiteSettings } from '~/lib/content/types';
import { localizePath, parsePath, pick, t, text } from '~/lib/i18n/utils';
import { footerNav } from '~/lib/nav';
import Icon from '~/components/Icon.astro';
import Logo from '~/components/Logo.astro';

interface Props {
  lang: Locale;
  settings: SiteSettings;
  pathname: string;
}

const { lang, settings, pathname } = Astro.props;

/** The contact page is the invitation already; closing on it again would repeat the page. */
const showClosing = parsePath(pathname).path.replace(/\/$/, '') !== '/contact';

const orgName = text(settings.orgName, lang);
const address = pick(settings.address, lang);
const registration = pick(settings.registration, lang);
const year = new Date().getFullYear();

/** CMS platform names are free text (e.g. "Facebook"); map the known ones to a sprite icon. */
const socialIcon: Record<string, string> = {
  facebook: 'sko-facebook',
  telegram: 'paper-airplane',
};
function iconForPlatform(platform: string): string {
  return socialIcon[platform.toLowerCase()] ?? 'link';
}
---

<footer
  class="site-footer on-inverse bg-[color:var(--color-blue-900)] pt-[60px] pb-[calc(1.75rem+var(--safe-bottom))] text-[14.5px] text-white/70"
>
  <div class="wrap">
    {
      /*
      Closing line: the invitation and the two direct ways to reach SKO, set
      as display type, so contact is the last thing every page says.
    */
    }
    {
      showClosing && (
        <div class="footer-closing">
          <p class="footer-closing__title">{t(lang, 'contactUs')}</p>
          <div class="footer-closing__links">
            {settings.email && (
              <a href={`mailto:${settings.email}`} class="footer-closing__link">
                <span class="roll">
                  <span class="roll__text" data-text={settings.email}>
                    {settings.email}
                  </span>
                </span>
              </a>
            )}
            {settings.phone && (
              <a href={`tel:${settings.phone.replace(/[^+\d]/g, '')}`} class="footer-closing__link">
                <span class="roll">
                  <span class="roll__text" data-text={settings.phone}>
                    {settings.phone}
                  </span>
                </span>
              </a>
            )}
          </div>
        </div>
      )
    }

    <div class="grid grid-cols-2 gap-x-6 gap-y-10 lg:grid-cols-[1.6fr_1fr_1fr_1fr]">
      <div class="col-span-2 md:col-span-1">
        <Logo variant="reversed" width={220} />

        {
          address.value && (
            <p
              class="mt-4 flex max-w-[34ch] gap-2 whitespace-pre-line text-[color:var(--color-sky-400)]"
              lang={address.isFallback ? address.lang : undefined}
            >
              <Icon name="map-pin" size={20} class="mt-0.5 flex-none" />
              <span class="text-white/70">{address.value}</span>
            </p>
          )
        }

        <p class="mt-2.5 space-y-1.5 text-[color:var(--color-sky-400)]">
          {
            settings.phone && (
              <span class="flex items-center gap-2">
                <Icon name="phone" size={20} />
                <span class="text-white/70">{settings.phone}</span>
              </span>
            )
          }
          {
            settings.email && (
              <a
                href={`mailto:${settings.email}`}
                class="flex items-center gap-2 text-white/70 no-underline hover:text-white"
              >
                <Icon name="envelope" size={20} class="text-[color:var(--color-sky-400)]" />
                {settings.email}
              </a>
            )
          }
        </p>

        {
          settings.socials && settings.socials.length > 0 && (
            <ul class="mt-4 flex list-none flex-col gap-2 p-0">
              {settings.socials.map((social) => (
                <li>
                  <a
                    href={social.url}
                    rel="noopener noreferrer"
                    target="_blank"
                    class="flex items-center gap-2 text-white/70 no-underline hover:text-white"
                  >
                    <Icon
                      name={iconForPlatform(social.platform)}
                      size={20}
                      class="text-[color:var(--color-sky-400)]"
                    />
                    {social.platform}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      {
        footerNav.map((group) => (
          <nav aria-label={t(lang, group.heading)}>
            <h2 class="mb-4 text-[13px] tracking-[0.1em] text-white uppercase">
              {t(lang, group.heading)}
            </h2>
            <ul class="list-none p-0">
              {group.items.map((item) => (
                <li>
                  <a
                    href={localizePath(item.path, lang)}
                    class="block py-1 text-white/70 no-underline hover:text-white"
                  >
                    {t(lang, item.key)}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div
      class="mt-11 flex flex-wrap justify-between gap-5 border-t border-white/15 pt-5.5 text-[13px] text-white/55"
    >
      <span
        class="flex items-center gap-1.5"
        lang={registration.isFallback ? registration.lang : undefined}
      >
        {
          registration.value && (
            <Icon name="check-badge" size={16} class="text-[color:var(--color-sky-400)]" />
          )
        }
        © {year}
        {orgName}. {registration.value}
      </span>
      <span class="flex gap-4.5">
        <a href={localizePath('/privacy', lang)} class="text-white/55 no-underline hover:text-white"
          >{t(lang, 'navPrivacy')}</a
        >
        <a href={localizePath('/contact', lang)} class="text-white/55 no-underline hover:text-white"
          >{t(lang, 'navContact')}</a
        >
      </span>
    </div>
  </div>
</footer>
