---
import type { Locale } from '~/lib/i18n/config';
import type { SiteSettings } from '~/lib/content/types';
import { localizePath, pick, t, text } from '~/lib/i18n/utils';
import { footerNav } from '~/lib/nav';
import Icon from '~/components/Icon.astro';
import Logo from '~/components/Logo.astro';

interface Props {
  lang: Locale;
  settings: SiteSettings;
}

const { lang, settings } = Astro.props;

const orgName = text(settings.orgName, lang);
const address = pick(settings.address, lang);
const registration = pick(settings.registration, lang);
const year = new Date().getFullYear();

/** CMS platform names are free text (e.g. "Facebook"); map the known ones to a sprite icon. */
const socialIcon: Record<string, string> = {
  facebook: 'sko-facebook',
  telegram: 'paper-airplane',
};
function iconForPlatform(platform: string): string {
  return socialIcon[platform.toLowerCase()] ?? 'link';
}
---

<footer class="site-footer bg-[color:var(--color-blue-900)] text-white">
  <div
    class="mx-auto flex max-w-[var(--container-page)] flex-col gap-14 pt-[72px] pr-[var(--gutter-right)] pb-[calc(2.5rem+var(--safe-bottom))] pl-[var(--gutter-left)]"
  >
    <div class="grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-[2fr_1fr_1fr_1fr]">
      <div class="flex min-w-0 flex-col gap-6 sm:col-span-2 lg:col-span-1">
        <Logo lazy variant="reversed" width={200} title={orgName} class="block h-auto w-[200px]" />
        <ul
          class="m-0 flex list-none flex-col gap-3 p-0 text-[15px] leading-normal text-[color:var(--color-on-navy)]"
        >
          {
            address.value && (
              <li class="flex gap-3">
                <Icon
                  name="map-pin"
                  size={18}
                  class="mt-[3px] flex-none text-[color:var(--color-sky-400)]"
                />
                <span
                  class="whitespace-pre-line"
                  lang={address.isFallback ? address.lang : undefined}
                >
                  {address.value}
                </span>
              </li>
            )
          }
          {
            settings.phone && (
              <li class="flex gap-3">
                <Icon
                  name="phone"
                  size={18}
                  class="mt-[3px] flex-none text-[color:var(--color-sky-400)]"
                />
                <a
                  href={`tel:${settings.phone.replace(/[^+\d]/g, '')}`}
                  class="text-white no-underline hover:text-[color:var(--color-sky-400)]"
                >
                  {settings.phone}
                </a>
              </li>
            )
          }
          {
            settings.email && (
              <li class="flex gap-3">
                <Icon
                  name="envelope"
                  size={18}
                  class="mt-[3px] flex-none text-[color:var(--color-sky-400)]"
                />
                <a
                  href={`mailto:${settings.email}`}
                  class="[overflow-wrap:anywhere] text-white no-underline hover:text-[color:var(--color-sky-400)]"
                >
                  {settings.email}
                </a>
              </li>
            )
          }
          {
            settings.socials?.map((social) => (
              <li class="flex gap-3">
                <Icon
                  name={iconForPlatform(social.platform)}
                  size={18}
                  class="mt-[3px] flex-none text-[color:var(--color-sky-400)]"
                />
                <a
                  href={social.url}
                  rel="noopener noreferrer"
                  target="_blank"
                  class="text-white no-underline hover:text-[color:var(--color-sky-400)]"
                >
                  {social.platform}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      {
        footerNav.map((group) => (
          <nav aria-label={t(lang, group.heading)} class="flex flex-col gap-3.5">
            <h2 class="eyebrow !text-[color:var(--color-sky-400)]">{t(lang, group.heading)}</h2>
            <ul class="m-0 flex list-none flex-col p-0">
              {group.items.map((item) => (
                <li>
                  <a href={localizePath(item.path, lang)} class="footer-link">
                    {t(lang, item.key)}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div
      class="flex flex-wrap items-center justify-between gap-4 border-t border-[color:var(--color-line-navy)] pt-6 text-sm text-[color:var(--color-on-navy)]"
    >
      <p class="m-0 flex items-start gap-2.5">
        {
          registration.value && (
            <Icon
              name="check"
              size={16}
              class="mt-[3px] flex-none text-[color:var(--color-sky-400)]"
            />
          )
        }
        <span lang={registration.isFallback ? registration.lang : undefined}>
          © {year}{' '}
          {orgName}. {registration.value}
        </span>
      </p>
      <div class="flex gap-6">
        <a href={localizePath('/privacy', lang)} class="footer-link !min-h-11 !text-sm"
          >{t(lang, 'navPrivacy')}</a
        >
        <a href={localizePath('/contact', lang)} class="footer-link !min-h-11 !text-sm"
          >{t(lang, 'navContact')}</a
        >
      </div>
    </div>
  </div>
</footer>
