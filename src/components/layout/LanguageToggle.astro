---
import { locales, localeShort, localeName, htmlLang, type Locale } from '~/lib/i18n/config';
import { alternatePath, t } from '~/lib/i18n/utils';

interface Props {
  lang: Locale;
  /** Current pathname, so the toggle lands on the same page in the other language. */
  pathname: string;
  full?: boolean;
}

const { lang, pathname, full = false } = Astro.props;

/**
 * The group carries the "Language" label; each link's accessible name is just
 * its own visible text (WCAG 2.5.3, Label in Name). Context belongs on the
 * group, not on the item.
 */
---

<nav
  aria-label={t(lang, 'language')}
  class:list={['flex items-center', full ? 'w-full border-t border-line' : 'gap-0.5']}
>
  {
    locales.map((locale, index) => {
      const current = locale === lang;
      return (
        <>
          {index > 0 && !full && (
            <span class="text-ink-300" aria-hidden="true">
              /
            </span>
          )}
          <a
            href={alternatePath(pathname, locale)}
            hreflang={htmlLang[locale]}
            lang={htmlLang[locale]}
            aria-current={current ? 'true' : undefined}
            title={
              current
                ? undefined
                : locale === 'km'
                  ? t(lang, 'switchToKhmer')
                  : t(lang, 'switchToEnglish')
            }
            class:list={[
              'inline-flex min-h-11 items-center no-underline',
              full ? 'flex-1 justify-center border-b border-line py-3 text-[17px]' : 'min-w-11 justify-center px-1.5 text-[15px]',
              current
                ? 'font-semibold text-ink-900 underline decoration-ink-900 underline-offset-[0.3em]'
                : 'font-medium text-ink-400 hover:text-ink-900',
            ]}
          >
            {full ? localeName[locale] : localeShort[locale]}
          </a>
        </>
      );
    })
  }
</nav>
