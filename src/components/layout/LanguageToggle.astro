---
import { localeName, htmlLang, type Locale } from '~/lib/i18n/config';
import { alternatePath, t } from '~/lib/i18n/utils';

interface Props {
  lang: Locale;
  /** Current pathname, so the toggle lands on the same page in the other language. */
  pathname: string;
  full?: boolean;
}

const { lang, pathname, full = false } = Astro.props;

/** Flag of the language the link switches TO — a single toggle, not a two-way picker. */
const otherLocale: Locale = lang === 'en' ? 'km' : 'en';
const label = otherLocale === 'km' ? t(lang, 'switchToKhmer') : t(lang, 'switchToEnglish');
---

<a
  href={alternatePath(pathname, otherLocale)}
  hreflang={htmlLang[otherLocale]}
  lang={htmlLang[otherLocale]}
  title={label}
  aria-label={label}
  class:list={[
    'inline-flex items-center gap-2 rounded-[var(--radius-sm)] border border-[color:var(--color-line-strong)] bg-white px-2.5 py-2 text-[13px] font-semibold text-[color:var(--color-ink-600)] no-underline transition-colors hover:border-[color:var(--color-blue-200)] hover:bg-[color:var(--color-blue-50)]',
    full && 'w-full justify-center py-3',
  ]}
>
  {
    otherLocale === 'km' ? (
      <span lang="en" class="leading-[14px] tracking-[0.04em]">
        KH
      </span>
    ) : (
      <img
        src={`/flags/${otherLocale}.svg`}
        width="20"
        height="14"
        alt=""
        class="rounded-[2px] ring-1 ring-black/10"
      />
    )
  }
  {full && <span>{localeName[otherLocale]}</span>}
</a>
