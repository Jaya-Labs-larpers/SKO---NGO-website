---
import { localeName, htmlLang, type Locale } from '~/lib/i18n/config';
import { alternatePath, t } from '~/lib/i18n/utils';

interface Props {
  lang: Locale;
  /** Current pathname, so the toggle lands on the same page in the other language. */
  pathname: string;
  full?: boolean;
}

const { lang, pathname, full = false } = Astro.props;

/** The language the link switches TO — a single toggle, not a two-way picker. */
const otherLocale: Locale = lang === 'en' ? 'km' : 'en';
const label = otherLocale === 'km' ? t(lang, 'switchToKhmer') : t(lang, 'switchToEnglish');
---

<a
  href={alternatePath(pathname, otherLocale)}
  hreflang={htmlLang[otherLocale]}
  lang={htmlLang[otherLocale]}
  title={label}
  aria-label={label}
  class:list={[
    'inline-flex min-h-11 min-w-12 items-center justify-center gap-2 rounded-[var(--radius-md)] border border-[color:var(--color-line-strong)] bg-white px-2.5 font-[family-name:var(--font-display)] text-[13px] font-bold text-[color:var(--color-ink-900)] no-underline transition-colors hover:border-[color:var(--color-blue-700)] hover:bg-[color:var(--color-blue-50)] hover:text-[color:var(--color-ink-900)]',
    full && 'w-full py-3',
  ]}
>
  <span lang="en" class="tracking-[0.08em]">{otherLocale === 'km' ? 'KH' : 'EN'}</span>
  {full && <span>{localeName[otherLocale]}</span>}
</a>
