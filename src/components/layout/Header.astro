---
import type { Locale } from '~/lib/i18n/config';
import type { SiteSettings } from '~/lib/content/types';
import { localizePath, t, text } from '~/lib/i18n/utils';
import { mainNav, mobileNav } from '~/lib/nav';
import { donationEnabled } from '~/lib/donation';
import LanguageToggle from './LanguageToggle.astro';
import Icon from '~/components/Icon.astro';
import Logo from '~/components/Logo.astro';

interface Props {
  lang: Locale;
  pathname: string;
  settings: SiteSettings;
}

const { lang, pathname, settings } = Astro.props;

const orgName = text(settings.orgName, lang);

function isCurrent(path: string): boolean {
  const target = localizePath(path, lang);
  return pathname === target || pathname.startsWith(target);
}
---

<header class="site-header sticky top-0 z-20">
  <div
    class="mx-auto flex min-h-[var(--header-h)] w-full max-w-[var(--container-page)] flex-wrap items-center gap-x-8 gap-y-3 py-3 pt-[calc(0.75rem+var(--safe-top))] pr-[var(--gutter-right)] pl-[var(--gutter-left)]"
  >
    <a href={localizePath('/', lang)} class="flex flex-none items-center no-underline">
      <Logo
        variant="emblem"
        wide="full"
        height={52}
        title={orgName}
        class="block h-[52px] w-auto lg:aspect-[1384/829] lg:h-auto lg:w-[184px]"
      />
    </a>

    <nav class="hidden flex-1 justify-center lg:flex" aria-label={t(lang, 'mainNavLabel')}>
      <ul class="m-0 flex list-none flex-wrap gap-x-2 gap-y-1 p-0">
        {
          mainNav.map((item) => (
            <li>
              <a
                href={localizePath(item.path, lang)}
                aria-current={isCurrent(item.path) ? 'page' : undefined}
                class="nav-link"
              >
                {t(lang, item.key)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="ml-auto flex flex-none items-center gap-2 sm:gap-3 lg:ml-0">
      <div class="hidden lg:block"><LanguageToggle lang={lang} pathname={pathname} /></div>
      <a href={localizePath('/contact', lang)} class="btn btn-secondary hidden lg:inline-flex">
        {t(lang, 'contactUs')}
      </a>
      {
        donationEnabled && (
          <a
            href={localizePath('/donate', lang)}
            class="btn btn-accent btn-sm sm:min-h-12 sm:px-[22px] sm:text-base"
            aria-current={isCurrent('/donate') ? 'page' : undefined}
          >
            {t(lang, 'navDonate')}
          </a>
        )
      }
      <button
        type="button"
        id="menu-toggle"
        class="grid h-11 w-11 place-items-center rounded-[var(--radius-md)] border border-[color:var(--color-line-strong)] bg-white text-[color:var(--color-ink-900)] lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label={t(lang, 'openMenu')}
        data-label-open={t(lang, 'openMenu')}
        data-label-close={t(lang, 'closeMenu')}
      >
        <Icon name="bars-3" size={24} inline class="menu-toggle-icon-open" />
        <Icon name="x-mark" size={24} inline class="menu-toggle-icon-close hidden" />
      </button>
    </div>
  </div>
</header>

<!-- Mobile navigation panel -->
<div
  id="mobile-nav"
  hidden
  class="fixed inset-0 z-50 flex flex-col bg-white lg:hidden"
  role="dialog"
  aria-modal="true"
  aria-label={t(lang, 'menu')}
>
  <div
    class="wrap flex h-[var(--header-h)] flex-none items-center border-b border-[color:var(--color-line)] pt-[var(--safe-top)]"
  >
    <span
      class="font-[family-name:var(--font-display)] text-[15px] font-bold text-[color:var(--color-ink-900)]"
      >{orgName}</span
    >
    <button
      type="button"
      id="menu-close"
      class="ml-auto grid h-11 w-11 place-items-center rounded-[var(--radius-md)] border border-[color:var(--color-line-strong)] bg-white text-[color:var(--color-ink-900)]"
      aria-label={t(lang, 'closeMenu')}
    >
      <span class="menu-x" aria-hidden="true"><span></span><span></span></span>
    </button>
  </div>

  <nav
    class="wrap flex-1 overflow-y-auto pt-3 pb-[calc(0.75rem+var(--safe-bottom))]"
    aria-label={t(lang, 'mainNavLabel')}
  >
    {
      mobileNav.map((item) => (
        <a
          href={localizePath(item.path, lang)}
          aria-current={isCurrent(item.path) ? 'page' : undefined}
          class="flex min-h-14 items-center justify-between border-b border-[color:var(--color-line)] text-[18px] font-semibold text-[color:var(--color-ink-900)] no-underline"
        >
          {t(lang, item.key)}
          <span class="text-[color:var(--color-blue-700)]" aria-hidden="true">
            →
          </span>
        </a>
      ))
    }

    <a href={localizePath('/contact', lang)} class="btn btn-primary btn-lg btn-block mt-6">
      {t(lang, 'contactUs')}
    </a>
    {
      donationEnabled && (
        <a href={localizePath('/donate', lang)} class="btn btn-accent btn-lg btn-block mt-2.5">
          {t(lang, 'navDonate')}
        </a>
      )
    }
    <a
      href={localizePath('/contact?topic=volunteer', lang)}
      class="btn btn-secondary btn-lg btn-block mt-2.5"
    >
      {t(lang, 'navVolunteer')}
    </a>

    <div class="mt-7 border-t border-[color:var(--color-line)] pt-5 pb-8">
      <span class="eyebrow mb-3 block">{t(lang, 'language')}</span>
      <LanguageToggle lang={lang} pathname={pathname} full />
    </div>
  </nav>
</div>

<script>
  /**
   * The header steps out of the way while the visitor reads downward and comes
   * back on any upward scroll, keyboard focus, or near the top of the page.
   *
   * Distances are measured from the last turning point, not frame to frame, so
   * a slow scroll still registers. Hiding takes a deliberate scroll; showing
   * takes only a small one — the visitor reaching for the menu should not have
   * to work for it. Rubber-band overscroll at either end is ignored, or the
   * bounce at the bottom of a page on iOS would pull the header back in.
   */
  const header = document.querySelector<HTMLElement>('header.site-header');
  const menuPanel = document.getElementById('mobile-nav');

  if (header) {
    const HIDE_AFTER = 24;
    const SHOW_AFTER = 6;
    let turnY = window.scrollY;
    let ticking = false;

    const setHidden = (hidden: boolean) => {
      if (header.hasAttribute('data-hidden') !== hidden)
        header.toggleAttribute('data-hidden', hidden);
    };

    const update = () => {
      ticking = false;
      const maxY = document.documentElement.scrollHeight - window.innerHeight;
      const y = Math.min(Math.max(window.scrollY, 0), maxY);
      const hidden = header.hasAttribute('data-hidden');
      header.toggleAttribute('data-scrolled', y > header.offsetHeight);

      const nearTop = y < header.offsetHeight * 2;
      const menuOpen = menuPanel ? !menuPanel.hidden : false;
      if (nearTop || menuOpen || header.contains(document.activeElement)) {
        setHidden(false);
        turnY = y;
        return;
      }

      if (hidden ? y > turnY : y < turnY) turnY = y;
      const travelled = y - turnY;
      if (!hidden && travelled > HIDE_AFTER) {
        setHidden(true);
        turnY = y;
      } else if (hidden && travelled < -SHOW_AFTER) {
        setHidden(false);
        turnY = y;
      }
    };

    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      },
      { passive: true },
    );
    header.addEventListener('focusin', () => header.removeAttribute('data-hidden'));
  }

  const toggle = document.getElementById('menu-toggle');
  const closeButton = document.getElementById('menu-close');
  const panel = document.getElementById('mobile-nav');
  const openIcon = toggle?.querySelector('.menu-toggle-icon-open');
  const closeIcon = toggle?.querySelector('.menu-toggle-icon-close');

  if (toggle && panel && closeButton) {
    const FOCUSABLE = 'a[href], button:not([disabled])';
    let lastFocused: HTMLElement | null = null;

    const open = () => {
      lastFocused = document.activeElement as HTMLElement | null;
      panel.hidden = false;
      document.body.style.overflow = 'hidden';
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', toggle.dataset.labelClose ?? 'Close menu');
      openIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
      panel.querySelector<HTMLElement>(FOCUSABLE)?.focus();
    };

    /**
     * Closing plays an exit animation before the panel is hidden. `hidden`
     * removes it instantly, so the element has to survive one animation first.
     *
     * Guarded three ways: reduced-motion skips it entirely, a missing
     * animationend event still resolves via the timeout, and re-entry is
     * blocked while an exit is already running — otherwise a double-tap on the
     * close button leaves the panel stuck mid-animation.
     */
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    const finishClose = () => {
      panel.hidden = true;
      panel.removeAttribute('data-closing');
      document.body.style.overflow = '';
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', toggle.dataset.labelOpen ?? 'Open menu');
      openIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
      lastFocused?.focus();
    };

    const close = () => {
      if (panel.hidden || panel.hasAttribute('data-closing')) return;

      if (prefersReducedMotion.matches) {
        finishClose();
        return;
      }

      panel.setAttribute('data-closing', '');
      let done = false;
      const settle = () => {
        if (done) return;
        done = true;
        finishClose();
      };
      panel.addEventListener('animationend', settle, { once: true });
      window.setTimeout(settle, 400);
    };

    toggle.addEventListener('click', open);
    closeButton.addEventListener('click', close);

    document.addEventListener('keydown', (event) => {
      if (panel.hidden) return;
      if (event.key === 'Escape') {
        close();
        return;
      }
      if (event.key !== 'Tab') return;

      // Keep focus inside the panel while it is open.
      const items = Array.from(panel.querySelectorAll<HTMLElement>(FOCUSABLE));
      const first = items[0];
      const last = items[items.length - 1];
      if (!first || !last) return;

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });
  }
</script>
