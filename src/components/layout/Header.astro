---
import type { Locale } from '~/lib/i18n/config';
import type { SiteSettings } from '~/lib/content/types';
import { localizePath, t, text } from '~/lib/i18n/utils';
import { mainNav, mobileNav } from '~/lib/nav';
import LanguageToggle from './LanguageToggle.astro';

interface Props {
  lang: Locale;
  pathname: string;
  settings: SiteSettings;
}

const { lang, pathname, settings } = Astro.props;

const orgName = text(settings.orgName, lang);
const shortName = settings.orgShortName ?? 'SKO';

function isCurrent(path: string): boolean {
  const target = localizePath(path, lang);
  return pathname === target || pathname.startsWith(target);
}
---

<header class="relative z-20 border-b border-[color:var(--color-line-subtle)] bg-white">
  <div class="wrap flex h-[68px] items-center gap-6 lg:h-[76px]">
    <a href={localizePath('/', lang)} class="flex flex-none items-center gap-3 no-underline">
      <span
        class="grid h-9 w-9 place-items-center rounded-[var(--radius-sm)] bg-[color:var(--color-blue-700)] text-[15px] font-extrabold text-white lg:h-[38px] lg:w-[38px]"
        aria-hidden="true">{shortName}</span
      >
      <span class="flex flex-col leading-[1.15]">
        <span class="text-[14px] font-bold tracking-[-0.01em] text-[color:var(--color-ink-900)] lg:text-[15px]"
          >{orgName}</span
        >
        <span class="hidden text-[11px] text-[color:var(--color-ink-400)] sm:block"
          >Samatapheap Khnom Organization</span
        >
      </span>
    </a>

    <nav class="ml-auto hidden lg:flex lg:gap-0.5" aria-label={t(lang, 'mainNavLabel')}>
      {
        mainNav.map((item) => (
          <a
            href={localizePath(item.path, lang)}
            aria-current={isCurrent(item.path) ? 'page' : undefined}
            class:list={[
              'rounded-[var(--radius-sm)] px-[13px] py-2.5 text-[14.5px] font-semibold no-underline transition-colors',
              isCurrent(item.path)
                ? 'text-[color:var(--color-blue-800)] shadow-[inset_0_-2px_0_var(--color-blue-700)]'
                : 'text-[color:var(--color-ink-700)] hover:bg-[color:var(--color-blue-50)] hover:text-[color:var(--color-blue-800)]',
            ]}
          >
            {t(lang, item.key)}
          </a>
        ))
      }
    </nav>

    <div
      class="ml-auto flex items-center gap-3 lg:ml-0 lg:border-l lg:border-[color:var(--color-line)] lg:pl-3.5"
    >
      <LanguageToggle lang={lang} pathname={pathname} />
      <a href={localizePath('/donate', lang)} class="btn btn-primary btn-sm hidden sm:inline-flex">
        {t(lang, 'navDonate')}
      </a>
      <button
        type="button"
        id="menu-toggle"
        class="grid h-11 w-11 place-items-center rounded-[var(--radius-md)] border border-[color:var(--color-line-strong)] bg-white text-[color:var(--color-ink-900)] lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label={t(lang, 'openMenu')}
        data-label-open={t(lang, 'openMenu')}
        data-label-close={t(lang, 'closeMenu')}
      >
        <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" fill="none">
          <path
            d="M3 5.5h14M3 10h14M3 14.5h14"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile navigation panel -->
<div
  id="mobile-nav"
  hidden
  class="fixed inset-0 z-50 flex flex-col bg-white lg:hidden"
  role="dialog"
  aria-modal="true"
  aria-label={t(lang, 'menu')}
>
  <div class="wrap flex h-[68px] flex-none items-center border-b border-[color:var(--color-line-subtle)]">
    <span class="text-[14px] font-bold text-[color:var(--color-ink-900)]">{orgName}</span>
    <button
      type="button"
      id="menu-close"
      class="ml-auto grid h-11 w-11 place-items-center rounded-[var(--radius-md)] border border-[color:var(--color-line-strong)] bg-white text-[color:var(--color-ink-900)]"
      aria-label={t(lang, 'closeMenu')}
    >
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" fill="none">
        <path d="M4 4l10 10M14 4L4 14" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"
        ></path>
      </svg>
    </button>
  </div>

  <nav class="wrap flex-1 overflow-y-auto py-3" aria-label={t(lang, 'mainNavLabel')}>
    {
      mobileNav.map((item) => (
        <a
          href={localizePath(item.path, lang)}
          aria-current={isCurrent(item.path) ? 'page' : undefined}
          class="flex items-center justify-between border-b border-[color:var(--color-line-subtle)] py-[17px] text-[19px] font-semibold text-[color:var(--color-ink-900)] no-underline"
        >
          {t(lang, item.key)}
          <span class="text-[color:var(--color-blue-700)]" aria-hidden="true">
            →
          </span>
        </a>
      ))
    }

    <a href={localizePath('/donate', lang)} class="btn btn-primary btn-block mt-6 py-4">
      {t(lang, 'navDonate')}
    </a>
    <a href={localizePath('/volunteer', lang)} class="btn btn-secondary btn-block mt-2.5 py-4">
      {t(lang, 'navVolunteer')}
    </a>

    <div class="mt-7 border-t border-[color:var(--color-line)] pt-5 pb-8">
      <span
        class="mb-3 block font-mono text-[11px] font-semibold tracking-[0.1em] text-[color:var(--color-ink-400)] uppercase"
        >{t(lang, 'language')}</span
      >
      <LanguageToggle lang={lang} pathname={pathname} full />
    </div>
  </nav>
</div>

<script>
  const toggle = document.getElementById('menu-toggle');
  const closeButton = document.getElementById('menu-close');
  const panel = document.getElementById('mobile-nav');

  if (toggle && panel && closeButton) {
    const FOCUSABLE = 'a[href], button:not([disabled])';
    let lastFocused: HTMLElement | null = null;

    const open = () => {
      lastFocused = document.activeElement as HTMLElement | null;
      panel.hidden = false;
      document.body.style.overflow = 'hidden';
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', toggle.dataset.labelClose ?? 'Close menu');
      panel.querySelector<HTMLElement>(FOCUSABLE)?.focus();
    };

    const close = () => {
      panel.hidden = true;
      document.body.style.overflow = '';
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', toggle.dataset.labelOpen ?? 'Open menu');
      lastFocused?.focus();
    };

    toggle.addEventListener('click', open);
    closeButton.addEventListener('click', close);

    document.addEventListener('keydown', (event) => {
      if (panel.hidden) return;
      if (event.key === 'Escape') {
        close();
        return;
      }
      if (event.key !== 'Tab') return;

      // Keep focus inside the panel while it is open.
      const items = Array.from(panel.querySelectorAll<HTMLElement>(FOCUSABLE));
      const first = items[0];
      const last = items[items.length - 1];
      if (!first || !last) return;

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });
  }
</script>
