---
import type { Locale } from '~/lib/i18n/config';
import type { SiteSettings } from '~/lib/content/types';
import { localizePath, t, text } from '~/lib/i18n/utils';
import { mainNav, mobileNav, supportNav } from '~/lib/nav';
import { hasImage, imageDimensions, imageUrl } from '~/lib/sanity/image';
import Icon from '~/components/ui/Icon.astro';
import LanguageToggle from './LanguageToggle.astro';

interface Props {
  lang: Locale;
  pathname: string;
  settings: SiteSettings;
}

const { lang, pathname, settings } = Astro.props;

const orgName = text(settings.orgName, lang);
const shortName = settings.orgShortName ?? 'SKO';

const hasLogo = hasImage(settings.logo);
const logoSrc = hasLogo && settings.logo ? imageUrl(settings.logo, { width: 320 }) : null;
const { width: logoWidth, height: logoHeight } = imageDimensions(settings.logo, 3 / 1);

function isCurrent(path: string): boolean {
  const target = localizePath(path, lang);
  return pathname === target || pathname.startsWith(target);
}
function groupCurrent(item: { path: string; children?: { path: string }[] }): boolean {
  return isCurrent(item.path) || (item.children ?? []).some((child) => isCurrent(child.path));
}
---

<header class="site-header relative z-20 border-b border-line-strong bg-canvas">
  <div class="wrap flex min-h-16 items-center gap-3 lg:min-h-[4.25rem] lg:gap-6">
    <a
      href={localizePath('/', lang)}
      class="flex min-h-11 flex-none items-center gap-2.5 text-ink-900 no-underline"
    >
      {
        hasLogo && logoSrc ? (
          <img
            src={logoSrc}
            alt={orgName}
            width={logoWidth}
            height={logoHeight}
            class="h-9 w-auto self-center lg:h-10"
            decoding="sync"
          />
        ) : (
          <>
            <span class="text-[1.375rem] leading-none font-bold tracking-[-0.03em]" aria-hidden="true">
              {shortName}
            </span>
            <span class="pt-0.5 text-[15px] leading-tight font-medium max-md:sr-only">
              <span class="sr-only-focusable">{shortName} — </span>
              {orgName}
            </span>
          </>
        )
      }
    </a>

    <nav class="ml-2 hidden lg:flex lg:items-center" aria-label={t(lang, 'mainNavLabel')}>
      {
        mainNav.map((item) =>
          item.children ? (
            <div class="nav-group">
              <a
                href={localizePath(item.path, lang)}
                aria-current={groupCurrent(item) ? 'page' : undefined}
                class="nav-link"
              >
                {t(lang, item.key)}
                <Icon name="chevron-down" size={12} class="ml-1 text-ink-400" />
              </a>
              <ul class="nav-menu">
                {item.children.map((child) => (
                  <li>
                    <a
                      href={localizePath(child.path, lang)}
                      aria-current={isCurrent(child.path) ? 'page' : undefined}
                    >
                      {t(lang, child.key)}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ) : (
            <a
              href={localizePath(item.path, lang)}
              aria-current={isCurrent(item.path) ? 'page' : undefined}
              class="nav-link"
            >
              {t(lang, item.key)}
            </a>
          ),
        )
      }
    </nav>

    <div class="ml-auto flex items-center gap-2 sm:gap-4">
      <LanguageToggle lang={lang} pathname={pathname} />

      <div class="nav-group hidden sm:block">
        <a
          href={localizePath(supportNav.path, lang)}
          class="btn btn-primary btn-sm"
          aria-current={groupCurrent(supportNav) ? 'page' : undefined}
        >
          {t(lang, supportNav.key)}
          <Icon name="chevron-down" size={12} class="hidden lg:block" />
        </a>
        <ul class="nav-menu right-0 left-auto hidden lg:block">
          {
            supportNav.children?.map((child) => (
              <li>
                <a
                  href={localizePath(child.path, lang)}
                  aria-current={isCurrent(child.path) ? 'page' : undefined}
                >
                  {t(lang, child.key)}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <button
        type="button"
        id="menu-toggle"
        class="inline-flex min-h-11 items-center gap-2 border border-ink-900 bg-transparent px-3 text-[15px] font-medium text-ink-900 lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        {t(lang, 'menu')}
        <Icon name="menu" size={16} />
      </button>
    </div>
  </div>
</header>

<div
  id="mobile-nav"
  hidden
  class="fixed inset-0 z-50 flex flex-col bg-canvas lg:hidden"
  role="dialog"
  aria-modal="true"
  aria-label={t(lang, 'menu')}
>
  <div class="wrap flex min-h-16 flex-none items-center border-b border-line-strong">
    <span class="text-[1.375rem] font-bold tracking-[-0.03em] text-ink-900" aria-hidden="true"
      >{shortName}</span
    >
    <button
      type="button"
      id="menu-close"
      class="ml-auto inline-flex min-h-11 items-center gap-2 border border-ink-900 bg-transparent px-3 text-[15px] font-medium text-ink-900"
    >
      {t(lang, 'closeMenu')}
      <Icon name="close" size={16} />
    </button>
  </div>

  <nav class="wrap flex-1 overflow-y-auto pb-10" aria-label={t(lang, 'mainNavLabel')}>
    {
      mobileNav.map((group) => (
        <div class="border-b border-line py-4">
          {group.children && <p class="label mb-1">{t(lang, group.key)}</p>}
          <ul class="list-none p-0">
            {(group.children ?? [group]).map((item) => (
              <li>
                <a
                  href={localizePath(item.path, lang)}
                  aria-current={isCurrent(item.path) ? 'page' : undefined}
                  class="flex min-h-11 items-center justify-between py-2 text-[length:var(--text-h3)] font-medium text-ink-900 no-underline aria-[current]:text-indigo-700"
                >
                  {t(lang, item.key)}
                  <Icon name="arrow-right" size={16} class="text-indigo-700" />
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }

    <div class="mt-6">
      <p class="label mb-2">{t(lang, 'language')}</p>
      <LanguageToggle lang={lang} pathname={pathname} full />
    </div>
  </nav>
</div>

<script>
  const toggle = document.getElementById('menu-toggle');
  const closeButton = document.getElementById('menu-close');
  const panel = document.getElementById('mobile-nav');

  // Escape closes an open hover/focus submenu by dropping focus out of it.
  document.querySelectorAll<HTMLElement>('.nav-group').forEach((group) => {
    group.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      const trigger = group.querySelector<HTMLElement>('a');
      trigger?.focus();
      trigger?.blur();
    });
  });

  if (toggle && panel && closeButton) {
    const FOCUSABLE = 'a[href], button:not([disabled])';
    let lastFocused: HTMLElement | null = null;

    const open = () => {
      lastFocused = document.activeElement as HTMLElement | null;
      panel.hidden = false;
      document.body.style.overflow = 'hidden';
      toggle.setAttribute('aria-expanded', 'true');
      panel.querySelector<HTMLElement>(FOCUSABLE)?.focus();
    };

    /**
     * Closing plays an exit animation before the panel is hidden. `hidden`
     * removes it instantly, so the element has to survive one animation first.
     * Guarded three ways: reduced-motion skips it entirely, a missing
     * animationend event still resolves via the timeout, and re-entry is
     * blocked while an exit is already running.
     */
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    const finishClose = () => {
      panel.hidden = true;
      panel.removeAttribute('data-closing');
      document.body.style.overflow = '';
      toggle.setAttribute('aria-expanded', 'false');
      lastFocused?.focus();
    };

    const close = () => {
      if (panel.hidden || panel.hasAttribute('data-closing')) return;

      if (prefersReducedMotion.matches) {
        finishClose();
        return;
      }

      panel.setAttribute('data-closing', '');
      let done = false;
      const settle = () => {
        if (done) return;
        done = true;
        finishClose();
      };
      panel.addEventListener('animationend', settle, { once: true });
      window.setTimeout(settle, 400);
    };

    toggle.addEventListener('click', open);
    closeButton.addEventListener('click', close);

    document.addEventListener('keydown', (event) => {
      if (panel.hidden) return;
      if (event.key === 'Escape') {
        close();
        return;
      }
      if (event.key !== 'Tab') return;

      const items = Array.from(panel.querySelectorAll<HTMLElement>(FOCUSABLE));
      const first = items[0];
      const last = items[items.length - 1];
      if (!first || !last) return;

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });
  }
</script>
