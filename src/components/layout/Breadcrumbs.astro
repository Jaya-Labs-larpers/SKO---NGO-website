---
import type { Locale } from '~/lib/i18n/config';
import { localizePath, t } from '~/lib/i18n/utils';
import { siteUrl } from '~/lib/config';
import type { Crumb } from '~/lib/breadcrumbs';
import { serializeJsonLd } from '~/lib/seo/json-ld';

interface Props {
  lang: Locale;
  trail: Crumb[];
  /** Light text for navy bands. */
  inverse?: boolean;
}

const { lang, trail, inverse = false } = Astro.props;

const items = [{ label: t(lang, 'navHome'), path: '/' }, ...trail];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((crumb, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: crumb.label,
    ...(crumb.path ? { item: new URL(localizePath(crumb.path, lang), siteUrl).href } : {}),
  })),
};
---

<nav aria-label={t(lang, 'breadcrumbLabel')} class="eyebrow leading-[1.8]">
  <ol class="m-0 flex list-none flex-wrap items-center gap-x-2 p-0">
    {
      items.map((crumb, index) => (
        <li class="flex items-center gap-2">
          {crumb.path && index < items.length - 1 ? (
            <a
              href={localizePath(crumb.path, lang)}
              class:list={[
                'no-underline hover:underline',
                inverse ? 'text-[color:var(--color-on-navy)]' : 'text-[color:var(--color-ink-400)]',
              ]}
            >
              {crumb.label}
            </a>
          ) : (
            <span
              aria-current="page"
              class={inverse ? 'text-white' : 'text-[color:var(--color-ink-900)]'}
            >
              {crumb.label}
            </span>
          )}
          {index < items.length - 1 && <span aria-hidden="true">/</span>}
        </li>
      ))
    }
  </ol>
</nav>
<script is:inline type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />
