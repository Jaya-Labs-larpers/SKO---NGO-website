---
import type { Locale } from '~/lib/i18n/config';
import { tPick } from '~/lib/i18n/utils';

/**
 * "On this page" index for evidence pages. A sticky numbered column on wide
 * screens; a compact wrapped list of anchors on phones.
 */
interface Props {
  lang: Locale;
  items: { id: string; label: string; lang?: string | undefined }[];
}

const { lang, items } = Astro.props;
const heading = tPick(lang, 'onThisPage');
---

<nav
  aria-label={heading.value}
  class="border-b border-line pb-4 lg:sticky lg:top-6 lg:border-b-0 lg:pb-0"
>
  <p class="label mb-2 text-ink-900" lang={heading.isFallback ? heading.lang : undefined}>{heading.value}</p>
  <ol class="flex list-none flex-wrap gap-x-5 gap-y-1 p-0 lg:flex-col lg:gap-0">
    {
      items.map((item, index) => (
        <li>
          <a
            href={`#${item.id}`}
            class="inline-flex min-h-11 items-baseline gap-2.5 text-[15px] font-medium text-ink-900 no-underline hover:text-indigo-700 hover:underline"
            lang={item.lang}
          >
            <span class="mono" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            {item.label}
          </a>
        </li>
      ))
    }
  </ol>
</nav>
