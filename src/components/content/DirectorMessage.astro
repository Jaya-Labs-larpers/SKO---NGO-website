---
import type { Locale } from '~/lib/i18n/config';
import type { DirectorMessage } from '~/lib/content/types';
import { pick } from '~/lib/i18n/utils';
import ResponsiveImage from '~/components/media/ResponsiveImage.astro';
import RichText from './RichText.astro';

interface Props {
  lang: Locale;
  director: DirectorMessage;
}

const { lang, director } = Astro.props;

const name = pick(director.name, lang);
const title = pick(director.title, lang);
const pullQuote = pick(director.pullQuote, lang);

/**
 * The pull quote is set in Source Serif in English. In Khmer it drops the serif
 * and uses Kantumruy SemiBold at a larger size and looser leading — Khmer has no
 * serif tradition and a faked one looks wrong.
 */
const quoteClass =
  lang === 'km'
    ? 'font-[family-name:var(--font-khmer)] text-[24px] leading-[1.75] font-semibold'
    : 'font-[family-name:var(--font-display)] text-[27px] leading-[1.35] font-semibold tracking-[-0.01em]';
---

<div
  class="relative grid gap-11 overflow-hidden rounded-[var(--radius-xl)] border border-[color:var(--color-line)] bg-white p-7 sm:p-11 lg:grid-cols-[300px_1fr]"
>
  <!-- 4px accent rule, top-left -->
  <span class="absolute top-0 left-0 h-1 w-[132px] bg-[color:var(--color-blue-700)]" aria-hidden="true"
  ></span>

  <div
    class="max-h-[320px] overflow-hidden rounded-[var(--radius-lg)] lg:aspect-4/5 lg:max-h-none [&_img]:object-top"
  >
    <ResponsiveImage
      image={director.photo}
      lang={lang}
      alt=""
      aspect="4/5"
      sizes="(min-width: 64rem) 300px, 100vw"
    />
  </div>

  <div class="relative pt-1.5">
    <span
      class="pointer-events-none absolute -top-3.5 -left-1.5 font-[family-name:var(--font-display)] text-[84px] leading-none font-bold text-[color:var(--color-aqua-200)]"
      aria-hidden="true">&ldquo;</span
    >

    {
      pullQuote.value && (
        <blockquote
          class:list={['relative m-0 text-[color:var(--color-ink-900)]', quoteClass]}
          lang={pullQuote.isFallback ? pullQuote.lang : undefined}
        >
          {pullQuote.value}
        </blockquote>
      )
    }

    <RichText blocks={director.message} lang={lang} class="mt-5 max-w-none text-[16.5px]" />

    <div class="mt-6.5 border-t border-[color:var(--color-line)] pt-5">
      <b
        class="block text-[16px] text-[color:var(--color-ink-900)]"
        lang={name.isFallback ? name.lang : undefined}>{name.value}</b
      >
      <span
        class="mt-0.5 block text-[14px] text-[color:var(--color-ink-400)]"
        lang={title.isFallback ? title.lang : undefined}>{title.value}</span
      >
    </div>
  </div>
</div>
