---
import type { Locale } from '~/lib/i18n/config';
import type { DirectorMessage } from '~/lib/content/types';
import { pick, t } from '~/lib/i18n/utils';
import ResponsiveImage from '~/components/media/ResponsiveImage.astro';
import RichText from './RichText.astro';

interface Props {
  lang: Locale;
  director: DirectorMessage;
  /** `band` is the home page's centred quote on the wing tint; `full` is the About page. */
  variant?: 'full' | 'band';
}

const { lang, director, variant = 'full' } = Astro.props;

const name = pick(director.name, lang);
const title = pick(director.title, lang);
const pullQuote = pick(director.pullQuote, lang);
const photoCaption = pick(director.photo?.caption, lang);
---

{
  variant === 'band' ? (
    <figure class="m-0 mx-auto flex max-w-[1100px] flex-col items-center gap-9 text-center">
      <h2 id="director-title" class="eyebrow !text-[color:var(--color-ink-900)]">
        {t(lang, 'directorMessage')}
      </h2>
      {pullQuote.value && (
        <blockquote
          class="t-md m-0 !text-[color:var(--color-blue-750)]"
          style="font-size:calc(clamp(1.87rem,3.87vw,3.52rem)*var(--display-scale))"
          lang={pullQuote.isFallback ? pullQuote.lang : undefined}
        >
          {pullQuote.value}
        </blockquote>
      )}
      <figcaption class="flex items-center gap-4 text-left">
        <span class="block h-[72px] w-[72px] flex-none overflow-hidden rounded-full border-[3px] border-[color:var(--color-blue-750)] [&_img]:object-[center_20%]">
          <ResponsiveImage image={director.photo} lang={lang} alt="" aspect="1/1" sizes="72px" />
        </span>
        <span class="flex flex-col">
          <span class="text-[19px] font-bold" lang={name.isFallback ? name.lang : undefined}>
            {name.value}
          </span>
          <span
            class="eyebrow !text-[color:var(--color-ink-900)]"
            lang={title.isFallback ? title.lang : undefined}
          >
            {title.value}
          </span>
        </span>
      </figcaption>
    </figure>
  ) : (
    <div class="grid [grid-template-columns:repeat(auto-fit,minmax(min(100%,380px),1fr))] items-start gap-[clamp(40px,5vw,80px)]">
      <figure class="m-0 flex flex-col gap-3.5">
        <div class="aspect-[4/5] overflow-hidden rounded-[var(--radius-lg)] [&_img]:object-top">
          <ResponsiveImage
            image={director.photo}
            lang={lang}
            alt={name.value ?? ''}
            aspect="4/5"
            sizes="(min-width: 64rem) 30vw, 100vw"
          />
        </div>
        <figcaption class="flex flex-col border-t border-[color:var(--color-line)] pt-3">
          <span
            class="text-[19px] font-bold text-[color:var(--color-ink-900)]"
            lang={name.isFallback ? name.lang : undefined}
          >
            {name.value}
          </span>
          <span class="eyebrow" lang={title.isFallback ? title.lang : undefined}>
            {title.value}
          </span>
          {photoCaption.value && (
            <span
              class="mt-2 text-sm text-[color:var(--color-ink-400)]"
              lang={photoCaption.isFallback ? photoCaption.lang : undefined}
            >
              {photoCaption.value}
            </span>
          )}
        </figcaption>
      </figure>
      <div class="flex min-w-0 flex-col gap-8 md:col-span-2">
        <h2 id="director-title" class="eyebrow">
          {t(lang, 'directorMessage')}
        </h2>
        {pullQuote.value && (
          <blockquote
            class="t-xs m-0 border-b-[6px] border-[color:var(--color-sky-400)] pb-8"
            style="font-size:calc(clamp(1.87rem,3.34vw,3.19rem)*var(--display-scale));line-height:1.06"
            lang={pullQuote.isFallback ? pullQuote.lang : undefined}
          >
            {pullQuote.value}
          </blockquote>
        )}
        <RichText
          blocks={director.message}
          lang={lang}
          class="max-w-[58ch] text-xl leading-[1.55]"
        />
      </div>
    </div>
  )
}
