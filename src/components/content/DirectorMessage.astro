---
import type { Locale } from '~/lib/i18n/config';
import type { DirectorMessage } from '~/lib/content/types';
import { pick } from '~/lib/i18n/utils';
import ResponsiveImage from '~/components/media/ResponsiveImage.astro';
import RichText from './RichText.astro';

/**
 * The one pre-agreed special treatment: portrait beside the message, a
 * terracotta rule under the pull quote. Brought into the grotesk and
 * hairline system; the earlier outlined card and decorative quote mark
 * are gone.
 */
interface Props {
  lang: Locale;
  director: DirectorMessage;
}

const { lang, director } = Astro.props;

const name = pick(director.name, lang);
const title = pick(director.title, lang);
const pullQuote = pick(director.pullQuote, lang);

/**
 * The pull quote is italic in English. Khmer has no italic tradition, so it
 * stays upright in Kantumruy at a larger size and looser leading.
 */
const quoteClass =
  lang === 'km'
    ? 'text-[1.375rem] leading-[1.75] font-medium'
    : 'text-[length:var(--text-h2)] leading-[1.3] font-normal italic tracking-[-0.01em]';
---

<div class="grid gap-8 lg:grid-cols-12 lg:gap-10">
  <figure class="m-0 lg:col-span-4">
    <div class="max-w-[20rem] lg:max-w-none [&_img]:object-top">
      <ResponsiveImage
        image={director.photo}
        lang={lang}
        alt=""
        aspect="4/5"
        sizes="(min-width: 64rem) 360px, 320px"
        placeholder="[Portrait]"
      />
    </div>
    <figcaption class="mt-3 border-t border-line pt-3">
      <span class="block text-[15px] font-medium text-ink-900" lang={name.isFallback ? name.lang : undefined}
        >{name.value}</span
      >
      <span class="mt-0.5 block text-[13px] text-ink-400" lang={title.isFallback ? title.lang : undefined}>{title.value}</span>
    </figcaption>
  </figure>

  <div class="lg:col-span-8">
    {
      pullQuote.value && (
        <blockquote
          class:list={['m-0 max-w-[36ch] border-b border-terracotta-700 pb-6 text-ink-900', quoteClass]}
          lang={pullQuote.isFallback ? pullQuote.lang : undefined}
        >
          {pullQuote.value}
        </blockquote>
      )
    }
    <RichText blocks={director.message} lang={lang} class="mt-6" />
  </div>
</div>
