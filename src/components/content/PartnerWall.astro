---
import type { Locale } from '~/lib/i18n/config';
import type { Partner } from '~/lib/content/types';
import { hasImage } from '~/lib/sanity/image';
import ResponsiveImage from '~/components/media/ResponsiveImage.astro';

interface Props {
  lang: Locale;
  partners: Partner[];
  /** `strip` is the home page's ruled grid of logos; `cards` names each partner under its logo. */
  variant?: 'strip' | 'cards';
}

const { lang, partners, variant = 'strip' } = Astro.props;
const cards = variant === 'cards';
---

<ul
  class:list={[
    'm-0 grid list-none p-0',
    cards
      ? '[grid-template-columns:repeat(auto-fill,minmax(min(100%,280px),1fr))] gap-6'
      : '[grid-template-columns:repeat(auto-fill,minmax(min(100%,240px),1fr))] border-t border-l border-[color:var(--color-line)]',
  ]}
>
  {
    partners.map((partner) => {
      const Tag = partner.url ? 'a' : 'div';
      const logo = hasImage(partner.logo) ? (
        <div class="grid h-full min-h-0 w-full place-items-center [&_img]:max-h-full [&_img]:object-contain">
          <ResponsiveImage
            image={partner.logo}
            lang={lang}
            alt={cards ? '' : partner.name}
            aspect="5/3"
            sizes="220px"
            blurUp={false}
          />
        </div>
      ) : (
        <span
          class="grid h-full w-full place-items-center bg-[color:var(--color-blue-50)] px-3 text-center text-[15px] leading-snug font-bold text-[color:var(--color-ink-900)]"
          aria-hidden={cards ? 'true' : undefined}
        >
          {partner.name}
        </span>
      );
      return (
        <li class:list={[cards ? 'flex flex-col gap-3.5' : 'contents']}>
          <Tag
            {...(partner.url
              ? { href: partner.url, rel: 'noopener noreferrer', target: '_blank' }
              : {})}
            class:list={[
              'block no-underline',
              cards
                ? 'h-[148px] rounded-[var(--radius-lg)] border border-[color:var(--color-line)] p-6'
                : 'h-[152px] border-r border-b border-[color:var(--color-line)] p-7',
            ]}
          >
            {!cards && <span class="sr-only">{partner.name}</span>}
            {logo}
          </Tag>
          {cards && <span class="text-lg leading-[1.3] font-bold">{partner.name}</span>}
        </li>
      );
    })
  }
</ul>
