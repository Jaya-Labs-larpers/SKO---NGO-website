---
import type { Locale } from '~/lib/i18n/config';
import type { Partner } from '~/lib/content/types';
import ResponsiveImage from '~/components/media/ResponsiveImage.astro';

interface Props {
  lang: Locale;
  partners: Partner[];
  columns?: 3 | 5;
}

const { lang, partners, columns = 5 } = Astro.props;
---

<ul
  class:list={[
    'grid list-none gap-px overflow-hidden rounded-[var(--radius-lg)] border border-[color:var(--color-line)] bg-[color:var(--color-line-subtle)] p-0',
    'grid-cols-2 sm:grid-cols-3',
    columns === 5 ? 'lg:grid-cols-5' : 'lg:grid-cols-3',
  ]}
>
  {
    partners.map((partner) => {
      const Tag = partner.url ? 'a' : 'div';
      return (
        <li class="contents">
          <Tag
            {...(partner.url
              ? { href: partner.url, rel: 'noopener noreferrer', target: '_blank' }
              : {})}
            class="grid aspect-5/3 place-items-center bg-white p-4 no-underline transition-colors hover:bg-[color:var(--color-blue-50)]"
          >
            <span class="sr-only-focusable">{partner.name}</span>
            <div class="grid h-full w-full place-items-center [&_img]:object-contain [&_img]:grayscale [&_img]:transition [&_img]:hover:grayscale-0">
              <ResponsiveImage
                image={partner.logo}
                lang={lang}
                alt=""
                aspect="5/3"
                sizes="180px"
                placeholder="[LOGO]"
              />
            </div>
          </Tag>
        </li>
      );
    })
  }
</ul>
