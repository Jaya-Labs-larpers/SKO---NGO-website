---
import type { Locale } from '~/lib/i18n/config';
import type { ImpactStat } from '~/lib/content/types';
import { formatNumber, pick } from '~/lib/i18n/utils';

/**
 * Figures as ledger rows: the figure in its own column, then what it counts
 * and where the count comes from. No count-up: a figure that animates reads
 * as marketing; a figure that is simply there reads as a fact. The page that
 * renders them links the method beneath.
 */
interface Props {
  lang: Locale;
  stats: ImpactStat[];
}

const { lang, stats } = Astro.props;
---

{
  stats.length > 0 && (
    <dl class="border-b border-line">
      {stats.map((stat) => {
        const label = pick(stat.label, lang);
        const context = pick(stat.context, lang);
        const suffix = pick(stat.suffix, lang);
        const display =
          stat.displayValue ?? (typeof stat.value === 'number' ? formatNumber(stat.value, lang) : '');
        return (
          <div class="grid grid-cols-[minmax(0,1fr)] gap-x-6 gap-y-1 border-t border-line py-4 sm:grid-cols-[7.5rem_minmax(0,1fr)] sm:items-baseline lg:grid-cols-[8.5rem_minmax(0,22rem)_minmax(0,1fr)]">
            <dt
              class="order-2 text-[15px] font-medium text-ink-900"
              lang={label.isFallback ? label.lang : undefined}
            >
              {label.value}
            </dt>
            <dd class="order-1 m-0 text-[length:var(--text-h2)] leading-none font-semibold tracking-[var(--text-h2--letter-spacing)] text-ink-900 tabular-nums">
              {display}
              {suffix.value && <span class="text-[0.6em] font-medium tracking-normal">{suffix.value}</span>}
            </dd>
            {context.value && (
              <dd
                class="order-3 m-0 text-[13px] leading-[1.5] text-ink-400 sm:col-start-2 lg:col-start-3"
                lang={context.isFallback ? context.lang : undefined}
              >
                {context.value}
              </dd>
            )}
          </div>
        );
      })}
    </dl>
  )
}
