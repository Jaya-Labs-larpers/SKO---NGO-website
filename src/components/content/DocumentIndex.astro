---
import type { Locale } from '~/lib/i18n/config';
import type { Report } from '~/lib/content/types';
import { formatFileSize, pick, t } from '~/lib/i18n/utils';
import { label, reportTypeLabels } from '~/lib/labels';
import Icon from '~/components/ui/Icon.astro';

/**
 * A document index: year, title, then the evidence metadata a grant officer
 * checks before downloading — type, language, format, size. Rows are ruled,
 * never boxed, and the whole row is the download.
 */
interface Props {
  lang: Locale;
  reports: Report[];
}

const { lang, reports } = Astro.props;
---

<ul class="list-none border-b border-line p-0">
  {
    reports.map((report) => {
      const title = pick(report.title, lang);
      const summary = pick(report.summary, lang);
      // Prefer the Khmer PDF when the visitor is reading Khmer and one exists.
      const useKhmer = lang === 'km' && Boolean(report.fileKm?.url);
      const file = useKhmer ? report.fileKm : report.file;
      const languages = [report.file?.url ? 'EN' : null, report.fileKm?.url ? 'KM' : null]
        .filter(Boolean)
        .join(' / ');
      const extension = file?.extension ?? /\.([a-z0-9]{2,4})(?:$|[?#])/i.exec(file?.url ?? '')?.[1] ?? null;
      const direct = Boolean(extension);
      const meta = [
        label(reportTypeLabels, report.type, lang),
        extension?.toUpperCase(),
        languages,
        formatFileSize(file?.size),
      ]
        .filter(Boolean)
        .join(' · ');
      const available = Boolean(file?.url);

      return (
        <li>
          <a
            href={file?.url ?? '#'}
            download={available && direct ? '' : undefined}
            target={available && !direct ? '_blank' : undefined}
            rel={available && !direct ? 'noopener noreferrer' : undefined}
            aria-disabled={available ? undefined : 'true'}
            class:list={[
              'row-link grid-cols-[minmax(0,1fr)_auto] sm:grid-cols-[4.5rem_minmax(0,1fr)_auto]',
              !available && 'cursor-not-allowed',
            ]}
          >
            <span class="mono mono-lg text-ink-900">{report.year ?? '—'}</span>
            <span class="col-span-2 min-w-0 sm:col-span-1">
              <span
                class="block text-[length:var(--text-h3)] leading-[var(--text-h3--line-height)] font-semibold tracking-[var(--text-h3--letter-spacing)]"
                lang={title.isFallback ? title.lang : undefined}
              >
                {title.value}
              </span>
              {summary.value && (
                <span
                  class="mt-1 block max-w-[62ch] text-[15px] leading-[1.55] text-ink-600"
                  lang={summary.isFallback ? summary.lang : undefined}
                >
                  {summary.value}
                </span>
              )}
              <span class="mono mt-2 block">{meta}</span>
            </span>
            <span class="col-start-2 row-start-1 flex items-center gap-1.5 self-center text-[15px] font-medium text-indigo-700 sm:col-start-3">
              {direct ? (
                <>
                  <span class="hidden sm:inline">{t(lang, 'download')}</span>
                  <Icon name="arrow-down" size={16} class="row-arrow" />
                </>
              ) : (
                <Icon name="arrow-up-right" size={16} class="row-arrow" />
              )}
            </span>
          </a>
        </li>
      );
    })
  }
</ul>
