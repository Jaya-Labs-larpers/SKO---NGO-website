---
import type { Locale } from '~/lib/i18n/config';
import Breadcrumbs from '~/components/layout/Breadcrumbs.astro';
import ButterflyField from '~/components/media/ButterflyField.astro';
import type { Crumb } from '~/lib/breadcrumbs';
import InlineLinks from './InlineLinks.astro';

interface Props {
  lang: Locale;
  title: string;
  intro?: string | null;
  introLang?: string | undefined;
  eyebrow?: string;
  trail?: Crumb[];
}

const { lang, title, intro, introLang, eyebrow, trail } = Astro.props;
---

{
  /*
  Pulled up under the header, which stays transparent while the page is at the
  top (headerOverlay on BaseLayout), so the band's colour runs to the top of the
  window as the home hero's does. The padding pays the header's height back.
  The same flock as the home hero's (ButterflyField) flies inside this band,
  behind the text, and is clipped to it.
*/
}
<section
  class="hero-overlap relative border-b border-[color:var(--color-line-subtle)] bg-[color:var(--color-surface-subtle)] pt-[calc(var(--header-h)+3.5rem)] pb-13"
>
  <ButterflyField />
  <div class="wrap relative">
    <div data-butterfly-shelter>
      {trail && <Breadcrumbs lang={lang} trail={trail} />}
      {eyebrow && <p class="eyebrow mt-4">{eyebrow}</p>}
      <h1
        class="mt-3.5 text-[length:var(--text-h1)] leading-[var(--text-h1--line-height)] tracking-[var(--text-h1--letter-spacing)]"
      >
        {title}
      </h1>
      {
        intro && (
          <p
            class="justify inline-links mt-4 text-[length:var(--text-lead)] text-[color:var(--color-ink-400)]"
            lang={introLang}
          >
            <InlineLinks text={intro} />
          </p>
        )
      }
      <slot />
    </div>
  </div>
</section>
