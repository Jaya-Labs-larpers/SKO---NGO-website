---
import type { Locale } from '~/lib/i18n/config';
import type { TeamMember } from '~/lib/content/types';
import { pick } from '~/lib/i18n/utils';
import ResponsiveImage from '~/components/media/ResponsiveImage.astro';
import Icon from '~/components/Icon.astro';

interface Props {
  lang: Locale;
  team: TeamMember[];
}

const { lang, team } = Astro.props;

const ids = new Set(team.map((member) => member._id));
const reportsOf = (id: string) => team.filter((member) => member.reportsTo === id);
const roots = team.filter((member) => !member.reportsTo || !ids.has(member.reportsTo));
const [head] = roots.length === 1 ? roots : [];
const columns = head ? reportsOf(head._id) : roots;

const label = (member: TeamMember) => ({
  name: pick(member.name, lang),
  role: pick(member.role, lang),
});
const headLabel = head ? label(head) : null;
---

{/* A nested list, so a screen reader hears who reports to whom without the drawing. */}
<div class="flex flex-col gap-12">
  {
    head && headLabel && (
      <div class="on-navy flex min-w-[min(100%,420px)] items-center gap-6 self-start rounded-[var(--radius-lg)] bg-[color:var(--color-blue-900)] p-6 text-white">
        <div class="h-24 w-24 flex-none overflow-hidden rounded-[var(--radius-lg)]">
          <ResponsiveImage image={head.photo} lang={lang} alt="" aspect="1/1" sizes="96px" />
        </div>
        <div class="flex flex-col">
          <span
            class="font-[family-name:var(--font-display)] text-[1.65rem] leading-[1.1] font-bold"
            lang={headLabel.name.isFallback ? headLabel.name.lang : undefined}
          >
            {headLabel.name.value}
          </span>
          <span class="eyebrow" lang={headLabel.role.isFallback ? headLabel.role.lang : undefined}>
            {headLabel.role.value}
          </span>
        </div>
      </div>
    )
  }

  <ul
    class="m-0 grid list-none [grid-template-columns:repeat(auto-fit,minmax(min(100%,270px),1fr))] gap-8 p-0"
  >
    {
      columns.map((lead) => {
        const members = [lead, ...reportsOf(lead._id)];
        return (
          <li>
            <ul class="m-0 flex list-none flex-col border-t-[3px] border-t-[color:var(--color-blue-700)] p-0">
              {members.map((member, index) => {
                const { name, role } = label(member);
                const size = index === 0 ? 'h-[72px] w-[72px]' : 'h-14 w-14';
                return (
                  <li class="flex items-center gap-3.5 border-b border-[color:var(--color-blue-200)] py-3.5">
                    {member.vacancy ? (
                      <span
                        class="grid h-14 w-14 flex-none place-items-center rounded-[var(--radius-md)] bg-[color:var(--color-blue-200)] text-[color:var(--color-blue-700)]"
                        aria-hidden="true"
                      >
                        <Icon name="user" size={28} />
                      </span>
                    ) : (
                      <span
                        class:list={[size, 'flex-none overflow-hidden rounded-[var(--radius-lg)]']}
                      >
                        <ResponsiveImage
                          image={member.photo}
                          lang={lang}
                          alt=""
                          aspect="1/1"
                          sizes="72px"
                          class="object-[50%_15%]"
                        />
                      </span>
                    )}
                    <span class="flex min-w-0 flex-col">
                      <b
                        class="text-[17px] leading-[1.3] font-bold"
                        lang={name.isFallback ? name.lang : undefined}
                      >
                        {name.value}
                      </b>
                      {role.value && (
                        <span
                          class="text-sm text-[color:var(--color-ink-400)]"
                          lang={role.isFallback ? role.lang : undefined}
                        >
                          {role.value}
                        </span>
                      )}
                    </span>
                  </li>
                );
              })}
            </ul>
          </li>
        );
      })
    }
  </ul>
</div>
