---
import type { Locale } from '~/lib/i18n/config';
import type { FaqItem } from '~/lib/content/types';
import { pick, t } from '~/lib/i18n/utils';
import { serializeJsonLd } from '~/lib/seo/json-ld';

interface Props {
  lang: Locale;
  faqs: FaqItem[];
  heading?: string;
  id?: string;
}

const { lang, faqs, heading, id = 'faq' } = Astro.props;

/**
 * Each answer is written to stand alone, because that is how answer engines and
 * AI assistants use them — lifted whole, without the page around them.
 *
 * The markup is <dl> rather than a set of <details>: an answer hidden behind a
 * click is an answer some crawlers never see, and there are few enough of these
 * that collapsing them saves nothing worth the cost.
 */
const resolved = faqs
  .map((faq) => ({ question: pick(faq.question, lang), answer: pick(faq.answer, lang) }))
  .filter((faq) => faq.question.value && faq.answer.value);

const jsonLd =
  resolved.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: resolved.map((faq) => ({
          '@type': 'Question',
          name: faq.question.value,
          acceptedAnswer: { '@type': 'Answer', text: faq.answer.value },
        })),
      }
    : null;
---

{
  resolved.length > 0 && (
    <section class="wrap">
      <div class="ledger">
        <h2 id={id} class="text-[length:var(--text-h2)] leading-[var(--text-h2--line-height)] tracking-[var(--text-h2--letter-spacing)] scroll-mt-24">
          {heading ?? t(lang, 'faqHeading')}
        </h2>
        <dl class="max-w-[64ch]">
          {resolved.map((faq, index) => (
            <div class:list={['border-line py-5', index > 0 && 'border-t']}>
              <dt
                class="text-[length:var(--text-h3)] leading-[var(--text-h3--line-height)] font-semibold text-ink-900"
                lang={faq.question.isFallback ? faq.question.lang : undefined}
              >
                {faq.question.value}
              </dt>
              <dd class="mt-2 text-ink-600" lang={faq.answer.isFallback ? faq.answer.lang : undefined}>
                {faq.answer.value}
              </dd>
            </div>
          ))}
        </dl>
      </div>
      <script is:inline type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />
    </section>
  )
}
