---
import type { Locale } from '~/lib/i18n/config';
import { t } from '~/lib/i18n/utils';

interface Props {
  lang: Locale;
  current: number;
  total: number;
  /** Builds the href for a page number. */
  hrefFor: (page: number) => string;
}

const { lang, current, total, hrefFor } = Astro.props;
const pages = Array.from({ length: total }, (_, index) => index + 1);
const base =
  'grid h-12 min-w-12 place-items-center rounded-[var(--radius-md)] border px-3 text-base font-semibold no-underline';
const idle =
  'border-[color:var(--color-line-strong)] bg-white text-[color:var(--color-ink-900)] hover:border-[color:var(--color-blue-700)] hover:text-[color:var(--color-ink-900)]';
---

{
  total > 1 && (
    <nav class="mt-12 flex flex-wrap gap-2" aria-label="Pagination">
      {current > 1 && (
        <a href={hrefFor(current - 1)} rel="prev" class:list={[base, idle]}>
          ← {t(lang, 'previous')}
        </a>
      )}
      {pages.map((page) =>
        page === current ? (
          <span
            aria-current="page"
            class:list={[
              base,
              'border-[color:var(--color-ink-900)] bg-[color:var(--color-ink-900)] text-white',
            ]}
          >
            {page}
          </span>
        ) : (
          <a href={hrefFor(page)} class:list={[base, idle]}>
            {page}
          </a>
        ),
      )}
      {current < total && (
        <a href={hrefFor(current + 1)} rel="next" class:list={[base, idle]}>
          {t(lang, 'next')} →
        </a>
      )}
    </nav>
  )
}
