---
import type { Locale } from '~/lib/i18n/config';
import { t } from '~/lib/i18n/utils';
import Icon from '~/components/ui/Icon.astro';

interface Props {
  lang: Locale;
  current: number;
  total: number;
  /** Builds the href for a page number. */
  hrefFor: (page: number) => string;
}

const { lang, current, total, hrefFor } = Astro.props;
const pages = Array.from({ length: total }, (_, index) => index + 1);

const cell =
  'inline-flex min-h-11 min-w-11 items-center justify-center gap-1.5 px-2 text-[15px] font-medium text-ink-900 no-underline hover:text-indigo-700 hover:underline';
---

{
  total > 1 && (
    <nav class="mt-10 flex flex-wrap items-center justify-between gap-2 border-t border-line pt-4" aria-label={t(lang, 'pageActivities')}>
      {current > 1 ? (
        <a href={hrefFor(current - 1)} rel="prev" class={cell}>
          <Icon name="arrow-left" size={14} />
          {t(lang, 'previous')}
        </a>
      ) : (
        <span />
      )}
      <ol class="flex list-none gap-1 p-0">
        {pages.map((page) => (
          <li>
            {page === current ? (
              <span aria-current="page" class:list={[cell, 'mono mono-lg border-b border-ink-900 text-ink-900']}>
                {page}
              </span>
            ) : (
              <a href={hrefFor(page)} class:list={[cell, 'mono mono-lg']}>
                {page}
              </a>
            )}
          </li>
        ))}
      </ol>
      {current < total ? (
        <a href={hrefFor(current + 1)} rel="next" class={cell}>
          {t(lang, 'next')}
          <Icon name="arrow-right" size={14} />
        </a>
      ) : (
        <span />
      )}
    </nav>
  )
}
