---
import type { Locale } from '~/lib/i18n/config';
import { t } from '~/lib/i18n/utils';

interface Props {
  lang: Locale;
  current: number;
  total: number;
  /** Builds the href for a page number. */
  hrefFor: (page: number) => string;
}

const { lang, current, total, hrefFor } = Astro.props;
const pages = Array.from({ length: total }, (_, index) => index + 1);
---

{
  total > 1 && (
    <nav class="mt-11 flex justify-center gap-1.5" aria-label="Pagination">
      {current > 1 && (
        <a href={hrefFor(current - 1)} rel="prev" class="grid h-[42px] min-w-[42px] place-items-center rounded-[var(--radius-sm)] border border-[color:var(--color-line)] bg-white px-3 text-[15px] font-semibold text-[color:var(--color-ink-700)] no-underline hover:border-[color:var(--color-blue-700)] hover:text-[color:var(--color-blue-800)]">
          ← {t(lang, 'previous')}
        </a>
      )}
      {pages.map((page) =>
        page === current ? (
          <span
            aria-current="page"
            class="grid h-[42px] min-w-[42px] place-items-center rounded-[var(--radius-sm)] border border-[color:var(--color-blue-700)] bg-[color:var(--color-blue-700)] text-[15px] font-semibold text-white"
          >
            {page}
          </span>
        ) : (
          <a
            href={hrefFor(page)}
            class="grid h-[42px] min-w-[42px] place-items-center rounded-[var(--radius-sm)] border border-[color:var(--color-line)] bg-white text-[15px] font-semibold text-[color:var(--color-ink-700)] no-underline hover:border-[color:var(--color-blue-700)] hover:text-[color:var(--color-blue-800)]"
          >
            {page}
          </a>
        ),
      )}
      {current < total && (
        <a href={hrefFor(current + 1)} rel="next" class="grid h-[42px] min-w-[42px] place-items-center rounded-[var(--radius-sm)] border border-[color:var(--color-line)] bg-white px-3 text-[15px] font-semibold text-[color:var(--color-ink-700)] no-underline hover:border-[color:var(--color-blue-700)] hover:text-[color:var(--color-blue-800)]">
          {t(lang, 'next')} →
        </a>
      )}
    </nav>
  )
}
