---
interface Props {
  message: string;
}

const { message } = Astro.props;
---

<p
  class="rounded-[var(--radius-lg)] border border-dashed border-[color:var(--color-line-strong)] bg-[color:var(--color-surface-subtle)] px-6 py-10 text-center text-[15px] text-[color:var(--color-ink-400)]"
>
  {message}
</p>
