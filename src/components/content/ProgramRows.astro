---
/**
 * The programs as a numbered list of ruled rows rather than a row of identical
 * cards: index, title and summary, and a small photo at the end of the row.
 * Each row is one stretched link, so the whole row is clickable and there is
 * only ever one interactive element per program. The photo carries
 * .card-media so card-morph grows it into the program's hero.
 */
import type { Locale } from '~/lib/i18n/config';
import type { Program } from '~/lib/content/types';
import { localizePath, pick, t } from '~/lib/i18n/utils';
import ResponsiveImage from '~/components/media/ResponsiveImage.astro';

interface Props {
  lang: Locale;
  programs: Program[];
  /** Leaves one programme out while keeping every other row's number. */
  exclude?: string;
}

const { lang, programs, exclude } = Astro.props;
---

<ol class="program-rows reveal list-none p-0">
  {
    programs.map((program, index) => {
      if (program.slug === exclude) return null;
      const title = pick(program.title, lang);
      const summary = pick(program.summary, lang);
      return (
        <li class="program-row group" data-cursor-label={t(lang, 'learnMore')}>
          <span class="program-row__index" aria-hidden="true">
            {String(index + 1).padStart(2, '0')}
          </span>
          <div class="program-row__text">
            <h3 class="program-row__title" lang={title.isFallback ? title.lang : undefined}>
              <a
                href={localizePath(`/programs/${program.slug}`, lang)}
                class="text-inherit no-underline before:absolute before:inset-0 before:content-['']"
              >
                {title.value}
              </a>
            </h3>
            {summary.value && (
              <p class="program-row__summary" lang={summary.isFallback ? summary.lang : undefined}>
                {summary.value}
              </p>
            )}
          </div>
          <div class="program-row__media card-media">
            <ResponsiveImage
              image={program.cardImage ?? program.image}
              lang={lang}
              alt=""
              aspect="4/3"
              sizes="(min-width: 64rem) 256px, 0px"
            />
          </div>
          <span class="program-row__arrow" aria-hidden="true">
            →
          </span>
        </li>
      );
    })
  }
</ol>

<script>
  import '~/lib/card-morph';
</script>
