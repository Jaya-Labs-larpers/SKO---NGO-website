---
import type { Locale } from '~/lib/i18n/config';
import type { Story } from '~/lib/content/types';
import { localizePath, pick } from '~/lib/i18n/utils';
import RichText from '~/components/content/RichText.astro';

interface Props {
  lang: Locale;
  story: Story;
  /** Show the pull quote alone even when the full account exists. */
  quoteOnly?: boolean;
  /** Link the role line to the story's programme page. */
  linkProgram?: boolean;
}

const { lang, story, quoteOnly = false, linkProgram = false } = Astro.props;

const quote = pick(story.quote, lang);
const hasBody =
  !quoteOnly &&
  Object.values(story.body ?? {}).some((value) => Array.isArray(value) && value.length > 0);
const role = pick(story.personRole, lang);
const programHref =
  linkProgram && story.program ? localizePath(`/programs/${story.program.slug}`, lang) : null;
---

<figure
  class="m-0 mx-auto grid max-w-[var(--container-inner)] [grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr))] gap-[clamp(24px,4vw,64px)]"
>
  <svg
    width="96"
    height="80"
    viewBox="0 0 48 40"
    aria-hidden="true"
    class="block h-auto w-14 sm:w-24"
  >
    <path
      fill="var(--color-blue-700)"
      d="M0 40V22C0 9 7 2 19 0l2 6C14 8 11 12 11 18h9v22H0Zm27 0V22C27 9 34 2 46 0l2 6c-7 2-10 6-10 12h9v22H27Z"
    ></path>
  </svg>
  <div class="flex min-w-0 flex-col gap-7 md:[grid-column:span_2] md:col-span-2">
    {
      hasBody ? (
        <blockquote class="m-0 text-[length:var(--text-lead)] leading-[1.6] text-[color:var(--color-ink-900)]">
          <RichText blocks={story.body} lang={lang} />
        </blockquote>
      ) : (
        <blockquote
          class="t-statement m-0 text-[color:var(--color-ink-900)]"
          lang={quote.isFallback ? quote.lang : undefined}
        >
          {quote.value}
        </blockquote>
      )
    }
    <figcaption
      class="border-t border-[color:var(--color-blue-200)] pt-5 text-base text-[color:var(--color-ink-400)]"
    >
      — {story.personName}
      {
        role.value && (
          <span lang={role.isFallback ? role.lang : undefined}>
            ,{' '}
            {programHref ? (
              <a href={programHref} class="font-semibold underline underline-offset-[5px]">
                {role.value}
              </a>
            ) : (
              role.value
            )}
          </span>
        )
      }
    </figcaption>
  </div>
</figure>
