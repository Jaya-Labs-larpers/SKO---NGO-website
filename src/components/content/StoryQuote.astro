---
import type { Locale } from '~/lib/i18n/config';
import type { Story } from '~/lib/content/types';
import { pick } from '~/lib/i18n/utils';
import { hasImage } from '~/lib/sanity/image';
import ResponsiveImage from '~/components/media/ResponsiveImage.astro';

interface Props {
  lang: Locale;
  story: Story;
  /** Show the person's avatar alongside the attribution. */
  showAvatar?: boolean;
}

const { lang, story, showAvatar = false } = Astro.props;

const quote = pick(story.quote, lang);
const role = pick(story.personRole, lang);

/**
 * A photo is only shown when one exists AND staff have not asked for the
 * silhouette. The illustrated avatar is the compliant option for the common
 * case: a real story where no publishable photo exists.
 */
const usePhoto = !story.useSilhouette && hasImage(story.photo);

/**
 * English quotations take the italic; Khmer has no italic tradition, so it
 * stays upright in Kantumruy at a slightly larger size with looser leading.
 */
const quoteClass =
  lang === 'km'
    ? 'text-[1.25rem] leading-[1.8] font-medium'
    : 'text-[1.375rem] leading-[1.4] font-normal italic tracking-[-0.005em]';
---

<figure class="m-0 border-l border-terracotta-700 pl-5">
  <blockquote
    class:list={['m-0 max-w-[40ch] text-ink-900', quoteClass]}
    lang={quote.isFallback ? quote.lang : undefined}
  >
    {quote.value}
  </blockquote>

  <figcaption class="mt-4 flex items-center gap-3 text-[15px] text-ink-600">
    {
      showAvatar &&
        (usePhoto ? (
          <span class="h-10 w-10 flex-none overflow-hidden">
            <ResponsiveImage image={story.photo} lang={lang} alt="" aspect="1/1" sizes="40px" />
          </span>
        ) : (
          <span class="grid h-10 w-10 flex-none place-items-center bg-surface-sunken" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" class="text-ink-400">
              <circle cx="10" cy="7" r="3.25" />
              <path d="M3.75 17c0-3.2 2.8-5.25 6.25-5.25s6.25 2.05 6.25 5.25" />
            </svg>
          </span>
        ))
    }
    <span>
      <span class="font-medium text-ink-900">{story.personName}</span>
      {role.value && <span lang={role.isFallback ? role.lang : undefined}>, {role.value}</span>}
    </span>
  </figcaption>
</figure>
