---
/**
 * The About page body, laid out section by section. The text is exactly what
 * staff typed into the page's body in Sanity; ~/lib/content/sections only
 * decides where each "## " section breaks and which layout its shape suits.
 * A Khmer body gets the same layouts; until one exists the English falls back
 * with lang="en" on every section.
 */
import type { Locale } from '~/lib/i18n/config';
import type { LocaleBlocks } from '~/lib/content/types';
import { pick } from '~/lib/i18n/utils';
import { blockText, splitBody, splitLeadIn, splitPoint } from '~/lib/content/sections';
import RichText from './RichText.astro';

interface Props {
  lang: Locale;
  body?: LocaleBlocks | null;
}

const { lang, body } = Astro.props;

const picked = pick(body, lang);
const bodyLang = picked.lang;
const fallbackLang = picked.isFallback ? bodyLang : undefined;
const { lead, sections } = splitBody(picked.value);

/** RichText picks by locale, so each slice goes back in under the body's own language. */
const asBlocks = (blocks: typeof lead): LocaleBlocks => ({ [bodyLang]: blocks });
---

{
  lead.length > 0 && (
    <section class="section pb-0">
      <div class="wrap">
        <RichText blocks={asBlocks(lead)} lang={lang} class="about-lead" />
      </div>
    </section>
  )
}

{
  sections.map((section) => (
    <section class:list={['about-section', `about-section--${section.layout}`]} lang={fallbackLang}>
      <div class="wrap about-section__grid">
        <h2 class:list={['about-section__label eyebrow', section.layout === 'points' && 'reveal']}>
          {section.heading}
        </h2>

        {section.layout === 'statement' && (
          <RichText blocks={asBlocks(section.blocks)} lang={lang} class="about-statement" />
        )}

        {section.layout === 'terms' && (
          <ol class="about-terms reveal reveal-cascade list-none p-0">
            {section.blocks.map((block, index) => {
              const split = splitLeadIn(blockText(block))!;
              return (
                <li class="about-term" style={`--i:${index}`}>
                  <span class="about-term__index" aria-hidden="true">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <span class="about-term__name">{split.term}</span>
                  <span class="about-term__text">{split.rest}</span>
                </li>
              );
            })}
          </ol>
        )}

        {section.layout === 'points' && (
          <ol class="about-terms reveal reveal-cascade reveal-cascade--slow list-none p-0" data-reveal-ms="2400">
            {section.blocks.map((block, index) => {
              const split = splitPoint(blockText(block))!;
              return (
                <li class="about-term" style={`--i:${index}`}>
                  <span class="about-term__index" aria-hidden="true">
                    {index + 1}.
                  </span>
                  <span class="about-term__name">{split.term}</span>
                  <span class="about-term__text">{split.rest}</span>
                </li>
              );
            })}
          </ol>
        )}

        {section.layout === 'facts' && (
          <RichText blocks={asBlocks(section.blocks)} lang={lang} class="about-facts" />
        )}

        {section.layout === 'prose' && (
          <RichText blocks={asBlocks(section.blocks)} lang={lang} class="about-prose" />
        )}
      </div>
    </section>
  ))
}
