---
import type { Locale } from '~/lib/i18n/config';
import { localizePath, t } from '~/lib/i18n/utils';
import Icon from '~/components/ui/Icon.astro';

/** The page's close: one ruled row, one heading, one primary action. */
interface Props {
  lang: Locale;
  title: string;
  body?: string;
  secondaryKey?: 'seeReports' | 'partnerWithUs' | 'contactUs';
  secondaryPath?: string;
}

const { lang, title, body, secondaryKey = 'partnerWithUs', secondaryPath = '/partner-with-us' } = Astro.props;
---

<section class="wrap">
  <div class="grid gap-6 border-t border-line-ink py-10 lg:grid-cols-12 lg:py-14">
    <div class="lg:col-span-7">
      <h2 class="max-w-[22ch] text-[length:var(--text-h2)] leading-[var(--text-h2--line-height)] tracking-[var(--text-h2--letter-spacing)]">
        {title}
      </h2>
      {body && <p class="mt-3 max-w-[52ch] text-ink-600">{body}</p>}
    </div>
    <div class="flex flex-wrap items-center gap-x-6 gap-y-3 lg:col-span-5 lg:justify-end">
      <a href={localizePath('/donate', lang)} class="btn btn-primary">
        {t(lang, 'donateNow')}
        <Icon name="arrow-right" size={16} />
      </a>
      <a href={localizePath(secondaryPath, lang)} class="link">
        {t(lang, secondaryKey)}
        <Icon name="arrow-right" size={14} />
      </a>
    </div>
  </div>
</section>
