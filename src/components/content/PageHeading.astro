---
import type { Locale } from '~/lib/i18n/config';
import Breadcrumbs from '~/components/layout/Breadcrumbs.astro';
import type { Crumb } from '~/lib/breadcrumbs';

/**
 * Asymmetric page opening: the title owns the left column at h1 scale, the
 * short context sits in the right column at reading size, and one ink rule
 * closes the composition. No centred hero, no wash.
 */
interface Props {
  lang: Locale;
  title: string;
  titleLang?: string | undefined;
  intro?: string | null;
  introLang?: string | undefined;
  trail?: Crumb[];
  /** Renders the title at display scale for persuasion pages. */
  display?: boolean;
}

const { lang, title, titleLang, intro, introLang, trail, display = false } = Astro.props;
---

<section class="wrap pt-6 lg:pt-8">
  {trail && <Breadcrumbs lang={lang} trail={trail} />}
  <div class="grid items-end gap-x-10 gap-y-5 border-b border-line-ink pt-8 pb-8 lg:grid-cols-12 lg:pt-12 lg:pb-10">
    <h1
      class:list={[
        'lg:col-span-7',
        display
          ? 'text-[length:var(--text-display)] leading-[var(--text-display--line-height)] tracking-[var(--text-display--letter-spacing)]'
          : 'text-[length:var(--text-h1)] leading-[var(--text-h1--line-height)] tracking-[var(--text-h1--letter-spacing)]',
      ]}
      lang={titleLang}
    >
      {title}
    </h1>
    {
      intro && (
        <p class="max-w-[46ch] text-[length:var(--text-lead)] leading-[var(--text-lead--line-height)] text-ink-600 lg:col-span-5" lang={introLang}>
          {intro}
        </p>
      )
    }
  </div>
  <slot />
</section>
