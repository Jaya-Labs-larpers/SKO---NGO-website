---
import type { Locale } from '~/lib/i18n/config';
import type { Report } from '~/lib/content/types';
import { formatFileSize, pick, t } from '~/lib/i18n/utils';
import { hasInlineLinks } from '~/lib/inline-links';
import InlineLinks from './InlineLinks.astro';
import Icon from '~/components/Icon.astro';

interface Props {
  lang: Locale;
  reports: Report[];
  /** `navy` is the Reports page's band; `light` sits on white (Safeguarding). */
  tone?: 'navy' | 'light';
}

const { lang, reports, tone = 'navy' } = Astro.props;
const navy = tone === 'navy';

const typeLabels: Record<string, Record<Locale, string>> = {
  'annual-report': { en: 'Annual report', km: 'របាយការណ៍ប្រចាំឆ្នាំ' },
  financial: { en: 'Financial', km: 'ហិរញ្ញវត្ថុ' },
  policy: { en: 'Policy', km: 'គោលការណ៍' },
  other: { en: 'Document', km: 'ឯកសារ' },
};
---

<ol
  class:list={[
    'm-0 list-none p-0',
    navy
      ? 'mx-auto max-w-[var(--container-inner)] border-t border-[color:var(--color-line-navy)]'
      : 'rule-top',
  ]}
>
  {
    reports.map((report) => {
      const title = pick(report.title, lang);
      const summary = pick(report.summary, lang);
      // Prefer the Khmer PDF when the visitor is reading Khmer and one exists.
      const file = lang === 'km' && report.fileKm?.url ? report.fileKm : report.file;
      const fileLanguage =
        lang === 'km' && report.fileKm?.url ? t(lang, 'languageKhmer') : t(lang, 'languageEnglish');
      const typeLabel = report.type ? typeLabels[report.type]?.[lang] : null;
      const size = formatFileSize(file?.size);
      const meta = [typeLabel, fileLanguage, 'PDF', size].filter(Boolean).join(' · ');

      return (
        <li
          class:list={[
            'grid [grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr))] items-center gap-x-10 gap-y-5',
            navy ? 'border-b border-[color:var(--color-line-navy)] py-10' : 'rule-row py-9',
          ]}
        >
          {report.year && (
            <span
              class:list={['t-index', navy && '!text-[color:var(--color-sky-400)]']}
              style={navy ? 'font-size:clamp(3.41rem,5.58vw,5.58rem)' : undefined}
              aria-hidden={navy ? undefined : 'true'}
            >
              {report.year}
            </span>
          )}
          <div class="flex min-w-0 flex-col gap-2.5 md:col-span-2">
            <h2
              class:list={[
                't-h3-lg m-0',
                navy ? '!text-white' : '!text-[color:var(--color-blue-700)]',
              ]}
              lang={title.isFallback ? title.lang : undefined}
            >
              {title.value}
              {report.year ? ` (${report.year})` : ''}
            </h2>
            <p class:list={['eyebrow m-0 !text-sm', navy && '!text-[color:var(--color-on-navy)]']}>
              {meta}
            </p>
            {summary.value && hasInlineLinks(summary.value) && (
              <p
                class="inline-links m-0 text-sm text-[color:var(--color-on-navy)]"
                lang={summary.isFallback ? summary.lang : undefined}
              >
                <InlineLinks text={summary.value} />
              </p>
            )}
          </div>
          <a
            href={file?.url ?? '#'}
            download={file?.url ? '' : undefined}
            aria-disabled={file?.url ? undefined : 'true'}
            class:list={[
              'btn btn-lg justify-self-start md:justify-self-end',
              navy ? 'btn-accent' : 'btn-primary',
            ]}
          >
            <Icon name="arrow-down-tray" size={18} />
            {t(lang, 'download')}
          </a>
        </li>
      );
    })
  }
</ol>
