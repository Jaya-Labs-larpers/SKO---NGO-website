---
/**
 * A numbered list of ruled links: the programs at a glance, set beside a page's
 * title so a visitor can jump to the one they came for.
 */
import Icon from '~/components/Icon.astro';

interface Item {
  href: string;
  label: string;
  lang?: string | undefined;
}

interface Props {
  items: Item[];
  label?: string;
}

const { items, label } = Astro.props;
---

<nav aria-label={label} class="rule-top">
  <ol class="m-0 list-none p-0">
    {
      items.map((item, index) => (
        <li class="rule-row">
          <a
            href={item.href}
            lang={item.lang}
            class="grid min-h-[72px] grid-cols-[3.5rem_minmax(0,1fr)_1.5rem] items-center gap-4 text-[19px] leading-[1.3] font-semibold text-[color:var(--color-ink-900)] no-underline transition-colors hover:bg-[color:var(--color-blue-50)] hover:text-[color:var(--color-ink-900)]"
          >
            <span class="font-[family-name:var(--font-display)] text-[15px] font-bold text-[color:var(--color-blue-700)]">
              {String(index + 1).padStart(2, '0')}
            </span>
            <span>{item.label}</span>
            <Icon name="arrow-right" size={20} class="text-[color:var(--color-blue-700)]" />
          </a>
        </li>
      ))
    }
  </ol>
</nav>
