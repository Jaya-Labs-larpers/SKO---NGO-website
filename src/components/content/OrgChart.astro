---
import type { Locale } from '~/lib/i18n/config';
import type { OrgChart } from '~/lib/content/types';
import { pick, t, text } from '~/lib/i18n/utils';
import { hasImage, imageUrl } from '~/lib/sanity/image';
import ResponsiveImage from '~/components/media/ResponsiveImage.astro';
import Icon from '~/components/ui/Icon.astro';
import RichText from './RichText.astro';

interface Props {
  lang: Locale;
  chart: OrgChart;
}

const { lang, chart } = Astro.props;

const caption = pick(chart.caption, lang);
const altText = chart.image ? text(chart.image.alt, lang) : '';
const fullUrl = chart.image && hasImage(chart.image) ? imageUrl(chart.image, { width: 2400 }) : null;
---

<figure class="m-0">
  <!--
    The button has no aria-label: its accessible name comes from its own visible
    text, so the two cannot drift (WCAG 2.5.3, Label in Name). The in-page image
    is alt="" because it sits inside the button and would otherwise be swallowed
    into its name. The description lives where it is actually useful: on the
    full-size image in the dialog, and in the "read as text" panel below, which
    is the route that works at 360px anyway.
  -->
  <button type="button" id="orgchart-open" class="relative block w-full cursor-zoom-in border-0 bg-transparent p-0 text-left">
    <ResponsiveImage
      image={chart.image}
      lang={lang}
      alt=""
      aspect="16/8"
      sizes="(min-width: 64rem) 1100px, 100vw"
      placeholder="[Organizational chart]"
    />
    <span
      class="absolute right-0 bottom-0 flex items-center gap-2 border-t border-l border-line bg-canvas px-3 py-2 text-[13px] font-medium text-ink-900"
    >
      <Icon name="expand" size={14} />
      {t(lang, 'tapToEnlarge')}
    </span>
  </button>
  {
    caption.value && (
      <figcaption class="mt-3 border-t border-line pt-3 text-[13px] text-ink-400" lang={caption.isFallback ? caption.lang : undefined}>
        {caption.value}
      </figcaption>
    )
  }
</figure>

<!--
  The text version is not a substitute for the image treatment — it sits beside
  it. An image of a chart is invisible to a screen reader and unreadable at
  360px however good the zoom, and this costs one CMS field.
-->
<details class="mt-4 border-y border-line">
  <summary
    class="flex min-h-12 cursor-pointer list-none items-center justify-between gap-4 py-3 text-[15px] font-medium text-ink-900 [&::-webkit-details-marker]:hidden"
  >
    {t(lang, 'readAsText')}
    <Icon name="plus" size={16} class="disclosure-icon text-indigo-700" />
  </summary>
  <div class="pb-5">
    <RichText blocks={chart.textVersion} lang={lang} class="max-w-none text-[15px]" />
  </div>
</details>

<dialog
  id="orgchart-dialog"
  class="m-auto max-h-[92dvh] max-w-[96vw] border border-line-strong bg-canvas p-0 text-ink-900 shadow-[var(--shadow-overlay)]"
>
  <div class="flex items-center justify-between gap-4 border-b border-line px-4 py-3">
    <span class="text-[14px] font-medium">{caption.value}</span>
    <button
      type="button"
      id="orgchart-close"
      class="inline-flex min-h-10 flex-none items-center gap-2 border border-ink-900 bg-transparent px-3 text-[14px] font-medium"
    >
      {t(lang, 'closeMenu')}
      <Icon name="close" size={14} />
    </button>
  </div>
  <div class="overflow-auto p-3" style="touch-action: pinch-zoom;">
    {
      fullUrl ? (
        <img src={fullUrl} alt={altText} class="mx-auto block h-auto max-w-none" style="max-width:100%" />
      ) : (
        <div class="media-placeholder min-h-[40vh] min-w-[70vw]">[Organizational chart]</div>
      )
    }
  </div>
</dialog>

<script>
  const trigger = document.getElementById('orgchart-open') as HTMLButtonElement | null;
  const dialog = document.getElementById('orgchart-dialog') as HTMLDialogElement | null;
  const closeButton = document.getElementById('orgchart-close');

  if (trigger && dialog && closeButton) {
    trigger.addEventListener('click', () => dialog.showModal());
    closeButton.addEventListener('click', () => dialog.close());
    // Click on the backdrop closes it; clicks inside the panel do not.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    // Native <dialog> restores focus to the trigger on close.
  }
</script>
