---
/**
 * One activity as a ruled row. `list` is the Activities page (large headline,
 * lead, author); `compact` is the home page's latest item, with the date and
 * kind in a side column and a Read more link.
 */
import type { Locale } from '~/lib/i18n/config';
import type { Activity } from '~/lib/content/types';
import { formatDate, localizePath, pick, t } from '~/lib/i18n/utils';
import Icon from '~/components/Icon.astro';

interface Props {
  lang: Locale;
  activity: Activity;
  variant?: 'list' | 'compact';
}

const { lang, activity, variant = 'list' } = Astro.props;

const title = pick(activity.title, lang);
const excerpt = pick(activity.excerpt, lang);
const href = localizePath(`/activities/${activity.slug}`, lang);

const categoryLabels: Record<string, Record<Locale, string>> = {
  news: { en: 'News', km: 'ព័ត៌មាន' },
  event: { en: 'Event', km: 'ព្រឹត្តិការណ៍' },
  story: { en: 'Story', km: 'រឿងរ៉ាវ' },
  announcement: { en: 'Announcement', km: 'សេចក្តីជូនដំណឹង' },
};
const category = activity.category ? categoryLabels[activity.category]?.[lang] : null;
const compact = variant === 'compact';
---

<article
  class:list={[
    'rule-row',
    compact
      ? 'grid [grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr))] gap-x-12 gap-y-6 border-t-[3px] border-t-[color:var(--color-ink-900)] py-9'
      : 'flex flex-col gap-[18px] border-t border-t-[color:var(--color-line)] pt-8 pb-10',
  ]}
>
  <div
    class:list={['flex gap-3', compact ? 'flex-col items-start' : 'flex-wrap items-center gap-4']}
  >
    <p class="eyebrow m-0 !text-sm">
      <time datetime={activity.publishedAt ?? undefined}
        >{formatDate(activity.publishedAt, lang)}</time
      >
    </p>
    {category && <span class="chip">{category}</span>}
  </div>
  <div class:list={['flex min-w-0 flex-col gap-3.5', compact && 'md:col-span-2']}>
    <h3
      class="t-h3-lg m-0"
      style={compact
        ? undefined
        : 'font-size:calc(clamp(1.98rem,3.52vw,3.3rem)*var(--display-scale))'}
      lang={title.isFallback ? title.lang : undefined}
    >
      <a href={href} class="!text-inherit no-underline hover:underline">{title.value}</a>
    </h3>
    {
      excerpt.value && (
        <p
          class:list={['m-0 max-w-[60ch] text-[color:var(--color-ink-400)]', !compact && 'text-xl']}
          lang={excerpt.isFallback ? excerpt.lang : undefined}
        >
          {excerpt.value}
        </p>
      )
    }
    <div class="flex flex-wrap items-center gap-6">
      {
        activity.author && (
          <span class="text-[15px] text-[color:var(--color-ink-400)]">{activity.author}</span>
        )
      }
      {
        compact && (
          <a href={href} class="link-arrow !text-base">
            {t(lang, 'readMore')}
            <span class="sr-only">: {title.value}</span>
            <Icon name="arrow-right" size={16} />
          </a>
        )
      }
    </div>
  </div>
</article>
