---
/**
 * The organisation-wide figures. `lead` is the home page's navy band: the
 * largest running count set huge, the rest as a ruled list. `tiles` is the
 * Impact page's strip of four.
 */
import type { Locale } from '~/lib/i18n/config';
import type { ImpactStat } from '~/lib/content/types';
import { countsUp } from '~/lib/content/stats';
import { formatNumber, pick } from '~/lib/i18n/utils';

interface Props {
  lang: Locale;
  stats: ImpactStat[];
  variant?: 'lead' | 'tiles';
}

const { lang, stats, variant = 'lead' } = Astro.props;

const parts = (stat: ImpactStat) => {
  const prefix = pick(stat.prefix, lang);
  const suffix = pick(stat.suffix, lang);
  const display =
    stat.displayValue ?? (typeof stat.value === 'number' ? formatNumber(stat.value, lang) : '');
  return {
    stat,
    label: pick(stat.label, lang),
    context: pick(stat.context, lang),
    value: `${prefix.value ?? ''}${display}${suffix.value ?? ''}`,
  };
};

const all = stats.map(parts);
const leadStat =
  variant === 'lead' ? stats.filter(countsUp).sort((a, b) => b.value - a.value)[0] : undefined;
const lead = leadStat ? all.find((entry) => entry.stat === leadStat) : undefined;
const rest = all.filter((entry) => entry !== lead);
---

{
  variant === 'lead' && lead && (
    <div class="mx-auto grid max-w-[var(--container-inner)] [grid-template-columns:repeat(auto-fit,minmax(min(100%,440px),1fr))] items-end gap-[clamp(48px,6vw,96px)]">
      <div class="flex flex-col gap-4">
        <p class="t-figure m-0">{lead.value}</p>
        <p
          class="m-0 max-w-[22ch] text-[clamp(20px,1.8vw,26px)] leading-[1.35] font-medium"
          lang={lead.label.isFallback ? lead.label.lang : undefined}
        >
          {lead.label.value}
        </p>
      </div>
      <dl class="m-0 flex flex-col">
        {rest.map((entry, index) => (
          <div
            class:list={[
              'grid grid-cols-[minmax(0,7rem)_minmax(0,1fr)] items-baseline gap-4 border-t border-[color:var(--color-line-navy)] py-5 sm:grid-cols-[minmax(0,200px)_minmax(0,1fr)] sm:gap-6 sm:py-6',
              index === rest.length - 1 && 'border-b',
            ]}
          >
            <dd class="t-numeral -order-1 m-0">{entry.value}</dd>
            <dt
              class="flex flex-col gap-1 text-base leading-[1.35] font-semibold sm:text-[19px]"
              lang={entry.label.isFallback ? entry.label.lang : undefined}
            >
              {entry.label.value}
              {entry.context.value && (
                <span
                  class="text-[13px] font-normal text-[color:var(--color-on-navy)] sm:text-sm"
                  lang={entry.context.isFallback ? entry.context.lang : undefined}
                >
                  {entry.context.value}
                </span>
              )}
            </dt>
          </div>
        ))}
      </dl>
    </div>
  )
}

{
  variant === 'tiles' && all.length > 0 && (
    <dl class="m-0 grid [grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr))] gap-x-8 gap-y-10">
      {all.map((entry) => (
        <div class="flex flex-col gap-3 border-t-[3px] border-[color:var(--color-blue-750)] pt-5">
          <dd class="t-numeral -order-1 m-0 !text-[length:clamp(3.1rem,4.96vw,4.96rem)] !leading-[0.95]">
            {entry.value}
          </dd>
          <dt
            class="flex flex-col gap-1 text-[19px] leading-[1.3] font-bold"
            lang={entry.label.isFallback ? entry.label.lang : undefined}
          >
            {entry.label.value}
            {entry.context.value && (
              <span
                class="text-[15px] font-normal"
                lang={entry.context.isFallback ? entry.context.lang : undefined}
              >
                {entry.context.value}
              </span>
            )}
          </dt>
        </div>
      ))}
    </dl>
  )
}
