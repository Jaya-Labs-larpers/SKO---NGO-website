---
import type { Locale } from '~/lib/i18n/config';
import type { ImpactStat } from '~/lib/content/types';
import { formatNumber, pick } from '~/lib/i18n/utils';

interface Props {
  lang: Locale;
  stats: ImpactStat[];
  columns?: 3 | 4;
}

const { lang, stats, columns = 4 } = Astro.props;

/**
 * No count-up animation. A figure that animates on scroll reads as marketing;
 * a figure that is simply there when the section arrives reads as a fact.
 */
---

{
  stats.length > 0 && (
    <div
      class:list={[
        'grid overflow-hidden rounded-[var(--radius-lg)] border border-[color:var(--color-line)] bg-white',
        'grid-cols-1 sm:grid-cols-2',
        columns === 4 ? 'lg:grid-cols-4' : 'lg:grid-cols-3',
      ]}
    >
      {stats.map((stat) => {
        const label = pick(stat.label, lang);
        const context = pick(stat.context, lang);
        const suffix = pick(stat.suffix, lang);
        const display =
          stat.displayValue ?? (typeof stat.value === 'number' ? formatNumber(stat.value, lang) : '');
        return (
          <div class="border-b border-[color:var(--color-line)] px-6 py-7 last:border-b-0 sm:[&:nth-last-child(-n+2)]:border-b-0 sm:odd:border-r sm:odd:border-[color:var(--color-line)] lg:border-r lg:border-b-0 lg:last:border-r-0">
            <b class="block text-[length:var(--text-stat)] leading-none font-bold tracking-[var(--text-stat--letter-spacing)] text-[color:var(--color-blue-700)] tabular-nums">
              {display}
              {suffix.value && <span class="text-[0.6em]">{suffix.value}</span>}
            </b>
            <span
              class="mt-3 block text-[15px] font-semibold text-[color:var(--color-ink-900)]"
              lang={label.isFallback ? label.lang : undefined}
            >
              {label.value}
            </span>
            {context.value && (
              <span
                class="mt-1.5 block text-[13px] leading-[1.5] text-[color:var(--color-ink-400)]"
                lang={context.isFallback ? context.lang : undefined}
              >
                {context.value}
              </span>
            )}
          </div>
        );
      })}
    </div>
  )
}
