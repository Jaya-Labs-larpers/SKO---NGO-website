---
import type { Locale } from '~/lib/i18n/config';
import type { Partner } from '~/lib/content/types';
import { hasImage } from '~/lib/sanity/image';
import { label, partnerCategoryLabels } from '~/lib/labels';
import ResponsiveImage from '~/components/media/ResponsiveImage.astro';
import Icon from '~/components/ui/Icon.astro';

/**
 * A quiet institutional index: one ruled row per partner with its mark at
 * a fixed small size, its name, and its category. No cards, no orphan cells.
 */
interface Props {
  lang: Locale;
  partners: Partner[];
  /** Hide the category column when the list is already grouped by it. */
  categories?: boolean;
}

const { lang, partners, categories = true } = Astro.props;
const anyLogo = partners.some((partner) => hasImage(partner.logo));
---

<ul class="list-none border-b border-line p-0">
  {
    partners.map((partner) => {
      const Tag = partner.url ? 'a' : 'div';
      const logo = hasImage(partner.logo);
      const category = label(partnerCategoryLabels, partner.category, lang);
      return (
        <li>
          <Tag
            {...(partner.url ? { href: partner.url, rel: 'noopener noreferrer', target: '_blank' } : {})}
            class:list={[
              'grid min-h-14 items-center gap-x-5 gap-y-1 border-t border-line py-3 text-ink-900 no-underline transition-colors',
              anyLogo ? 'grid-cols-[3.5rem_minmax(0,1fr)_auto]' : 'grid-cols-[minmax(0,1fr)_auto]',
              partner.url && 'row-link py-3',
            ]}
          >
            {anyLogo && (
              <span class="flex h-10 w-14 items-center justify-center">
                {logo && (
                  <span class="block w-full [&_img]:h-10 [&_img]:w-full [&_img]:object-contain">
                    <ResponsiveImage image={partner.logo} lang={lang} alt="" aspect="5/3" sizes="56px" />
                  </span>
                )}
              </span>
            )}
            <span class="min-w-0">
              <span class="block text-[15px] leading-[1.35] font-medium">{partner.name}</span>
              {categories && category && <span class="mono mt-0.5 block">{category}</span>}
            </span>
            {partner.url ? <Icon name="arrow-up-right" size={16} class="row-arrow" /> : <span />}
          </Tag>
        </li>
      );
    })
  }
</ul>
