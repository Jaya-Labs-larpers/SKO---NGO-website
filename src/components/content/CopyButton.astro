---
import type { Locale } from '~/lib/i18n/config';
import { t } from '~/lib/i18n/utils';
import Icon from '~/components/Icon.astro';

interface Props {
  lang: Locale;
  value: string;
}

const { lang, value } = Astro.props;
---

{/* Ships hidden: public/donate.js reveals it, so a page without script shows no dead button. */}
<button
  type="button"
  hidden
  class="flex min-h-9 flex-none items-center gap-1.5 rounded-[var(--radius-md)] border border-[color:var(--color-line-strong)] bg-white px-2.5 font-sans text-[13px] font-semibold tracking-normal text-[color:var(--color-blue-700)]"
  data-copy={value}
  data-copy-label={t(lang, 'copy')}
  data-copied-label={t(lang, 'copied')}
>
  <Icon name="document-duplicate" size={16} />
  <span data-copy-text>{t(lang, 'copy')}</span>
</button>
