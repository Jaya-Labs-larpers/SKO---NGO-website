---
import type { Locale } from '~/lib/i18n/config';
import type { Program } from '~/lib/content/types';
import { localizePath, pick } from '~/lib/i18n/utils';
import Icon from '~/components/ui/Icon.astro';

/**
 * The programmes as a numbered ledger. The number is the index the homepage
 * strip and the programmes page share, so a reader can match them.
 */
interface Props {
  lang: Locale;
  programs: Program[];
  summaries?: boolean;
}

const { lang, programs, summaries = true } = Astro.props;
---

<ol class="list-none border-b border-line p-0">
  {
    programs.map((program, index) => {
      const title = pick(program.title, lang);
      const summary = pick(program.summary, lang);
      return (
        <li>
          <a
            href={localizePath(`/programs/${program.slug}`, lang)}
            class="row-link grid-cols-[2.5rem_minmax(0,1fr)_auto] sm:grid-cols-[3.5rem_minmax(0,1fr)_auto]"
          >
            <span class="mono mono-lg text-terracotta-700" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            <span class="min-w-0">
              <span
                class="block text-[length:var(--text-h3)] leading-[var(--text-h3--line-height)] font-semibold tracking-[var(--text-h3--letter-spacing)]"
                lang={title.isFallback ? title.lang : undefined}
              >
                {title.value}
              </span>
              {summaries && summary.value && (
                <span
                  class="mt-1.5 block max-w-[62ch] text-[15px] leading-[1.55] text-ink-600"
                  lang={summary.isFallback ? summary.lang : undefined}
                >
                  {summary.value}
                </span>
              )}
            </span>
            <Icon name="arrow-right" size={18} class="row-arrow self-center" />
          </a>
        </li>
      );
    })
  }
</ol>
