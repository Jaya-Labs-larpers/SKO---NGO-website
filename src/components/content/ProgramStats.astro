---
/**
 * A programme's results on its navy band: the first figure set huge, the rest
 * beside it. Percentages become bars; anything else a ruled figure.
 */
import type { Locale } from '~/lib/i18n/config';
import type { ImpactStat } from '~/lib/content/types';
import { formatNumber, pick } from '~/lib/i18n/utils';

interface Props {
  lang: Locale;
  stats: ImpactStat[];
}

const { lang, stats } = Astro.props;

const entries = stats.map((stat) => {
  const prefix = pick(stat.prefix, lang);
  const suffix = pick(stat.suffix, lang);
  const display =
    stat.displayValue ?? (typeof stat.value === 'number' ? formatNumber(stat.value, lang) : '');
  const value = `${prefix.value ?? ''}${display}${suffix.value ?? ''}`;
  return {
    stat,
    value,
    label: pick(stat.label, lang),
    context: pick(stat.context, lang),
    percent: /^\d{1,3}\s*%$/.test(value.trim()) ? Math.min(100, parseInt(value, 10)) : null,
  };
});
const [lead, ...rest] = entries;
const bars = rest.length > 0 && rest.every((entry) => entry.percent !== null);
---

{
  lead && (
    <div class="mx-auto grid max-w-[var(--container-inner)] [grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr))] items-start gap-12 gap-x-[clamp(48px,6vw,96px)]">
      <div class="flex flex-col gap-3">
        <p class="t-figure m-0" style="font-size:clamp(5.425rem,9.92vw,9.3rem)">
          {lead.value}
        </p>
        <p
          class="m-0 flex flex-col gap-1.5 text-2xl leading-[1.3] font-semibold"
          lang={lead.label.isFallback ? lead.label.lang : undefined}
        >
          {lead.label.value}
          {lead.context.value && (
            <span
              class="text-[17px] font-normal text-[color:var(--color-on-navy)]"
              lang={lead.context.isFallback ? lead.context.lang : undefined}
            >
              {lead.context.value}
            </span>
          )}
        </p>
      </div>
      {bars ? (
        <dl class="m-0 flex flex-col gap-7">
          {rest.map((entry) => (
            <div class="flex flex-col gap-2.5">
              <div class="flex items-baseline gap-5">
                <dd class="t-numeral -order-1 m-0 w-28 flex-none !text-[2.45rem]">{entry.value}</dd>
                <dt
                  class="text-lg leading-[1.35] font-medium"
                  lang={entry.label.isFallback ? entry.label.lang : undefined}
                >
                  {entry.label.value}
                </dt>
              </div>
              <div aria-hidden="true" class="h-2.5 rounded-sm bg-[rgb(198_219_247/0.18)]">
                <div
                  class="h-2.5 rounded-sm bg-[color:var(--color-blue-200)]"
                  style={`width:${entry.percent}%`}
                />
              </div>
            </div>
          ))}
        </dl>
      ) : (
        rest.length > 0 && (
          <dl class="m-0 grid [grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr))] gap-x-8 gap-y-9">
            {rest.map((entry) => (
              <div class="flex flex-col gap-2.5 border-t border-[color:var(--color-line-navy)] pt-5">
                <dd class="t-numeral -order-1 m-0 !text-[length:clamp(2.275rem,3.5vw,3.325rem)]">
                  {entry.value}
                </dd>
                <dt
                  class="flex flex-col gap-1 text-lg leading-[1.35] font-semibold"
                  lang={entry.label.isFallback ? entry.label.lang : undefined}
                >
                  {entry.label.value}
                  {entry.context.value && (
                    <span
                      class="text-[15px] font-normal text-[color:var(--color-on-navy)]"
                      lang={entry.context.isFallback ? entry.context.lang : undefined}
                    >
                      {entry.context.value}
                    </span>
                  )}
                </dt>
              </div>
            ))}
          </dl>
        )
      )}
    </div>
  )
}
