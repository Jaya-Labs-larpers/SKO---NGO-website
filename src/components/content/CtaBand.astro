---
import type { Locale } from '~/lib/i18n/config';
import { localizePath, t } from '~/lib/i18n/utils';

interface Props {
  lang: Locale;
  title: string;
  body?: string;
}

const { lang, title, body } = Astro.props;
---

<section class="pb-[var(--spacing-section)]">
  <div class="wrap">
    <div
      class="reveal on-inverse flex flex-wrap items-center justify-between gap-7 rounded-[var(--radius-xl)] bg-[color:var(--color-blue-900)] px-6 py-8 text-white sm:gap-9 sm:px-12 sm:py-13"
    >
      <div>
        <h2
          class="max-w-[22ch] text-[length:var(--text-h2)] leading-[1.2] tracking-[-0.02em] text-white sm:text-[30px]"
        >
          {title}
        </h2>
        {
          body && (
            <p class="mt-3 max-w-[46ch] text-[15.5px] text-white/78 sm:text-[16.5px]">{body}</p>
          )
        }
      </div>
      <div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row sm:flex-wrap">
        <a href={localizePath('/contact', lang)} class="btn btn-inverse">{t(lang, 'contactUs')}</a>
        <a href={localizePath('/reports', lang)} class="btn btn-inverse-outline"
          >{t(lang, 'seeReports')}</a
        >
      </div>
    </div>
  </div>
</section>
