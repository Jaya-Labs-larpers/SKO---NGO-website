---
import type { Locale } from '~/lib/i18n/config';
import type { Activity } from '~/lib/content/types';
import { formatDate, localizePath, pick, t } from '~/lib/i18n/utils';
import { activityCategoryLabels, label } from '~/lib/labels';
import ResponsiveImage from '~/components/media/ResponsiveImage.astro';
import Icon from '~/components/ui/Icon.astro';

/**
 * Image-led editorial entry for the activities index: photograph on the
 * left, dated metadata and title on the right, one rule between entries.
 */
interface Props {
  lang: Locale;
  activity: Activity;
  eager?: boolean;
}

const { lang, activity, eager = false } = Astro.props;

const title = pick(activity.title, lang);
const excerpt = pick(activity.excerpt, lang);
const category = label(activityCategoryLabels, activity.category, lang);
const href = localizePath(`/activities/${activity.slug}`, lang);
---

<article class="relative grid gap-5 border-t border-line py-7 md:grid-cols-12 md:gap-8 lg:py-9">
  <div class="md:col-span-5 lg:col-span-4">
    <ResponsiveImage
      image={activity.coverImage}
      lang={lang}
      alt=""
      aspect="4/3"
      eager={eager}
      sizes="(min-width: 64rem) 400px, (min-width: 48rem) 42vw, 100vw"
    />
  </div>
  <div class="md:col-span-7 lg:col-span-8 lg:grid lg:grid-cols-[10rem_minmax(0,1fr)] lg:gap-8">
    <p class="mono flex flex-wrap gap-x-2 lg:block">
      <time datetime={activity.publishedAt ?? undefined} class="block">{formatDate(activity.publishedAt, lang)}</time>
      {category && <span class="block text-terracotta-700">{category}</span>}
      {activity.author && <span class="block normal-case">{activity.author}</span>}
    </p>
    <div class="mt-3 lg:mt-0">
      <h2
        class="text-[length:var(--text-h2)] leading-[var(--text-h2--line-height)] tracking-[var(--text-h2--letter-spacing)]"
        lang={title.isFallback ? title.lang : undefined}
      >
        <a href={href} class="text-inherit no-underline before:absolute before:inset-0 before:content-['']">
          {title.value}
        </a>
      </h2>
      {
        excerpt.value && (
          <p class="mt-3 max-w-[60ch] text-ink-600" lang={excerpt.isFallback ? excerpt.lang : undefined}>
            {excerpt.value}
          </p>
        )
      }
      <span class="link mt-4 text-[15px]">
        {t(lang, 'readMore')}
        <Icon name="arrow-right" size={14} />
      </span>
    </div>
  </div>
</article>
