---
interface Props {
  title: string;
  titleLang?: string | undefined;
  intro?: string | null;
  introLang?: string | undefined;
  as?: 'h2' | 'h3';
  id?: string;
}

const { title, titleLang, intro, introLang, as: Tag = 'h2', id }: Props = Astro.props;
---

<div class="max-w-[40rem]">
  <Tag
    id={id}
    class="text-[length:var(--text-h2)] leading-[var(--text-h2--line-height)] tracking-[var(--text-h2--letter-spacing)] scroll-mt-24"
    lang={titleLang}
  >
    {title}
  </Tag>
  {
    intro && (
      <p class="mt-3 text-ink-600" lang={introLang}>
        {intro}
      </p>
    )
  }
</div>
