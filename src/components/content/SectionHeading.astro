---
interface Props {
  title: string;
  intro?: string | null;
  introLang?: string | undefined;
  as?: 'h2' | 'h3';
  size?: 'xl' | 'lg' | 'md' | 'sm' | 'xs';
  id?: string;
}

const { title, intro, introLang, as: Tag = 'h2', size = 'sm', id }: Props = Astro.props;
---

<div class="flex flex-col gap-4">
  <Tag id={id} class={`t-${size} m-0`}>{title}</Tag>
  {
    intro && (
      <p class="t-lead-sm m-0 max-w-[58ch] text-[color:var(--color-ink-400)]" lang={introLang}>
        {intro}
      </p>
    )
  }
</div>
