---
/**
 * One program as a full-width photograph with its account on a card laid over
 * it, alternating sides and colours down the page.
 */
import type { Locale } from '~/lib/i18n/config';
import type { Program } from '~/lib/content/types';
import { localizePath, pick, t } from '~/lib/i18n/utils';
import ResponsiveImage from '~/components/media/ResponsiveImage.astro';
import Icon from '~/components/Icon.astro';

interface Props {
  lang: Locale;
  program: Program;
  index: number;
}

const { lang, program, index } = Astro.props;

const title = pick(program.title, lang);
const summary = pick(program.summary, lang);
const flip = index % 2 === 1;
---

<article
  id={program.slug}
  class="grid scroll-mt-[calc(var(--header-offset)+1rem)] bg-[color:var(--color-blue-900)]"
>
  <div class="h-[clamp(560px,52vw,760px)] [grid-area:1/1] [&_img]:h-full">
    <ResponsiveImage
      image={program.image ?? program.cardImage}
      lang={lang}
      alt=""
      aspect="16/9"
      sizes="100vw"
    />
  </div>
  <div
    class:list={[
      'm-[clamp(16px,4vw,64px)] flex max-w-[600px] flex-col items-start gap-[18px] self-end p-[clamp(28px,3vw,48px)] [grid-area:1/1]',
      flip
        ? 'justify-self-end bg-white text-[color:var(--color-ink-900)]'
        : 'on-navy justify-self-start bg-[color:var(--color-blue-900)] text-white',
    ]}
  >
    <span
      aria-hidden="true"
      class:list={['t-index', !flip && '!text-[color:var(--color-sky-400)]']}
    >
      {String(index + 1).padStart(2, '0')}
    </span>
    <h3
      class:list={['t-h3-lg m-0', flip ? '' : '!text-white']}
      lang={title.isFallback ? title.lang : undefined}
    >
      {title.value}
    </h3>
    {
      summary.value && (
        <p
          class:list={[
            'm-0',
            flip ? 'text-[color:var(--color-ink-400)]' : 'text-[color:var(--color-on-navy)]',
          ]}
          lang={summary.isFallback ? summary.lang : undefined}
        >
          {summary.value}
        </p>
      )
    }
    <a
      href={localizePath(`/programs/${program.slug}`, lang)}
      class:list={['btn', flip ? 'btn-primary' : 'btn-accent']}
      aria-label={`${t(lang, 'learnMore')}: ${title.value ?? ''}`}
    >
      {t(lang, 'learnMore')}<Icon name="arrow-right" size={18} />
    </a>
  </div>
</article>
