---
import type { Locale } from '~/lib/i18n/config';
import type { CmsImage } from '~/lib/content/types';
import type { DeferStrategy } from '~/lib/lazy';
import { text } from '~/lib/i18n/utils';
import { hasImage, imageDimensions, imageSrcSet, imageUrl } from '~/lib/sanity/image';

interface Props {
  image?: CmsImage | null;
  lang: Locale;
  /** Overrides the CMS alt text. Pass "" only for genuinely decorative images. */
  alt?: string;
  sizes?: string;
  /** CSS aspect-ratio, e.g. "3/2". Reserves the box so CLS stays at zero. */
  aspect?: string;
  /** Above-the-fold images only — skips lazy loading and raises priority. */
  eager?: boolean;
  /**
   * Hold the bytes back until JavaScript says so, for the cases where
   * `loading="lazy"` would fetch anyway: an image stacked inside the viewport
   * but not yet shown ('idle'), one far enough down that the browser's own
   * threshold is too eager ('visible'), or one behind a control that may never
   * be used ('manual' — the owning component calls loadDeferredImage).
   * Ignored when `eager` is set. No-JS visitors get the plain image.
   */
  defer?: DeferStrategy | false;
  /**
   * Blur-up placeholder while the photo loads. Off for images with transparent
   * areas (logos), where the blurred LQIP would show through.
   */
  blurUp?: boolean;
  class?: string;
}

const {
  image,
  lang,
  alt,
  sizes = '(min-width: 64rem) 33vw, (min-width: 40rem) 50vw, 100vw',
  aspect = '3/2',
  eager = false,
  defer = false,
  blurUp = true,
  class: className = '',
} = Astro.props;

/**
 * A missing image reserves its box and says nothing. It used to print
 * "[PLACEHOLDER PHOTO]" — a note to the team that a visitor was never meant to
 * read. The box still holds the space so layout and CLS do not change when the
 * real photograph lands, and it is hidden from assistive tech, which has no use
 * for an image that does not exist.
 */
const present = hasImage(image);
const altText = alt ?? (image ? text(image.alt, lang) : '');
const { width, height } = imageDimensions(image);
const src = present && image ? imageUrl(image, { width: 1200 }) : null;
const srcset = present && image ? imageSrcSet(image) : null;
const lqip = image?.lqip ?? null;

const deferred = defer && !eager ? defer : null;
const imageClass = ['block w-full h-full object-cover', className];
/**
 * Eager images are the LCP and must paint the moment they arrive, so they keep
 * the plain LQIP background and never fade. Everything else is blur-up: the
 * LQIP, blurred, fills the frame until the photo loads and fades in over it
 * (see .blur-up in global.css and revealWhenLoaded in ~/lib/lazy).
 */
const lqipStyle = lqip
  ? `background-image:url(${lqip});background-size:cover;background-position:center`
  : undefined;
const frameStyle = lqip ? `--lqip:url(${lqip})` : undefined;
---

{
  present && src ? (
    eager || !blurUp ? (
      <img
        src={src}
        srcset={srcset ?? undefined}
        sizes={sizes}
        width={width}
        height={height}
        alt={altText}
        loading={eager ? 'eager' : 'lazy'}
        decoding={eager ? 'sync' : 'async'}
        fetchpriority={eager ? 'high' : undefined}
        class:list={imageClass}
        style={eager ? lqipStyle : undefined}
      />
    ) : (
      <span class="blur-up" data-blur-up style={frameStyle}>
        {deferred ? (
          <>
            <img
              data-lazy={deferred}
              data-lazy-src={src}
              data-lazy-srcset={srcset ?? undefined}
              sizes={sizes}
              width={width}
              height={height}
              alt={altText}
              loading="lazy"
              decoding="async"
              class:list={imageClass}
            />
            <noscript>
              <img
                src={src}
                srcset={srcset ?? undefined}
                sizes={sizes}
                width={width}
                height={height}
                alt={altText}
                loading="lazy"
                decoding="async"
                class:list={imageClass}
              />
            </noscript>
          </>
        ) : (
          <img
            src={src}
            srcset={srcset ?? undefined}
            sizes={sizes}
            width={width}
            height={height}
            alt={altText}
            loading="lazy"
            decoding="async"
            class:list={imageClass}
          />
        )}
      </span>
    )
  ) : (
    <div
      class:list={['media-placeholder w-full h-full', className]}
      style={`aspect-ratio:${aspect}`}
      aria-hidden="true"
    />
  )
}

<script>
  import { hydrateDeferredImages, revealWhenLoaded } from '~/lib/lazy';

  revealWhenLoaded();
  hydrateDeferredImages();
</script>
