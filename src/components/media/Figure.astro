---
import type { Locale } from '~/lib/i18n/config';
import type { CmsImage } from '~/lib/content/types';
import { pick } from '~/lib/i18n/utils';
import ResponsiveImage from './ResponsiveImage.astro';

/**
 * An editorial photograph with its caption line. The caption comes from the
 * CMS image; a photograph without one still gets the ruled caption slot so
 * the frame reads as published, not dropped in.
 */
interface Props {
  image?: CmsImage | null;
  lang: Locale;
  aspect?: string;
  sizes?: string;
  eager?: boolean;
  placeholder?: string;
  class?: string;
}

const { image, lang, aspect = '4/3', sizes, eager = false, placeholder, class: className = '' } = Astro.props;
const caption = pick(image?.caption, lang);
---

<figure class:list={['m-0', className]}>
  <ResponsiveImage
    image={image}
    lang={lang}
    aspect={aspect}
    sizes={sizes}
    eager={eager}
    placeholder={placeholder}
  />
  {
    caption.value && (
      <figcaption class="mt-3 border-t border-line pt-3 text-[13px] leading-[1.5] text-ink-400" lang={caption.isFallback ? caption.lang : undefined}>
        {caption.value}
      </figcaption>
    )
  }
</figure>
