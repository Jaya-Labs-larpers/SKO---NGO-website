---
/**
 * The butterfly from the SKO logo, drawn large and alone, gliding over the
 * hero. On wide screens it keeps to the open space beside the card; where the
 * field is a band above the card it hovers in the middle of it.
 *
 * It is an inline SVG rather than a canvas so it can carry the `butterfly`
 * view-transition name: leaving the home page, it flies down into the perch
 * every other page keeps for it (ButterflyPerch), and flies back up on return.
 *
 * Its resting place is pure CSS (.butterfly-home in global.css), so a page
 * arriving by view transition already has it in place before any script runs.
 * Motion comes from ~/lib/butterflies/swarm as a swarm of one — the same
 * deterministic simulation the Remotion project in /video renders — and is
 * applied as a transform on top of that resting place.
 *
 * Hovering over the field draws the butterfly into a slow circle around the
 * cursor; move away and it glides home. The pointer is read from the nearest
 * [data-butterfly-host] ancestor (the hero section), so the field itself never
 * intercepts clicks. Hovering the card ([data-butterfly-shelter]) counts as
 * leaving the field.
 *
 * Under prefers-reduced-motion one settled frame is shown and nothing moves.
 * The loop also stops while the field is off screen or the tab is hidden.
 */
import ButterflyGlyph from './ButterflyGlyph.astro';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class:list={['butterfly-field', className]} aria-hidden="true">
  <div class="butterfly-home">
    <ButterflyGlyph class="butterfly-flyer" />
  </div>
</div>

<script>
  import { whenIdle } from '~/lib/lazy';
  import {
    createSwarm,
    resizeSwarm,
    stepSwarm,
    type Pointer,
    type Swarm,
    type SwarmOptions,
  } from '~/lib/butterflies/swarm';

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  /** A metered connection is treated like reduced motion: one still frame. */
  const saveData =
    (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;

  const SOLO: Partial<SwarmOptions> = {
    minCount: 1,
    maxCount: 1,
    // A big wing beats slowly; a small one's 2–3 Hz reads as a flutter here.
    minFlapHz: 0.9,
    maxFlapHz: 1.2,
    gatherRadius: 420,
    releaseRadius: 560,
    // Circles the cursor rather than landing on it.
    minRingRadius: 120,
    maxRingRadius: 170,
  };
  /** How far the wings close on each beat, as a fraction of their span. */
  const FLAP_MIN = 0.4;

  function mount(field: HTMLElement) {
    const home = field.querySelector<HTMLElement>('.butterfly-home');
    const flyer = field.querySelector<SVGSVGElement>('.butterfly-flyer');
    const wings = flyer?.querySelector<SVGGElement>('.butterfly-wings');
    if (!home || !flyer || !wings) return;
    // Rebound as consts so the closures below see them as non-null.
    const homeEl: HTMLElement = home;
    const flyerEl: SVGSVGElement = flyer;
    const wingsEl: SVGGElement = wings;

    const host = field.closest<HTMLElement>('[data-butterfly-host]') ?? field;

    let swarm: Swarm | null = null;
    let homeX = 0;
    let homeY = 0;
    let pointer: Pointer | null = null;
    let raf = 0;
    let last = 0;
    let visible = true;

    function fit() {
      const bounds = field.getBoundingClientRect();
      const width = Math.max(1, Math.round(bounds.width));
      const height = Math.max(1, Math.round(bounds.height));
      const spot = homeEl.getBoundingClientRect();
      homeX = spot.left - bounds.left;
      homeY = spot.top - bounds.top;
      const span = parseFloat(getComputedStyle(flyerEl).width) || 200;

      const fresh = !swarm;
      if (swarm) resizeSwarm(swarm, width, height);
      else swarm = createSwarm(width, height, SOLO);

      const butterfly = swarm.butterflies[0]!;
      butterfly.hx = homeX / width;
      butterfly.hy = homeY / height;
      // The simulation keeps a butterfly `size` px from each wall, so half the
      // span keeps the wingtips inside the field without pushing it off its spot.
      butterfly.size = span / 2;
      butterfly.drift = span * 0.25;
      if (fresh) {
        butterfly.x = homeX;
        butterfly.y = homeY;
      }
    }

    function render() {
      const butterfly = swarm?.butterflies[0];
      if (!butterfly) return;
      flyerEl.style.transform = `translate(${butterfly.x - homeX}px, ${butterfly.y - homeY}px) rotate(${butterfly.tilt}rad)`;
      const flap = 1 - (1 - FLAP_MIN) * (0.5 - 0.5 * Math.cos(butterfly.phase));
      wingsEl.style.transform = `scaleX(${flap})`;
    }

    function frame(now: number) {
      raf = 0;
      if (!swarm) return;
      // Clamp so a background tab coming back does not lurch.
      const dt = Math.min(0.05, last ? (now - last) / 1000 : 1 / 60);
      last = now;
      stepSwarm(swarm, dt, pointer);
      render();
      if (running()) raf = requestAnimationFrame(frame);
    }

    function running() {
      return visible && !document.hidden && !reducedMotion.matches && !saveData;
    }

    function start() {
      if (raf || !running()) return;
      last = 0;
      raf = requestAnimationFrame(frame);
    }

    function stop() {
      if (raf) cancelAnimationFrame(raf);
      raf = 0;
    }

    /** Without motion, show the butterfly settled at home. */
    function still() {
      if (!swarm) return;
      for (let i = 0; i < 90; i++) stepSwarm(swarm, 1 / 60, null);
      render();
    }

    function toField(event: PointerEvent): Pointer {
      const rect = field.getBoundingClientRect();
      return { x: event.clientX - rect.left, y: event.clientY - rect.top };
    }

    function sheltered(event: PointerEvent): boolean {
      const target = event.target;
      return target instanceof Element && target.closest('[data-butterfly-shelter]') !== null;
    }

    const passive = { passive: true } as const;
    host.addEventListener(
      'pointermove',
      (event) => {
        pointer = sheltered(event) ? null : toField(event);
      },
      passive,
    );
    host.addEventListener(
      'pointerdown',
      (event) => {
        pointer = sheltered(event) ? null : toField(event);
      },
      passive,
    );
    host.addEventListener('pointerleave', () => (pointer = null), passive);
    host.addEventListener('pointercancel', () => (pointer = null), passive);
    host.addEventListener(
      'pointerup',
      (event) => {
        // A finger lifting off is the touch equivalent of the mouse leaving.
        if (event.pointerType !== 'mouse') pointer = null;
      },
      passive,
    );

    new ResizeObserver(() => {
      fit();
      if (!running()) still();
    }).observe(field);

    new IntersectionObserver(
      (entries) => {
        visible = entries.some((entry) => entry.isIntersecting);
        if (visible) start();
        else stop();
      },
      { rootMargin: '64px' },
    ).observe(field);

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else start();
    });

    reducedMotion.addEventListener('change', () => {
      if (reducedMotion.matches) {
        stop();
        still();
      } else {
        start();
      }
    });

    fit();
    if (running()) start();
    else still();
  }

  /* The hero card is the page's largest paint and should never wait on this.
     Mounting is deferred to the browser's first idle moment; until then the
     butterfly simply rests where the CSS puts it. */
  whenIdle(() => {
    document.querySelectorAll<HTMLElement>('.butterfly-field').forEach(mount);
  });
</script>

<style>
  .butterfly-field {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }
</style>
