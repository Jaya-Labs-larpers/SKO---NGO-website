---
/**
 * The butterfly from the SKO logo, many times over and small, set loose over
 * the hero.
 *
 * A canvas fills whatever box it is placed in, so it drops into the same slot
 * as HeroSlideshow and always matches the window. The swarm itself lives in
 * ~/lib/butterflies/swarm — a deterministic simulation the Remotion project in
 * /video renders to a video with the very same code.
 *
 * Hovering over the field gathers the nearby butterflies into a loose cloud
 * around the cursor; move away and they drift home. The pointer is read from
 * the nearest [data-butterfly-host] ancestor (the hero section), so the canvas
 * itself never intercepts clicks. Hovering the card ([data-butterfly-shelter])
 * counts as leaving the field.
 *
 * Under prefers-reduced-motion one settled frame is drawn and nothing moves.
 * The loop also stops while the field is off screen or the tab is hidden.
 */
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class:list={['butterfly-field', className]} aria-hidden="true">
  <canvas class="butterfly-canvas"></canvas>
</div>

<script>
  import { whenIdle } from '~/lib/lazy';
  import {
    createSwarm,
    drawSwarm,
    resizeSwarm,
    stepSwarm,
    type Pointer,
    type Swarm,
  } from '~/lib/butterflies/swarm';

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  /** A metered connection is treated like reduced motion: one still frame. */
  const saveData =
    (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;

  /* Butterflies are small, so 1.5× is visually indistinguishable from 2× on
     a phone but clears and composites 44% fewer pixels every frame. */
  const MAX_DPR = 1.5;
  /* If frames keep taking longer than this, step and draw every other one.
     Motion stays smooth because dt doubles; the machine gets half the work. */
  const SLOW_FRAME_MS = 22;

  function mount(field: HTMLElement) {
    const maybeCanvas = field.querySelector<HTMLCanvasElement>('canvas');
    const maybeCtx = maybeCanvas?.getContext('2d', { alpha: true, desynchronized: true });
    if (!maybeCanvas || !maybeCtx) return;
    // Rebound as consts so the closures below see them as non-null.
    const canvas: HTMLCanvasElement = maybeCanvas;
    const ctx: CanvasRenderingContext2D = maybeCtx;

    const host = field.closest<HTMLElement>('[data-butterfly-host]') ?? field;

    let swarm: Swarm | null = null;
    let width = 0;
    let height = 0;
    let dpr = 1;
    let pointer: Pointer | null = null;
    let raf = 0;
    let last = 0;
    let visible = true;
    let frameCost = 0; // exponential moving average of frame time, ms
    let skipNext = false;

    function fit() {
      const rect = field.getBoundingClientRect();
      width = Math.max(1, Math.round(rect.width));
      height = Math.max(1, Math.round(rect.height));
      dpr = Math.min(MAX_DPR, window.devicePixelRatio || 1);
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;
      if (swarm) resizeSwarm(swarm, width, height);
      else swarm = createSwarm(width, height);
    }

    function render() {
      if (!swarm) return;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, width, height);
      drawSwarm(ctx, swarm, { pixelRatio: dpr });
    }

    function frame(now: number) {
      raf = 0;
      if (!swarm) return;
      if (skipNext) {
        // Half-rate mode: let this frame go by, the next one covers both.
        skipNext = false;
        if (running()) raf = requestAnimationFrame(frame);
        return;
      }
      // Clamp so a background tab coming back does not lurch.
      const dt = Math.min(0.05, last ? (now - last) / 1000 : 1 / 60);
      last = now;
      const began = performance.now();
      stepSwarm(swarm, dt, pointer);
      render();
      const cost = performance.now() - began;
      frameCost = frameCost ? frameCost * 0.9 + cost * 0.1 : cost;
      skipNext = frameCost > SLOW_FRAME_MS;
      if (running()) raf = requestAnimationFrame(frame);
    }

    function running() {
      return visible && !document.hidden && !reducedMotion.matches && !saveData;
    }

    function start() {
      if (raf || !running()) return;
      last = 0;
      raf = requestAnimationFrame(frame);
    }

    function stop() {
      if (raf) cancelAnimationFrame(raf);
      raf = 0;
    }

    /** Without motion, show the swarm already settled rather than stacked at home. */
    function still() {
      if (!swarm) return;
      for (let i = 0; i < 90; i++) stepSwarm(swarm, 1 / 60, null);
      render();
    }

    function toField(event: PointerEvent): Pointer {
      const rect = field.getBoundingClientRect();
      return { x: event.clientX - rect.left, y: event.clientY - rect.top };
    }

    function sheltered(event: PointerEvent): boolean {
      const target = event.target;
      return target instanceof Element && target.closest('[data-butterfly-shelter]') !== null;
    }

    const passive = { passive: true } as const;
    host.addEventListener(
      'pointermove',
      (event) => {
        pointer = sheltered(event) ? null : toField(event);
      },
      passive,
    );
    host.addEventListener(
      'pointerdown',
      (event) => {
        pointer = sheltered(event) ? null : toField(event);
      },
      passive,
    );
    host.addEventListener('pointerleave', () => (pointer = null), passive);
    host.addEventListener('pointercancel', () => (pointer = null), passive);
    host.addEventListener(
      'pointerup',
      (event) => {
        // A finger lifting off is the touch equivalent of the mouse leaving.
        if (event.pointerType !== 'mouse') pointer = null;
      },
      passive,
    );

    new ResizeObserver(() => {
      fit();
      if (!running()) still();
    }).observe(field);

    new IntersectionObserver(
      (entries) => {
        visible = entries.some((entry) => entry.isIntersecting);
        if (visible) start();
        else stop();
      },
      { rootMargin: '64px' },
    ).observe(field);

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else start();
    });

    reducedMotion.addEventListener('change', () => {
      if (reducedMotion.matches) {
        stop();
        still();
      } else {
        start();
      }
    });

    fit();
    if (running()) start();
    else still();
  }

  /* The hero card is the page's largest paint and should never wait on this.
     Mounting is deferred to the browser's first idle moment so the swarm
     starts just after the page is on screen rather than competing with it. */
  whenIdle(() => {
    document.querySelectorAll<HTMLElement>('.butterfly-field').forEach(mount);
  });
</script>

<style>
  .butterfly-field {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .butterfly-canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
