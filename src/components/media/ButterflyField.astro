---
/**
 * The butterfly from the SKO logo, traced from the vector logo file and set
 * loose over the hero.
 *
 * Pure CSS: each butterfly flutters its wings on a short loop and circles a
 * small orbit at constant speed, offset from its neighbours so nothing moves in
 * lockstep. Fills whatever box it is placed in, so it drops into the same slot
 * as HeroSlideshow. Placed to stay clear of the white card on desktop — the
 * card covers roughly the left half — and dropped under prefers-reduced-motion.
 */
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
