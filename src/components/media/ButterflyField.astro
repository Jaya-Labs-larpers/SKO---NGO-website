<style>
  .butterfly-field {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .butterfly {
    position: absolute;
    height: auto;
    overflow: visible;
    transform: translate(-50%, -50%);
    animation: sko-drift var(--drift) linear var(--delay) infinite;
    animation-direction: var(--dir);
    will-change: transform;
  }

  /* Each wing hinges on the body line (x = 45 in the logo's own coordinates). */
  .wing {
    transform-origin: 45px 20.5px;
    animation: sko-flap var(--flap) ease-in-out var(--delay) infinite;
  }

  /* Wings close toward the body and open again — a flutter, not a full beat. */
  @keyframes sko-flap {
    0%,
    100% {
      transform: scaleX(1);
    }
    50% {
      transform: scaleX(0.74);
    }
  }

  /* A small circle at constant speed, so the loop has no visible seam. */
  @keyframes sko-drift {
    0% { transform: translate(-50%, -50%) translate(calc(var(--r) * 0.000), calc(var(--r) * -0.000)) rotate(0.0deg); }
    12.5% { transform: translate(-50%, -50%) translate(calc(var(--r) * 0.707), calc(var(--r) * -0.293)) rotate(3.5deg); }
    25% { transform: translate(-50%, -50%) translate(calc(var(--r) * 1.000), calc(var(--r) * -1.000)) rotate(5.0deg); }
    37.5% { transform: translate(-50%, -50%) translate(calc(var(--r) * 0.707), calc(var(--r) * -1.707)) rotate(3.5deg); }
    50% { transform: translate(-50%, -50%) translate(calc(var(--r) * 0.000), calc(var(--r) * -2.000)) rotate(0.0deg); }
    62.5% { transform: translate(-50%, -50%) translate(calc(var(--r) * -0.707), calc(var(--r) * -1.707)) rotate(-3.5deg); }
    75% { transform: translate(-50%, -50%) translate(calc(var(--r) * -1.000), calc(var(--r) * -1.000)) rotate(-5.0deg); }
    87.5% { transform: translate(-50%, -50%) translate(calc(var(--r) * -0.707), calc(var(--r) * -0.293)) rotate(-3.5deg); }
    100% { transform: translate(-50%, -50%) translate(calc(var(--r) * -0.000), calc(var(--r) * -0.000)) rotate(-0.0deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .butterfly,
    .wing {
      animation: none;
    }
  }
</style>
