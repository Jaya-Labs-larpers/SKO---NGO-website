---
/**
 * The site-wide flock: three logo butterflies of one size, on a fixed layer
 * over every page. The motion lives in ~/lib/butterflies/flight.
 *
 * They belong to the window, not the page. Each flies on its own; while the
 * mouse moves they trail it, and after it has been still for IDLE_MS they
 * drift back to the edges. Scrolling carries them along the side edges.
 * Changing URL leaves every one of them exactly where it was: the flock is
 * saved on the way out and redrawn by the inline script below before the next
 * page's first paint, and each butterfly carries its own view-transition name
 * so the page swap slides content under them without touching them. The hero card ([data-butterfly-shelter]) is a
 * no-follow zone, so they never crowd its headline or buttons.
 *
 * On phones they shrink to the page gutters and simply drift there. Under
 * prefers-reduced-motion or data saver they rest in place and never move.
 */
import ButterflyGlyph from './ButterflyGlyph.astro';
---

<div class="butterfly-flock" data-pending aria-hidden="true">
  <ButterflyGlyph class="flock-bird" />
  <ButterflyGlyph class="flock-bird" />
  <ButterflyGlyph class="flock-bird" />
</div>
<script is:inline>
  // Restores the flock where the previous page left it, before first paint.
  // Reads the SavedFlock shape from ~/lib/butterflies/flight; keep in step.
  (function () {
    var layer = document.currentScript.previousElementSibling;
    try {
      var saved = JSON.parse(sessionStorage.getItem('sko-flock'));
      if (!saved || !saved.f || saved.f.length !== layer.children.length) return;
      var root = document.documentElement;
      var sx = root.clientWidth / saved.w;
      var sy = root.clientHeight / saved.h;
      saved.f.forEach(function (f, i) {
        var bird = layer.children[i];
        if (!bird) return;
        bird.style.width = f.s + 'px';
        bird.style.transform =
          'translate(' + f.x * sx + 'px,' + f.y * sy + 'px) translate(-50%,-50%) rotate(' + f.r + 'rad)';
        var wings = bird.querySelector('.butterfly-wings');
        if (wings) wings.style.transform = 'scaleX(' + f.k + ')';
      });
      layer.removeAttribute('data-pending');
    } catch (error) {}
  })();
</script>

<script>
  import {
    STORAGE_KEY,
    createFlock,
    parseSavedFlock,
    resizeFlock,
    restoreFlock,
    saveFlock,
    stepFlock,
    wingSpan,
    type Flock,
    type Pointer,
  } from '~/lib/butterflies/flight';

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  /** A metered connection is treated like reduced motion: the flock rests. */
  const saveData =
    (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;

  /** After this long without the mouse moving, they stop following and fly free. */
  const IDLE_MS = 4000;

  function viewport() {
    const root = document.documentElement;
    return { width: root.clientWidth, height: root.clientHeight };
  }

  function readSaved() {
    try {
      return parseSavedFlock(sessionStorage.getItem(STORAGE_KEY));
    } catch {
      return null;
    }
  }

  function mount(layer: HTMLElement) {
    const birds = Array.from(layer.querySelectorAll<SVGSVGElement>('.flock-bird'));
    const wings = birds.map((bird) => bird.querySelector<SVGGElement>('.butterfly-wings'));

    const saved = readSaved();
    const flock: Flock = saved ? restoreFlock(saved, viewport()) : createFlock(viewport());

    let pointer: Pointer | null = null;
    let pointerMovedAt = 0;
    let lastScroll = window.scrollY;
    let raf = 0;
    let last = 0;

    function render() {
      flock.flyers.forEach((flyer, i) => {
        const bird = birds[i];
        if (!bird) return;
        bird.style.width = `${flyer.size}px`;
        bird.style.transform = `translate(${flyer.x}px, ${flyer.y}px) translate(-50%, -50%) rotate(${flyer.tilt}rad)`;
        const wing = wings[i];
        if (wing) wing.style.transform = `scaleX(${wingSpan(flyer)})`;
      });
    }

    function running() {
      return !document.hidden && !reducedMotion.matches && !saveData;
    }

    function frame(now: number) {
      raf = 0;
      // Clamp so a tab coming back from the background does not lurch.
      const dt = Math.min(0.05, last ? (now - last) / 1000 : 1 / 60);
      last = now;
      const scroll = window.scrollY;
      const company = pointer && now - pointerMovedAt < IDLE_MS ? pointer : null;
      stepFlock(flock, dt, { pointer: company, scrolled: scroll - lastScroll });
      lastScroll = scroll;
      render();
      if (running()) raf = requestAnimationFrame(frame);
    }

    function start() {
      if (raf || !running()) return;
      last = 0;
      lastScroll = window.scrollY;
      raf = requestAnimationFrame(frame);
    }

    function stop() {
      if (raf) cancelAnimationFrame(raf);
      raf = 0;
    }

    function save() {
      try {
        sessionStorage.setItem(STORAGE_KEY, JSON.stringify(saveFlock(flock)));
      } catch {
        // Private mode or a full quota: the next page simply starts fresh.
      }
    }

    const passive = { passive: true } as const;
    window.addEventListener(
      'pointermove',
      (event) => {
        if (event.pointerType === 'touch') return;
        const target = event.target;
        const sheltered = target instanceof Element && target.closest('[data-butterfly-shelter]') !== null;
        pointer = sheltered ? null : { x: event.clientX, y: event.clientY };
        pointerMovedAt = event.timeStamp;
      },
      passive,
    );
    document.documentElement.addEventListener('mouseleave', () => (pointer = null), passive);
    window.addEventListener('blur', () => (pointer = null));

    window.addEventListener('resize', () => {
      resizeFlock(flock, viewport());
      if (!running()) render();
    });
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else start();
    });
    reducedMotion.addEventListener('change', () => {
      if (reducedMotion.matches) stop();
      else start();
    });

    // pageswap fires before the view transition captures this page; pagehide
    // covers browsers without it.
    window.addEventListener('pageswap', save);
    window.addEventListener('pagehide', save);

    render();
    if (layer.hasAttribute('data-pending')) {
      // First page of the visit: nothing to restore, so the flock fades in.
      layer.setAttribute('data-arriving', '');
      layer.removeAttribute('data-pending');
    }
    start();
  }

  const layer = document.querySelector<HTMLElement>('.butterfly-flock');
  if (layer) mount(layer);
</script>
