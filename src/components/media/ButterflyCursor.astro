---
/**
 * The logo butterfly circling the mouse pointer, on every page. The system
 * pointer stays visible and does the aiming; the butterfly flies round it,
 * perches just above it over a card so the card's label can be read, and
 * after a while of stillness comes to rest past the arrow's tip. The motion
 * lives in ~/lib/butterflies/cursor.
 *
 * Only for a mouse: touch, pen, and anyone asking for reduced motion never see
 * it. It steps aside over text fields, where it would sit on what is being
 * typed, while a modal is open, since the top layer covers it, and while the
 * pointer is inside an iframe, which keeps its pointer events to itself.
 *
 * Anything carrying data-cursor-label (the program and activity cards) makes
 * it grow and show that word beneath it, already translated by the page.
 */
import ButterflyGlyph from './ButterflyGlyph.astro';
---

<div class="butterfly-cursor" data-state="hidden" aria-hidden="true">
  <ButterflyGlyph class="butterfly-cursor__glyph" />
  <span class="butterfly-cursor__label"></span>
</div>
<script is:inline>
  // Draws the butterfly where the previous page left it, before first paint.
  // Applies the same test as parseSavedCursor in ~/lib/butterflies/cursor, and
  // without a saved flight places it at restingPoint from the same file (the
  // -29.5/-21.6 below); keep both in step.
  (function () {
    var query = '(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)';
    if (!window.matchMedia(query).matches) return;
    document.documentElement.setAttribute('data-butterfly-cursor', '');
    try {
      var saved = JSON.parse(sessionStorage.getItem('sko-cursor'));
      if (!saved || typeof saved.x !== 'number' || typeof saved.y !== 'number') return;
      if (saved.x < 0 || saved.y < 0 || saved.x > innerWidth || saved.y > innerHeight) return;
      var flown = typeof saved.bx === 'number' && typeof saved.by === 'number';
      var x = flown ? saved.bx : saved.x - 29.5;
      var y = flown ? saved.by : saved.y - 21.6;
      var el = document.currentScript.previousElementSibling;
      el.style.transform = 'translate3d(' + x + 'px,' + y + 'px,0)';
      el.setAttribute('data-state', 'idle');
    } catch (error) {}
  })();
</script>

<script>
  import {
    CURSOR_STORAGE_KEY,
    createCursorFlight,
    cursorWingSpan,
    isSettled,
    parseSavedCursor,
    restoreCursorFlight,
    saveCursor,
    stepCursorFlight,
    type Hover,
    type Point,
  } from '~/lib/butterflies/cursor';

  const QUERY = '(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)';
  const INTERACTIVE = 'a[href], button, [role="button"], summary, label, select, [data-cursor="link"]';
  const TEXT_ENTRY = 'input:not([type="checkbox"], [type="radio"], [type="button"], [type="submit"], [type="reset"]), textarea, [contenteditable]';

  type State = 'hidden' | 'idle' | 'link' | 'label' | 'text';

  function readSaved() {
    try {
      return parseSavedCursor(sessionStorage.getItem(CURSOR_STORAGE_KEY), {
        width: window.innerWidth,
        height: window.innerHeight,
      });
    } catch {
      // Storage blocked: start with the mouse, as on a first visit.
      return null;
    }
  }

  function start(element: HTMLElement) {
    const wings = element.querySelector<SVGGElement>('.butterfly-wings');
    const labelSlot = element.querySelector<HTMLElement>('.butterfly-cursor__label');
    const root = document.documentElement;
    const media = window.matchMedia(QUERY);

    const saved = readSaved();
    const pointer: Point = saved ? { x: saved.x, y: saved.y } : { x: -100, y: -100 };
    let flight = saved ? restoreCursorFlight(saved) : createCursorFlight(pointer);
    let state: State = saved ? 'idle' : 'hidden';
    let frameId = 0;
    let lastTime = 0;
    let hoverCheck = 0;

    const hover = (): Hover => (state === 'link' || state === 'label' ? state : 'none');

    const setState = (next: State) => {
      if (next === state) return;
      state = next;
      element.dataset.state = next;
    };

    const draw = () => {
      element.style.transform = `translate3d(${flight.x}px, ${flight.y}px, 0) rotate(${flight.tilt}rad)`;
      if (wings) wings.style.transform = `scaleX(${cursorWingSpan(flight)})`;
    };

    const frame = (time: number) => {
      frameId = 0;
      const dt = lastTime ? Math.min((time - lastTime) / 1000, 1 / 20) : 1 / 60;
      lastTime = time;
      stepCursorFlight(flight, pointer, dt, hover());
      draw();
      if (state === 'hidden' || document.hidden || isSettled(flight)) {
        lastTime = 0;
        return;
      }
      frameId = requestAnimationFrame(frame);
    };

    const wake = () => {
      if (!frameId && state !== 'hidden' && !document.hidden) frameId = requestAnimationFrame(frame);
    };

    const sleep = () => {
      if (frameId) cancelAnimationFrame(frameId);
      frameId = 0;
      lastTime = 0;
    };

    const classify = (under: Element | null) => {
      if (under?.closest(TEXT_ENTRY)) {
        setState('text');
        return;
      }
      const labelled = under?.closest<HTMLElement>('[data-cursor-label]');
      if (labelled?.dataset.cursorLabel) {
        if (labelSlot && labelSlot.textContent !== labelled.dataset.cursorLabel) {
          labelSlot.textContent = labelled.dataset.cursorLabel;
          labelSlot.lang = labelled.closest<HTMLElement>('[lang]')?.lang ?? '';
        }
        setState('label');
        return;
      }
      setState(under?.closest(INTERACTIVE) ? 'link' : 'idle');
    };

    const onMove = (event: PointerEvent) => {
      if (event.pointerType !== 'mouse') {
        setState('hidden');
        return;
      }
      pointer.x = event.clientX;
      pointer.y = event.clientY;
      // Back from outside the window: start beside the pointer, not from wherever it vanished.
      if (state === 'hidden') flight = createCursorFlight(pointer);
      classify(event.target instanceof Element ? event.target : null);
      wake();
    };

    const onDown = () => element.setAttribute('data-pressed', '');
    const onUp = () => element.removeAttribute('data-pressed');
    const onOut = (event: MouseEvent) => {
      const to = event.relatedTarget;
      if (to && !(to instanceof HTMLIFrameElement)) return;
      setState('hidden');
      onUp();
    };
    // A still pointer can end up over something else when the page scrolls
    // under it, and no pointermove says so.
    const onScroll = () => {
      if (state === 'hidden' || hoverCheck) return;
      hoverCheck = requestAnimationFrame(() => {
        hoverCheck = 0;
        if (state === 'hidden') return;
        classify(document.elementFromPoint(pointer.x, pointer.y));
        wake();
      });
    };
    const onVisibility = () => {
      if (document.hidden) sleep();
      else wake();
    };
    const onHide = () => {
      try {
        if (state === 'hidden') sessionStorage.removeItem(CURSOR_STORAGE_KEY);
        else sessionStorage.setItem(CURSOR_STORAGE_KEY, JSON.stringify(saveCursor(flight, pointer)));
      } catch {
        // Storage full or blocked: the next page simply waits for the mouse.
      }
    };
    const onMediaChange = () => {
      if (media.matches) root.setAttribute('data-butterfly-cursor', '');
      else {
        root.removeAttribute('data-butterfly-cursor');
        setState('hidden');
      }
    };

    draw();
    wake();
    window.addEventListener('pointermove', onMove, { passive: true });
    window.addEventListener('pointerdown', onDown, { passive: true });
    window.addEventListener('pointerup', onUp, { passive: true });
    // A drag that turns into a native drag-and-drop never sends pointerup.
    window.addEventListener('pointercancel', onUp, { passive: true });
    window.addEventListener('scroll', onScroll, { passive: true, capture: true });
    document.addEventListener('mouseout', onOut);
    document.addEventListener('visibilitychange', onVisibility);
    window.addEventListener('pagehide', onHide);
    media.addEventListener('change', onMediaChange);
  }

  const element = document.querySelector<HTMLElement>('.butterfly-cursor');
  if (element && window.matchMedia(QUERY).matches) start(element);
</script>
