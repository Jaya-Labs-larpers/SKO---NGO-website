---
import type { Locale } from '~/lib/i18n/config';
import type { CmsImage } from '~/lib/content/types';
import { hasImage } from '~/lib/sanity/image';
import ResponsiveImage from './ResponsiveImage.astro';

interface Props {
  images?: CmsImage[] | null;
  lang: Locale;
  /** Seconds each photo is held before the crossfade begins. */
  hold?: number;
  /** Seconds the crossfade itself takes. */
  fade?: number;
  class?: string;
}

const { images, lang, hold = 6, fade = 1.6, class: className = '' } = Astro.props;

const slides = (images ?? []).filter((image) => hasImage(image));
const count = slides.length;

/**
 * Crossfading background photos, with no JavaScript at all.
 *
 * Each slide runs the same keyframe animation over the full cycle, offset by a
 * negative delay so they take turns. That means no timer, no state, nothing to
 * get out of sync, and nothing to load.
 *
 * Costs: only the first photo is eager — it is the LCP element. The rest lazy-
 * load after the page is interactive, so a visitor on mobile data sees the page
 * long before photos 2–4 arrive, and pays for them only once they are idle.
 *
 * A changing background is exactly what prefers-reduced-motion is for, so under
 * that setting the animation is dropped entirely and the first photo simply
 * stays put.
 */
/*
 * Timing. Each slide's own timeline is:
 *   0 → fade            fading in
 *   fade → fade+hold    fully visible
 *   fade+hold → 2×fade+hold   fading out
 *   then hidden until the cycle repeats
 *
 * The fade-out of one slide has to occupy exactly the same window as the
 * fade-in of the next, or the background shows through between photos. That
 * falls out of giving each slide a start offset of one period, where a period
 * is hold+fade — and offsetting everything by -fade so the first photo is
 * already fully visible at load rather than fading up from nothing.
 */
const period = hold + fade;
const cycle = count > 0 ? count * period : 0;
const pct = (seconds: number) => (cycle > 0 ? (seconds / cycle) * 100 : 0);

const fadeInEnd = pct(fade);
const visibleEnd = pct(fade + hold);
const fadedEnd = pct(2 * fade + hold);
---

{
  count === 0 ? (
    <ResponsiveImage image={null} lang={lang} alt="" aspect="16/9" eager class={className} />
  ) : (
    <div class:list={['relative h-full w-full overflow-hidden', className]}>
      {slides.map((image, index) => (
        <div
          class:list={['absolute inset-0', count > 1 && 'hero-slide']}
          style={count > 1 ? `animation-delay: ${(index * period - fade).toFixed(3)}s` : undefined}
          aria-hidden={index > 0 ? 'true' : undefined}
        >
          <ResponsiveImage
            image={image}
            lang={lang}
            alt=""
            aspect="16/9"
            sizes="100vw"
            eager={index === 0}
            class="h-full"
          />
        </div>
      ))}
    </div>
  )
}

{
  count > 1 && (
    <style is:inline set:html={`
      @keyframes hero-crossfade {
        0% { opacity: 0; }
        ${fadeInEnd.toFixed(4)}% { opacity: 1; }
        ${visibleEnd.toFixed(4)}% { opacity: 1; }
        ${fadedEnd.toFixed(4)}% { opacity: 0; }
        100% { opacity: 0; }
      }
      .hero-slide {
        opacity: 0;
        animation: hero-crossfade ${cycle}s linear infinite both;
      }
      @media (prefers-reduced-motion: reduce) {
        .hero-slide { animation: none; }
        .hero-slide:first-child { opacity: 1; }
      }
    `} />
  )
}
