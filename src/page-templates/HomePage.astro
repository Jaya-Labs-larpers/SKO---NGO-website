---
import type { Locale } from '~/lib/i18n/config';
import { localizePath, pick, t, text } from '~/lib/i18n/utils';
import {
  getFeaturedActivities,
  getImpactStats,
  getPartners,
  getPrograms,
  getSiteSettings,
  getStories,
} from '~/lib/content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import HeroSlideshow from '~/components/media/HeroSlideshow.astro';
import ImpactStats from '~/components/content/ImpactStats.astro';
import SectionHeading from '~/components/content/SectionHeading.astro';
import ProgramCard from '~/components/content/ProgramCard.astro';
import ActivityCard from '~/components/content/ActivityCard.astro';
import PartnerWall from '~/components/content/PartnerWall.astro';
import StoryQuote from '~/components/content/StoryQuote.astro';
import CtaBand from '~/components/content/CtaBand.astro';
import { cardGridCols } from '~/lib/grid';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const [settings, stats, programs, activities, partners, stories] = await Promise.all([
  getSiteSettings(),
  getImpactStats(),
  getPrograms(),
  getFeaturedActivities(3),
  getPartners(),
  getStories(),
]);

const orgName = text(settings.orgName, lang);
const tagline = pick(settings.tagline, lang);
const registration = pick(settings.registration, lang);
const story = stories[0];
---

<BaseLayout
  lang={lang}
  title={orgName}
  description={tagline.value ?? undefined}
  ogImage={settings.ogImage}
>
  <!-- Hero: photo behind, white card in front. A CMS photo can never be trusted
       to win a contrast check on its own, so text never sits directly on it. -->
  <section class="relative border-b border-[color:var(--color-line-subtle)] bg-[color:var(--color-surface-subtle)]">
    {/*
      One instance, placed differently by breakpoint: a 4:3 block above the card
      on phones, full-bleed behind it from lg up. Rendering it twice would
      duplicate the slides and the keyframes for no gain.
    */}
    <div class="aspect-4/3 lg:absolute lg:inset-0 lg:aspect-auto">
      <HeroSlideshow images={settings.homeHero} lang={lang} class="h-full" />
    </div>

    <div class="wrap relative flex min-h-0 items-center lg:min-h-[520px]">
      <div
        class="-mt-10 mb-0 w-full max-w-[588px] rounded-[var(--radius-xl)] border border-[color:var(--color-line)] bg-white p-6 shadow-[var(--shadow-lg)] sm:p-11 lg:my-14 lg:-mt-0"
      >
        <p class="eyebrow">Phnom Penh, Cambodia · Since 2007</p>
        <h1
          class="mt-4 text-[length:var(--text-display)] leading-[var(--text-display--line-height)] tracking-[var(--text-display--letter-spacing)]"
          lang={tagline.isFallback ? tagline.lang : undefined}
        >
          {tagline.value}
        </h1>
        <p class="mt-4.5 text-[length:var(--text-lead)] leading-[1.6] text-[color:var(--color-ink-600)]">
          {t(lang, 'homeHeroIntro')}
        </p>
        <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a href={localizePath('/donate', lang)} class="btn btn-primary btn-block sm:w-auto"
            >{t(lang, 'donateNow')}</a
          >
          <a href={localizePath('/partner-with-us', lang)} class="btn btn-secondary btn-block sm:w-auto"
            >{t(lang, 'partnerWithUs')}</a
          >
        </div>
        {
          registration.value && (
            <p
              class="mt-6.5 flex items-center gap-2.5 border-t border-[color:var(--color-line-subtle)] pt-4.5 text-[13.5px] text-[color:var(--color-ink-400)]"
              lang={registration.isFallback ? registration.lang : undefined}
            >
              <span
                class="grid h-[18px] w-[18px] flex-none place-items-center rounded-full bg-[color:var(--color-sky-200)] text-[11px] text-[color:var(--color-blue-900)]"
                aria-hidden="true"
              >
                ✓
              </span>
              {registration.value}
            </p>
          )
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <ImpactStats lang={lang} stats={stats} />
    </div>
  </section>

  {
    programs.length > 0 && (
      <section class="section pt-0">
        <div class="wrap">
          <SectionHeading title={t(lang, 'whatWeDo')} />
          <div class={`mt-8.5 ${cardGridCols(programs.length)}`}>
            {programs.map((program) => (
              <ProgramCard lang={lang} program={program} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    activities.length > 0 && (
      <section class="section bg-[color:var(--color-surface-subtle)]">
        <div class="wrap">
          <div class="flex flex-wrap items-end justify-between gap-5">
            <SectionHeading title={t(lang, 'latestActivities')} />
            <a href={localizePath('/activities', lang)} class="link-arrow">
              {t(lang, 'allActivities')}
              <span class="arrow" aria-hidden="true">
                →
              </span>
            </a>
          </div>
          <div class={`mt-7.5 ${cardGridCols(activities.length)}`}>
            {activities.map((activity) => (
              <ActivityCard lang={lang} activity={activity} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="wrap grid items-center gap-14 lg:grid-cols-2">
      {
        story && (
          <div>
            <StoryQuote lang={lang} story={story} />
            <a href={localizePath('/impact', lang)} class="link-arrow mt-5.5">
              {t(lang, 'moreStories')}
              <span class="arrow" aria-hidden="true">
                →
              </span>
            </a>
          </div>
        )
      }
      {
        partners.length > 0 && (
          <div>
            <h2 class="mb-3 font-mono text-[11px] font-semibold tracking-[0.1em] text-[color:var(--color-ink-400)] uppercase">
              {t(lang, 'trustedBy')}
            </h2>
            <PartnerWall lang={lang} partners={partners.slice(0, 6)} columns={3} />
          </div>
        )
      }
    </div>
  </section>

  <CtaBand lang={lang} title={t(lang, 'ctaHomeTitle')} body={t(lang, 'ctaHomeBody')} />
</BaseLayout>
