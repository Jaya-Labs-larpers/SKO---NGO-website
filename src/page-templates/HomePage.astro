---
import type { Locale } from '~/lib/i18n/config';
import { localizePath, pick, t, text } from '~/lib/i18n/utils';
import {
  getFeaturedActivities,
  getImpactStats,
  getPartners,
  getPrograms,
  getSiteSettings,
  getStories,
} from '~/lib/content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import ImpactStats from '~/components/content/ImpactStats.astro';
import SectionHeading from '~/components/content/SectionHeading.astro';
import ProgramRows from '~/components/content/ProgramRows.astro';
import ActivityCard from '~/components/content/ActivityCard.astro';
import PartnerMarquee from '~/components/content/PartnerMarquee.astro';
import StoryQuote from '~/components/content/StoryQuote.astro';
import CtaBand from '~/components/content/CtaBand.astro';
import ButterflyField from '~/components/media/ButterflyField.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const [settings, stats, programs, activities, partners, stories] = await Promise.all([
  getSiteSettings(),
  getImpactStats(),
  getPrograms(),
  getFeaturedActivities(3),
  getPartners(),
  getStories(),
]);

const orgName = text(settings.orgName, lang);
const tagline = pick(settings.tagline, lang);
const registration = pick(settings.registration, lang);
const story = stories[0];
---

<BaseLayout
  lang={lang}
  title={orgName}
  description={tagline.value ?? undefined}
  ogImage={settings.ogImage}
  headerOverlay
>
  {
    /*
    Hero: text-led, no photograph. It starts at the top of the window, under a
    header that has gone transparent, so the section pays the header's height
    back as padding. The butterflies (ButterflyField) fly inside this section
    only, behind the text block, as they do inside every PageHero.
  */
  }
  <section
    data-home-hero
    class="hero-overlap relative flex flex-col justify-center border-b border-[color:var(--color-line-subtle)] bg-[color:var(--color-surface-subtle)] pt-[var(--header-h)]"
  >
    <ButterflyField />
    <div class="wrap relative pt-5 pb-10 sm:pt-12 sm:pb-20 lg:pt-14 lg:pb-24">
      <div data-butterfly-shelter>
        <p class="eyebrow">Phnom Penh, Cambodia · Since 2007</p>
        <h1
          class:list={[
            'mt-4 max-w-[15ch] text-balance sm:mt-5',
            lang === 'km'
              ? 'text-[length:min(var(--text-hero-km),8svh)] leading-[1.35]'
              : 'text-[length:min(var(--text-hero),12svh)] leading-[var(--text-hero--line-height)] tracking-[var(--text-hero--letter-spacing)]',
          ]}
          lang={tagline.isFallback ? tagline.lang : undefined}
        >
          {tagline.value}
        </h1>
        <div class="mt-7 inline-grid grid-cols-2 gap-3 max-[374px]:grid-cols-1">
          <a href={localizePath('/contact', lang)} class="btn btn-primary btn-fill">
            <span class="btn-fill__blob" aria-hidden="true"></span>
            <span class="roll">
              <span class="roll__text" data-text={t(lang, 'contactUs')}>{t(lang, 'contactUs')}</span
              >
            </span>
          </a>
          <a href={localizePath('/contact?topic=partner', lang)} class="btn btn-secondary">
            <span class="roll">
              <span class="roll__text" data-text={t(lang, 'partnerWithUs')}
                >{t(lang, 'partnerWithUs')}</span
              >
            </span>
          </a>
        </div>
        {
          registration.value && (
            <p
              class="mt-6 flex items-center gap-2.5 text-[13.5px] text-[color:var(--color-ink-400)]"
              lang={registration.isFallback ? registration.lang : undefined}
            >
              <span
                class="grid h-[18px] w-[18px] flex-none place-items-center rounded-full bg-[color:var(--color-sky-200)] text-[11px] text-[color:var(--color-blue-900)]"
                aria-hidden="true"
              >
                ✓
              </span>
              {registration.value}
            </p>
          )
        }
      </div>
    </div>
  </section>

  {
    /*
    Who we are: a small label on the left, one sentence set large on the
    right. Static — the words are the point.
  */
  }
  <section class="section">
    <div class="wrap grid gap-3 lg:grid-cols-[minmax(0,1fr)_minmax(0,2.4fr)] lg:gap-12">
      <h2 class="eyebrow pt-2">{t(lang, 'navAbout')}</h2>
      <div>
        <p
          class:list={[
            'max-w-[34ch] text-pretty text-[color:var(--color-ink-900)]',
            lang === 'km'
              ? 'text-[length:var(--text-lead)] leading-[1.9]'
              : 'text-[length:var(--text-statement)] leading-[1.3] tracking-[-0.02em]',
          ]}
        >
          {t(lang, 'homeHeroIntro')}
        </p>
        <a href={localizePath('/about', lang)} class="link-arrow mt-5 sm:mt-7">
          {t(lang, 'learnMore')}
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section pt-0">
    <div class="wrap">
      <ImpactStats lang={lang} stats={stats} />
    </div>
  </section>

  {
    programs.length > 0 && (
      <section class="section pt-0">
        <div class="wrap">
          <div class="flex flex-wrap items-end justify-between gap-5">
            <SectionHeading title={t(lang, 'whatWeDo')} />
            <a href={localizePath('/programs', lang)} class="link-arrow">
              {t(lang, 'viewAll')}
              <span class="arrow" aria-hidden="true">
                →
              </span>
            </a>
          </div>
          <div class="mt-8.5">
            <ProgramRows lang={lang} programs={programs} />
          </div>
        </div>
      </section>
    )
  }

  {
    activities.length > 0 && (
      <section class="section bg-[color:var(--color-surface-subtle)]">
        <div class="wrap">
          <div class="flex flex-wrap items-end justify-between gap-5">
            <SectionHeading title={t(lang, 'latestActivities')} />
            <a href={localizePath('/activities', lang)} class="link-arrow">
              {t(lang, 'allActivities')}
              <span class="arrow" aria-hidden="true">
                →
              </span>
            </a>
          </div>
          <div class="activity-editorial mt-9">
            {activities.map((activity) => (
              <ActivityCard
                lang={lang}
                activity={activity}
                sizes="(min-width: 48rem) 45vw, 100vw"
              />
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    story && (
      <section class="story-band on-inverse">
        <div class="wrap">
          <StoryQuote lang={lang} story={story} inverse quoteOnly />
        </div>
      </section>
    )
  }

  {
    partners.length > 0 && (
      <section class="section">
        <div class="wrap">
          <SectionHeading title={t(lang, 'trustedBy')} />
        </div>
        <div class="mt-8 border-y border-[color:var(--color-line)] py-4">
          <PartnerMarquee lang={lang} partners={partners} />
        </div>
      </section>
    )
  }

  <CtaBand lang={lang} title={t(lang, 'ctaHomeTitle')} body={t(lang, 'ctaHomeBody')} />
</BaseLayout>
