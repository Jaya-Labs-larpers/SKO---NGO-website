---
import type { Locale } from '~/lib/i18n/config';
import { localizePath, pick, t, text } from '~/lib/i18n/utils';
import {
  getFeaturedActivities,
  getImpactStats,
  getPartners,
  getPrograms,
  getSiteSettings,
} from '~/lib/content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Figure from '~/components/media/Figure.astro';
import Icon from '~/components/ui/Icon.astro';
import ImpactFigures from '~/components/content/ImpactFigures.astro';
import ProgramIndex from '~/components/content/ProgramIndex.astro';
import ActivityRow from '~/components/content/ActivityRow.astro';
import PartnerIndex from '~/components/content/PartnerIndex.astro';
import CloseBand from '~/components/content/CloseBand.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const [settings, stats, programs, activities, partners] = await Promise.all([
  getSiteSettings(),
  getImpactStats(),
  getPrograms(),
  getFeaturedActivities(3),
  getPartners(),
]);

const orgName = text(settings.orgName, lang);
const tagline = pick(settings.tagline, lang);
const registration = pick(settings.registration, lang);
const photograph = settings.homeHero?.[0] ?? null;

const evidenceLinks = [
  { label: t(lang, 'navEvidence'), title: t(lang, 'pageReports'), path: '/reports' },
  { label: t(lang, 'navSafeguarding'), title: t(lang, 'pageSafeguarding'), path: '/safeguarding' },
];

---

<BaseLayout lang={lang} title={orgName} description={tagline.value ?? undefined} ogImage={settings.ogImage}>
  <section class="wrap">
    <div class="grid gap-x-10 gap-y-8 pt-8 pb-10 lg:grid-cols-12 lg:pt-14 lg:pb-14">
      <div class="lg:col-span-7 lg:pr-6">
        {
          registration.value && (
            <p class="mono max-w-[60ch] border-b border-line pb-4" lang={registration.isFallback ? registration.lang : undefined}>
              {registration.value}
            </p>
          )
        }
        <h1
          class="mt-6 max-w-[18ch] text-[length:var(--text-display)] leading-[var(--text-display--line-height)] tracking-[var(--text-display--letter-spacing)]"
          lang={tagline.isFallback ? tagline.lang : undefined}
        >
          {tagline.value}
        </h1>
        <p class="mt-6 max-w-[52ch] text-[length:var(--text-lead)] leading-[var(--text-lead--line-height)] text-ink-600">
          {t(lang, 'homeHeroIntro')}
        </p>
        <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-7">
          <a href={localizePath('/donate', lang)} class="btn btn-primary">
            {t(lang, 'donateNow')}
            <Icon name="arrow-right" size={16} />
          </a>
          <a href={localizePath('/programs', lang)} class="link">
            {t(lang, 'ourPrograms')}
            <Icon name="arrow-right" size={14} />
          </a>
        </div>
      </div>

      <div class="lg:col-span-5">
        <Figure
          image={photograph}
          lang={lang}
          aspect="4/3"
          eager
          sizes="(min-width: 64rem) 520px, 100vw"
        />
        <ul class="mt-6 list-none border-b border-line p-0">
          {
            evidenceLinks.map((item) => (
              <li>
                <a
                  href={localizePath(item.path, lang)}
                  class="row-link grid-cols-[minmax(0,1fr)_auto] py-4 sm:grid-cols-[7.5rem_minmax(0,1fr)_auto]"
                >
                  <span class="mono hidden sm:block">{item.label}</span>
                  <span class="text-[17px] font-medium">{item.title}</span>
                  <Icon name="arrow-right" size={18} class="row-arrow self-center" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    {
      programs.length > 0 && (
        <nav aria-label={t(lang, 'whatWeDo')}>
          <ol class="grid list-none grid-cols-2 border-t border-l border-line p-0 lg:grid-cols-5">
            {programs.map((program, index) => {
              const title = pick(program.title, lang);
              return (
                <li class="contents">
                  <a
                    href={localizePath(`/programs/${program.slug}`, lang)}
                    class="flex min-h-[7.5rem] flex-col justify-between gap-4 border-r border-b border-line p-4 text-ink-900 no-underline transition-colors hover:bg-surface lg:p-5"
                  >
                    <span class="mono text-terracotta-700" aria-hidden="true">
                      {String(index + 1).padStart(2, '0')}
                    </span>
                    <span class="text-[15px] leading-[1.35] font-medium" lang={title.isFallback ? title.lang : undefined}>
                      {title.value}
                    </span>
                  </a>
                </li>
              );
            })}
            <li class="contents">
              <a
                href={localizePath('/impact', lang)}
                class="col-span-2 flex min-h-14 items-center justify-between gap-4 border-r border-b border-line p-4 text-ink-900 no-underline transition-colors hover:bg-surface lg:col-span-1 lg:min-h-[7.5rem] lg:flex-col-reverse lg:items-start lg:p-5"
              >
                <span class="text-[15px] leading-[1.35] font-medium">{t(lang, 'pageImpact')}</span>
                <Icon name="arrow-right" size={16} class="flex-none text-indigo-700" />
              </a>
            </li>
          </ol>
        </nav>
      )
    }
  </section>

  {
    programs.length > 0 && (
      <section class="wrap mt-[var(--spacing-section)]">
        <div class="ledger">
          <div>
            <h2 class="text-[length:var(--text-h2)] leading-[var(--text-h2--line-height)] tracking-[var(--text-h2--letter-spacing)]">
              {t(lang, 'whatWeDo')}
            </h2>
            <p class="mt-3 max-w-[38ch] text-ink-600">{t(lang, 'introPrograms')}</p>
          </div>
          <ProgramIndex lang={lang} programs={programs} />
        </div>
      </section>
    )
  }

  {
    stats.length > 0 && (
      <section class="wrap">
        <div class="ledger">
          <div>
            <h2 class="text-[length:var(--text-h2)] leading-[var(--text-h2--line-height)] tracking-[var(--text-h2--letter-spacing)]">
              {t(lang, 'pageImpact')}
            </h2>
            <p class="mt-3 max-w-[38ch] text-ink-600">{t(lang, 'introImpact')}</p>
          </div>
          <div>
            <ImpactFigures lang={lang} stats={stats} />
            <p class="mt-5 max-w-[62ch] text-[15px] text-ink-600">
              <b class="font-medium text-ink-900">{t(lang, 'methodologyTitle')}</b> {t(lang, 'methodologyBody')}
            </p>
            <a href={`${localizePath('/impact', lang)}#method`} class="link mt-4 text-[15px]">
              {t(lang, 'pageImpact')}
              <Icon name="arrow-right" size={14} />
            </a>
          </div>
        </div>
      </section>
    )
  }

  {
    activities.length > 0 && (
      <section class="wrap">
        <div class="ledger">
          <div>
            <h2 class="text-[length:var(--text-h2)] leading-[var(--text-h2--line-height)] tracking-[var(--text-h2--letter-spacing)]">
              {t(lang, 'latestActivities')}
            </h2>
            <p class="mt-3 max-w-[38ch] text-ink-600">{t(lang, 'introActivities')}</p>
          </div>
          <div>
            <ul class="list-none border-b border-line p-0">
              {activities.map((activity) => (
                <li>
                  <ActivityRow lang={lang} activity={activity} />
                </li>
              ))}
            </ul>
            <a href={localizePath('/activities', lang)} class="link mt-5 text-[15px]">
              {t(lang, 'allActivities')}
              <Icon name="arrow-right" size={14} />
            </a>
          </div>
        </div>
      </section>
    )
  }

  {
    partners.length > 0 && (
      <section class="wrap">
        <div class="ledger">
          <div>
            <h2 class="text-[length:var(--text-h2)] leading-[var(--text-h2--line-height)] tracking-[var(--text-h2--letter-spacing)]">
              {t(lang, 'trustedBy')}
            </h2>
            <p class="mt-3 max-w-[38ch] text-ink-600">{t(lang, 'introPartners')}</p>
            <a href={localizePath('/partners', lang)} class="link mt-4 text-[15px]">
              {t(lang, 'pagePartners')}
              <Icon name="arrow-right" size={14} />
            </a>
          </div>
          <PartnerIndex lang={lang} partners={partners} />
        </div>
      </section>
    )
  }

  <CloseBand lang={lang} title={t(lang, 'ctaHomeTitle')} body={t(lang, 'ctaHomeBody')} />
</BaseLayout>
