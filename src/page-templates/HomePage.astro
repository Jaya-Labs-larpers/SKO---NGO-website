---
import type { Locale } from '~/lib/i18n/config';
import { localizePath, pick, t, text } from '~/lib/i18n/utils';
import {
  getDirectorMessage,
  getFeaturedActivities,
  getImpactStats,
  getPartners,
  getPrograms,
  getSiteSettings,
  getStories,
} from '~/lib/content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import ImpactStats from '~/components/content/ImpactStats.astro';
import ProgramRows from '~/components/content/ProgramRows.astro';
import ActivityRow from '~/components/content/ActivityRow.astro';
import PartnerMarquee from '~/components/content/PartnerMarquee.astro';
import StoryQuote from '~/components/content/StoryQuote.astro';
import DirectorMessage from '~/components/content/DirectorMessage.astro';
import ResponsiveImage from '~/components/media/ResponsiveImage.astro';
import SectionHeading from '~/components/content/SectionHeading.astro';
import CtaBand from '~/components/content/CtaBand.astro';
import Icon from '~/components/Icon.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const [settings, stats, programs, activities, partners, stories, director] = await Promise.all([
  getSiteSettings(),
  getImpactStats(),
  getPrograms(),
  getFeaturedActivities(3),
  getPartners(),
  getStories(),
  getDirectorMessage(),
]);

const orgName = text(settings.orgName, lang);
const tagline = pick(settings.tagline, lang);
const registration = pick(settings.registration, lang);
const story = stories[0];
const brand = settings.orgShortName ?? 'SKO';
const seoTitle = t(lang, 'seoHome');
const heroImage = settings.homeHero?.[0] ?? null;
const hasDirector = Boolean(pick(director.pullQuote, lang).value);
---

<BaseLayout
  lang={lang}
  title={seoTitle ? `${seoTitle} · ${brand}` : orgName}
  plainTitle
  description={t(lang, 'metaHome') || tagline.value || undefined}
  ogImage={settings.ogImage}
  lcpImage={heroImage}
  lcpSizes="(min-width: 64rem) 50vw, 100vw"
>
  <section
    aria-labelledby="hero-title"
    class="on-navy grid bg-[color:var(--color-blue-900)] text-white lg:grid-cols-2"
  >
    <div
      class="order-last flex flex-col justify-end gap-8 px-[var(--gutter-left)] pt-12 pb-12 lg:order-none lg:min-h-[640px] lg:pt-[120px] lg:pb-[72px]"
    >
      <p class="eyebrow">{t(lang, 'homeEyebrow')}</p>
      <h1
        id="hero-title"
        class="m-0 max-w-[12ch] !text-white"
        style="font-size:calc(clamp(2.275rem,4.62vw,4.55rem)*var(--display-scale));line-height:1.08"
        lang={tagline.isFallback ? tagline.lang : undefined}
      >
        {tagline.value}
      </h1>
      <div>
        <a
          href={localizePath('/contact?topic=partner', lang)}
          class="btn btn-accent btn-lg max-sm:w-full"
        >
          {t(lang, 'partnerWithUs')}<Icon name="arrow-right" size={20} />
        </a>
      </div>
      {
        registration.value && (
          <p
            class="m-0 flex items-start gap-2.5 border-t border-[color:var(--color-line-navy)] pt-5 text-sm leading-normal text-[color:var(--color-on-navy)]"
            lang={registration.isFallback ? registration.lang : undefined}
          >
            <Icon
              name="check"
              size={18}
              class="mt-px flex-none text-[color:var(--color-sky-400)]"
            />
            <span>{registration.value}</span>
          </p>
        )
      }
    </div>
    <div
      class="relative h-[260px] sm:h-[360px] lg:h-auto lg:min-h-[560px] [&_img]:absolute [&_img]:inset-0 [&_img]:h-full [&_img]:w-full"
    >
      <ResponsiveImage
        image={heroImage}
        lang={lang}
        alt=""
        aspect="4/3"
        eager
        sizes="(min-width: 64rem) 50vw, 100vw"
      />
    </div>
  </section>

  <section
    class="mx-auto grid max-w-[var(--container-page)] [grid-template-columns:repeat(auto-fit,minmax(min(100%,380px),1fr))] items-start gap-[clamp(48px,6vw,96px)] px-[var(--gutter-left)] py-[clamp(80px,9vw,136px)]"
  >
    <div class="flex flex-col gap-6">
      <h2 class="eyebrow">{t(lang, 'navAbout')}</h2>
      <p
        lang="km"
        aria-hidden="true"
        class="m-0 leading-[1.35] font-bold text-[color:var(--color-blue-700)]"
        style="font-family:var(--font-khmer);font-size:clamp(3rem,5.4vw,4.75rem)"
      >
        សមត្ថភាពខ្ញុំ
      </p>
      <div
        class="flex max-w-[46ch] flex-col gap-2.5 border-t-[3px] border-t-[color:var(--color-sky-400)] pt-6"
      >
        <h3 class="m-0 font-[family-name:var(--font-sans)] text-[19px] leading-[1.4] font-bold">
          {t(lang, 'homeMeaningTitle')}
        </h3>
        <p class="m-0 text-[color:var(--color-ink-400)]">{t(lang, 'homeMeaningBody')}</p>
      </div>
    </div>
    <div class="flex flex-col gap-9">
      <p class="t-statement m-0">{t(lang, 'homeHeroIntro')}</p>
      <a href={localizePath('/about', lang)} class="link-arrow self-start">
        {t(lang, 'homeAboutLink') || t(lang, 'learnMore')}<Icon name="arrow-right" size={18} />
      </a>
    </div>
  </section>

  {
    stats.length > 0 && (
      <section
        aria-label="SKO"
        class="on-navy bg-[color:var(--color-blue-900)] px-[var(--gutter-left)] py-[clamp(80px,8vw,120px)] text-white"
      >
        <ImpactStats lang={lang} stats={stats} />
      </section>
    )
  }

  {
    programs.length > 0 && (
      <section
        aria-labelledby="work-title"
        class="mx-auto flex max-w-[var(--container-page)] flex-col gap-[clamp(56px,6vw,96px)] px-[var(--gutter-left)] py-[clamp(88px,9vw,136px)]"
      >
        <div class="flex flex-wrap items-end justify-between gap-6">
          <SectionHeading id="work-title" title={t(lang, 'whatWeDo')} size="xl" />
          <a href={localizePath('/programs', lang)} class="link-arrow">
            {t(lang, 'viewAllPrograms') || t(lang, 'viewAll')}
            <Icon name="arrow-right" size={18} />
          </a>
        </div>
        <ProgramRows lang={lang} programs={programs} />
      </section>
    )
  }

  {
    hasDirector && (
      <section aria-labelledby="director-title" class="band band--wing">
        <DirectorMessage lang={lang} director={director} variant="band" />
      </section>
    )
  }

  {
    story && (
      <section aria-label="Story" class="band band--tint">
        <StoryQuote lang={lang} story={story} quoteOnly linkProgram />
      </section>
    )
  }

  {
    activities.length > 0 && (
      <section
        aria-labelledby="news-title"
        class="mx-auto flex max-w-[var(--container-page)] flex-col gap-10 px-[var(--gutter-left)] pt-[clamp(88px,9vw,128px)]"
      >
        <div class="flex flex-wrap items-end justify-between gap-6">
          <SectionHeading id="news-title" title={t(lang, 'latestActivities')} size="xs" />
          <a href={localizePath('/activities', lang)} class="link-arrow">
            {t(lang, 'allActivities')}
            <Icon name="arrow-right" size={18} />
          </a>
        </div>
        <div class="[&>article:not(:first-child)]:!border-t [&>article:not(:first-child)]:!border-t-[color:var(--color-line)]">
          {activities.map((activity) => (
            <ActivityRow lang={lang} activity={activity} variant="compact" />
          ))}
        </div>
      </section>
    )
  }

  {
    partners.length > 0 && (
      <section
        aria-labelledby="partners-title"
        class="flex flex-col gap-10 py-[clamp(88px,9vw,128px)]"
      >
        <div class="mx-auto flex w-full max-w-[var(--container-page)] flex-wrap items-end justify-between gap-6 px-[var(--gutter-left)]">
          <SectionHeading id="partners-title" title={t(lang, 'trustedBy')} size="xs" />
          {t(lang, 'allPartners') && (
            <a href={localizePath('/partners', lang)} class="link-arrow">
              {t(lang, 'allPartners')}
              <Icon name="arrow-right" size={18} />
            </a>
          )}
        </div>
        <div class="border-y border-[color:var(--color-line)] py-4">
          <PartnerMarquee lang={lang} partners={partners} />
        </div>
      </section>
    )
  }

  <CtaBand lang={lang} title={t(lang, 'ctaHomeTitle')} body={t(lang, 'ctaHomeBody')} />
</BaseLayout>
