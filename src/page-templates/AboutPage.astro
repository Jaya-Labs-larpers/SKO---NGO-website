---
import type { Locale } from '~/lib/i18n/config';
import { getDirectorMessage, getOrgChart, getPage, getSiteSettings, getTeam } from '~/lib/content';
import { localizePath, pick, t } from '~/lib/i18n/utils';
import { resolveSeo } from '~/lib/seo';
import { aboutPageJsonLd } from '~/lib/seo/page-schema';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHero from '~/components/content/PageHero.astro';
import ResponsiveImage from '~/components/media/ResponsiveImage.astro';
import SectionedBody from '~/components/content/SectionedBody.astro';
import Icon from '~/components/Icon.astro';
import DirectorMessage from '~/components/content/DirectorMessage.astro';
import OrgChart from '~/components/content/OrgChart.astro';
import TeamStructure from '~/components/content/TeamStructure.astro';
import CtaBand from '~/components/content/CtaBand.astro';
import FaqSection from '~/components/content/FaqSection.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const [page, director, chart, team, settings] = await Promise.all([
  getPage('about'),
  getDirectorMessage(),
  getOrgChart(),
  getTeam(),
  getSiteSettings(),
]);
const registration = pick(settings.registration, lang);
const photoCaption = pick(page?.heroImage?.caption, lang);

/**
 * The structure section appears only once there is a structure to show — an
 * empty heading over an empty frame is scaffolding, and scaffolding is not
 * something a visitor should be shown.
 */
const hasOrgChart =
  Boolean(chart.image?.asset) ||
  Object.values(chart.textVersion ?? {}).some((value) => Array.isArray(value) && value.length > 0);

const title = pick(page?.title, lang);
const intro = pick(page?.intro, lang);
const heading = title.value ?? t(lang, 'pageAbout');
const seo = resolveSeo(page?.seo, lang, {
  title: heading,
  description: intro.value,
  image: page?.heroImage,
});
const aboutPage = aboutPageJsonLd({
  pathname: Astro.url.pathname,
  name: seo.title,
  description: seo.description,
});
---

<BaseLayout
  lang={lang}
  title={seo.title}
  description={seo.description}
  ogImage={seo.ogImage}
  noindex={seo.noindex}
  jsonLd={aboutPage}
  lcpImage={page?.heroImage}
>
  <PageHero
    size="xxl"
    lang={lang}
    title={heading}
    intro={intro.value}
    introLang={intro.isFallback ? intro.lang : undefined}
    trail={[{ label: heading }]}
  >
    {
      registration.value && (
        <p
          class="m-0 flex items-start gap-2.5 text-sm text-[color:var(--color-ink-400)]"
          lang={registration.isFallback ? registration.lang : undefined}
        >
          <Icon
            name="check"
            size={18}
            class="mt-0.5 flex-none text-[color:var(--color-blue-700)]"
          />
          <span>{registration.value}</span>
        </p>
      )
    }
    <div class="flex flex-wrap gap-3">
      <a href={localizePath('/reports', lang)} class="btn btn-primary">{t(lang, 'seeReports')}</a>
      <a href={localizePath('/contact', lang)} class="btn btn-secondary">{t(lang, 'contactUs')}</a>
    </div>
  </PageHero>

  {
    page?.heroImage && (
      <figure class="m-0">
        <div class="h-[clamp(320px,38vw,560px)]">
          <ResponsiveImage
            image={page.heroImage}
            lang={lang}
            alt=""
            aspect="21/9"
            eager
            sizes="100vw"
          />
        </div>
        {photoCaption.value && (
          <figcaption
            class="wrap py-2.5 text-sm text-[color:var(--color-ink-400)]"
            lang={photoCaption.isFallback ? photoCaption.lang : undefined}
          >
            {photoCaption.value}
          </figcaption>
        )}
      </figure>
    )
  }

  <SectionedBody lang={lang} body={page?.body} variant="about" />

  <section
    aria-labelledby="director-title"
    class="mx-auto max-w-[var(--container-page)] px-[var(--gutter-left)] py-[clamp(88px,9vw,136px)]"
  >
    <DirectorMessage lang={lang} director={director} />
  </section>

  {
    hasOrgChart && (
      <section
        aria-labelledby="structure-title"
        class="mx-auto flex max-w-[var(--container-page)] flex-col gap-10 px-[var(--gutter-left)] pb-[clamp(88px,9vw,136px)]"
      >
        <h2 id="structure-title" class="t-xs m-0">
          {t(lang, 'orgStructure')}
        </h2>
        <OrgChart lang={lang} chart={chart} />
      </section>
    )
  }

  {
    team.length > 0 && (
      <section aria-labelledby="team-title" class="band band--tint">
        <div class="wrap-inner flex flex-col gap-12">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <h2 id="team-title" class="t-lg m-0">
              {t(lang, 'ourTeam')}
            </h2>
            <h3 class="eyebrow !text-sm">{t(lang, 'orgStructure')}</h3>
          </div>
          <TeamStructure lang={lang} team={team} />
        </div>
      </section>
    )
  }

  {
    page?.faqs && page.faqs.length > 0 && (
      <FaqSection
        lang={lang}
        faqs={page.faqs}
        moreHref={localizePath('/faq', lang)}
        moreLabel={t(lang, 'faqMore')}
      />
    )
  }

  <CtaBand lang={lang} title={t(lang, 'ctaAboutTitle')} body={t(lang, 'ctaAboutBody')} />
</BaseLayout>
