---
import type { Locale } from '~/lib/i18n/config';
import { getDirectorMessage, getOrgChart, getPage, getTeam } from '~/lib/content';
import { pick, t } from '~/lib/i18n/utils';
import { resolveSeo } from '~/lib/seo';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHero from '~/components/content/PageHero.astro';
import RichText from '~/components/content/RichText.astro';
import SectionHeading from '~/components/content/SectionHeading.astro';
import DirectorMessage from '~/components/content/DirectorMessage.astro';
import OrgChart from '~/components/content/OrgChart.astro';
import ResponsiveImage from '~/components/media/ResponsiveImage.astro';
import CtaBand from '~/components/content/CtaBand.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const [page, director, chart, team] = await Promise.all([
  getPage('about'),
  getDirectorMessage(),
  getOrgChart(),
  getTeam(),
]);

const title = pick(page?.title, lang);
const intro = pick(page?.intro, lang);
const heading = title.value ?? t(lang, 'pageAbout');
const seo = resolveSeo(page?.seo, lang, {
  title: heading,
  description: intro.value,
  image: page?.heroImage,
});
---

<BaseLayout
  lang={lang}
  title={seo.title}
  description={seo.description}
  ogImage={seo.ogImage}
  noindex={seo.noindex}
>
  <PageHero
    lang={lang}
    title={heading}
    intro={intro.value}
    introLang={intro.isFallback ? intro.lang : undefined}
    trail={[{ label: heading }]}
  />

  <section class="section">
    <div class="wrap">
      <RichText blocks={page?.body} lang={lang} />
    </div>
  </section>

  <section class="section bg-[color:var(--color-surface-subtle)] pt-0">
    <div class="wrap pt-[var(--spacing-section)]">
      <SectionHeading title={t(lang, 'directorMessage')} />
      <div class="mt-8"><DirectorMessage lang={lang} director={director} /></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHeading title={t(lang, 'orgStructure')} />
      <div class="mt-6.5"><OrgChart lang={lang} chart={chart} /></div>
    </div>
  </section>

  {
    team.length > 0 && (
      <section class="section pt-0">
        <div class="wrap">
          <SectionHeading title={t(lang, 'ourTeam')} />
          <ul class="mt-8 grid list-none gap-6 p-0 sm:grid-cols-2 lg:grid-cols-4">
            {team.map((member) => {
              const name = pick(member.name, lang);
              const role = pick(member.role, lang);
              return (
                <li>
                  <div class="overflow-hidden rounded-[var(--radius-lg)] border border-[color:var(--color-line)]">
                    <ResponsiveImage image={member.photo} lang={lang} alt="" aspect="4/5" sizes="280px" />
                  </div>
                  <b
                    class="mt-3.5 block text-[16px] text-[color:var(--color-ink-900)]"
                    lang={name.isFallback ? name.lang : undefined}
                  >
                    {name.value}
                  </b>
                  <span
                    class="mt-0.5 block text-[14px] text-[color:var(--color-ink-400)]"
                    lang={role.isFallback ? role.lang : undefined}
                  >
                    {role.value}
                  </span>
                </li>
              );
            })}
          </ul>
        </div>
      </section>
    )
  }

  <CtaBand lang={lang} title={t(lang, 'ctaAboutTitle')} body={t(lang, 'ctaAboutBody')} />
</BaseLayout>
