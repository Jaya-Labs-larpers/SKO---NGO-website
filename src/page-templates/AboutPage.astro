---
import type { Locale } from '~/lib/i18n/config';
import { getDirectorMessage, getOrgChart, getPage, getTeam } from '~/lib/content';
import { pick, t } from '~/lib/i18n/utils';
import { resolveSeo } from '~/lib/seo';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeading from '~/components/content/PageHeading.astro';
import PageIndex from '~/components/content/PageIndex.astro';
import RichText from '~/components/content/RichText.astro';
import DirectorMessage from '~/components/content/DirectorMessage.astro';
import OrgChart from '~/components/content/OrgChart.astro';
import ResponsiveImage from '~/components/media/ResponsiveImage.astro';
import CloseBand from '~/components/content/CloseBand.astro';
import FaqSection from '~/components/content/FaqSection.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const [page, director, chart, team] = await Promise.all([
  getPage('about'),
  getDirectorMessage(),
  getOrgChart(),
  getTeam(),
]);

const title = pick(page?.title, lang);
const intro = pick(page?.intro, lang);
const heading = title.value ?? t(lang, 'pageAbout');
const seo = resolveSeo(page?.seo, lang, {
  title: heading,
  description: intro.value,
  image: page?.heroImage,
});

const hasFaqs = Boolean(page?.faqs && page.faqs.length > 0);
const indexItems = [
  { id: 'organization', label: heading, lang: title.isFallback ? title.lang : undefined },
  { id: 'director', label: t(lang, 'directorMessage') },
  { id: 'structure', label: t(lang, 'orgStructure') },
  ...(team.length > 0 ? [{ id: 'team', label: t(lang, 'ourTeam') }] : []),
  ...(hasFaqs ? [{ id: 'faq', label: t(lang, 'faqHeading') }] : []),
];

const h2 =
  'text-[length:var(--text-h2)] leading-[var(--text-h2--line-height)] tracking-[var(--text-h2--letter-spacing)] scroll-mt-24';
---

<BaseLayout
  lang={lang}
  title={seo.title}
  description={seo.description}
  ogImage={seo.ogImage}
  noindex={seo.noindex}
>
  <PageHeading
    lang={lang}
    title={heading}
    titleLang={title.isFallback ? title.lang : undefined}
    intro={intro.value}
    introLang={intro.isFallback ? intro.lang : undefined}
    trail={[{ label: heading }]}
  />

  <section class="wrap grid gap-x-10 gap-y-8 pt-8 pb-[var(--spacing-section)] lg:grid-cols-12 lg:pt-12">
    <aside class="lg:col-span-3">
      <PageIndex lang={lang} items={indexItems} />
    </aside>

    <div class="lg:col-span-9">
      <section id="organization" class="scroll-mt-24">
        <RichText blocks={page?.body} lang={lang} />
      </section>

      <section class="mt-14 border-t border-line pt-10">
        <h2 id="director" class={h2}>{t(lang, 'directorMessage')}</h2>
        <div class="mt-8"><DirectorMessage lang={lang} director={director} /></div>
      </section>

      <section class="mt-14 border-t border-line pt-10">
        <h2 id="structure" class={h2}>{t(lang, 'orgStructure')}</h2>
        <div class="mt-8"><OrgChart lang={lang} chart={chart} /></div>
      </section>

      {
        team.length > 0 && (
          <section class="mt-14 border-t border-line pt-10">
            <h2 id="team" class={h2}>
              {t(lang, 'ourTeam')}
            </h2>
            <ul class="mt-8 grid list-none gap-x-6 gap-y-8 p-0 sm:grid-cols-2 lg:grid-cols-4">
              {team.map((member) => {
                const name = pick(member.name, lang);
                const role = pick(member.role, lang);
                return (
                  <li>
                    <ResponsiveImage image={member.photo} lang={lang} alt="" aspect="4/5" sizes="280px" placeholder="[Portrait]" />
                    <p class="mt-3 border-t border-line pt-3">
                      <span class="block text-[15px] font-medium text-ink-900" lang={name.isFallback ? name.lang : undefined}>
                        {name.value}
                      </span>
                      <span class="mt-0.5 block text-[13px] text-ink-400" lang={role.isFallback ? role.lang : undefined}>
                        {role.value}
                      </span>
                    </p>
                  </li>
                );
              })}
            </ul>
          </section>
        )
      }
    </div>
  </section>

  {hasFaqs && page?.faqs && <FaqSection lang={lang} faqs={page.faqs} />}

  <CloseBand lang={lang} title={t(lang, 'ctaAboutTitle')} body={t(lang, 'ctaAboutBody')} />
</BaseLayout>
