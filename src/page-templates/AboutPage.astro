---
import type { Locale } from '~/lib/i18n/config';
import { getDirectorMessage, getOrgChart, getPage, getTeam } from '~/lib/content';
import { pick, t } from '~/lib/i18n/utils';
import { resolveSeo } from '~/lib/seo';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHero from '~/components/content/PageHero.astro';
import SectionedBody from '~/components/content/SectionedBody.astro';
import SectionHeading from '~/components/content/SectionHeading.astro';
import DirectorMessage from '~/components/content/DirectorMessage.astro';
import OrgChart from '~/components/content/OrgChart.astro';
import TeamStructure from '~/components/content/TeamStructure.astro';
import CtaBand from '~/components/content/CtaBand.astro';
import FaqSection from '~/components/content/FaqSection.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const [page, director, chart, team] = await Promise.all([
  getPage('about'),
  getDirectorMessage(),
  getOrgChart(),
  getTeam(),
]);

/**
 * The structure section appears only once there is a structure to show — an
 * empty heading over an empty frame is scaffolding, and scaffolding is not
 * something a visitor should be shown.
 */
const hasOrgChart =
  Boolean(chart.image?.asset) ||
  Object.values(chart.textVersion ?? {}).some((value) => Array.isArray(value) && value.length > 0);

const title = pick(page?.title, lang);
const intro = pick(page?.intro, lang);
const heading = title.value ?? t(lang, 'pageAbout');
const seo = resolveSeo(page?.seo, lang, {
  title: heading,
  description: intro.value,
  image: page?.heroImage,
});
---

<BaseLayout
  headerOverlay
  lang={lang}
  title={seo.title}
  description={seo.description}
  ogImage={seo.ogImage}
  noindex={seo.noindex}
>
  <PageHero
    lang={lang}
    title={heading}
    intro={intro.value}
    introLang={intro.isFallback ? intro.lang : undefined}
    trail={[{ label: heading }]}
  />

  <div class="bg-white pb-[var(--spacing-section)]">
    <SectionedBody lang={lang} body={page?.body} />
  </div>

  <section class="section bg-[color:var(--color-surface-sunken)]">
    <div class="wrap">
      <SectionHeading title={t(lang, 'directorMessage')} />
      <div class="mt-8">
        <DirectorMessage lang={lang} director={director} />
      </div>
    </div>
  </section>

  {
    hasOrgChart && (
      <section class="section bg-white">
        <div class="wrap">
          <SectionHeading title={t(lang, 'orgStructure')} />
          <div class="mt-6.5">
            <OrgChart lang={lang} chart={chart} />
          </div>
        </div>
      </section>
    )
  }

  {
    team.length > 0 && (
      <section class:list={['section bg-white', hasOrgChart && 'pt-0']}>
        <div class="wrap">
          <SectionHeading title={t(lang, 'ourTeam')} />
          <h3 class="mt-6 text-[length:var(--text-h3)] text-[color:var(--color-ink-900)]">
            {t(lang, 'orgStructure')}
          </h3>
          <div class="mt-8">
            <TeamStructure lang={lang} team={team} />
          </div>
        </div>
      </section>
    )
  }

  {page?.faqs && page.faqs.length > 0 && <FaqSection lang={lang} faqs={page.faqs} />}

  <CtaBand lang={lang} title={t(lang, 'ctaAboutTitle')} body={t(lang, 'ctaAboutBody')} />
</BaseLayout>
