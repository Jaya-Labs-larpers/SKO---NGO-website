---
import type { Locale } from '~/lib/i18n/config';
import { getReports } from '~/lib/content';
import { t } from '~/lib/i18n/utils';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHero from '~/components/content/PageHero.astro';
import ReportList from '~/components/content/ReportList.astro';
import EmptyState from '~/components/content/EmptyState.astro';
import { stripInlineLinks } from '~/lib/inline-links';
import { collectionPageJsonLd } from '~/lib/seo/page-schema';

interface Props {
  lang: Locale;
  /** 'policy' on the safeguarding page, everything else here. */
  types?: string[];
}

const { lang, types } = Astro.props;

const all = await getReports();
const reports = types ? all.filter((report) => types.includes(report.type ?? 'other')) : all;

const heading = t(lang, 'pageReports');
const title = t(lang, 'seoReports') || heading;
const description = t(lang, 'metaReports') || stripInlineLinks(t(lang, 'introReports'));
const collection = collectionPageJsonLd({ pathname: Astro.url.pathname, name: title, description });
---

<BaseLayout lang={lang} title={title} description={description} jsonLd={collection}>
  <PageHero
    lang={lang}
    title={heading}
    intro={t(lang, 'introReports')}
    trail={[{ label: heading }]}
  />
  <section
    aria-label={heading}
    class="on-navy bg-[color:var(--color-blue-900)] px-[var(--gutter-left)] pt-[clamp(64px,6vw,96px)] pb-[clamp(88px,9vw,128px)] text-white"
  >
    {
      reports.length === 0 ? (
        <EmptyState message={t(lang, 'emptyReports')} />
      ) : (
        <ReportList lang={lang} reports={reports} />
      )
    }
  </section>
</BaseLayout>
