---
import type { Locale } from '~/lib/i18n/config';
import { getImpactStats, getPage, getStories } from '~/lib/content';
import { localizePath, t } from '~/lib/i18n/utils';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeading from '~/components/content/PageHeading.astro';
import RichText from '~/components/content/RichText.astro';
import ImpactFigures from '~/components/content/ImpactFigures.astro';
import StoryQuote from '~/components/content/StoryQuote.astro';
import CloseBand from '~/components/content/CloseBand.astro';
import Icon from '~/components/ui/Icon.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const [stats, stories, page] = await Promise.all([getImpactStats(), getStories(), getPage('impact')]);
const heading = t(lang, 'pageImpact');
const methodTitle = t(lang, 'methodologyTitle').replace(/[.។]$/, '');
---

<BaseLayout lang={lang} title={heading} description={t(lang, 'introImpact')}>
  <PageHeading lang={lang} title={heading} intro={t(lang, 'introImpact')} trail={[{ label: heading }]} />

  <section class="wrap grid gap-x-10 pt-10 lg:grid-cols-12 lg:pt-14">
    <div class="lg:col-span-9 lg:col-start-4">
      <ImpactFigures lang={lang} stats={stats} />
    </div>
  </section>

  <section class="wrap mt-[var(--spacing-section)]">
    <div class="ledger">
      <h2 id="method" class="text-[length:var(--text-h2)] leading-[var(--text-h2--line-height)] tracking-[var(--text-h2--letter-spacing)] scroll-mt-24">
        {methodTitle}
      </h2>
      <div>
        <p class="max-w-[62ch] text-ink-900">{t(lang, 'methodologyBody')}</p>
        <RichText blocks={page?.body} lang={lang} class="mt-6" />
        <a href={localizePath('/reports', lang)} class="link mt-6 text-[15px]">
          {t(lang, 'seeReports')}
          <Icon name="arrow-right" size={14} />
        </a>
      </div>
    </div>
  </section>

  {
    stories.length > 0 && (
      <section class="wrap">
        <div class="ledger">
          <h2 class="text-[length:var(--text-h2)] leading-[var(--text-h2--line-height)] tracking-[var(--text-h2--letter-spacing)]">
            {t(lang, 'moreStories')}
          </h2>
          <ul class="grid list-none gap-10 p-0 lg:grid-cols-2">
            {stories.map((story) => (
              <li>
                <StoryQuote lang={lang} story={story} showAvatar />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <CloseBand lang={lang} title={t(lang, 'ctaImpactTitle')} secondaryKey="seeReports" secondaryPath="/reports" />
</BaseLayout>
