---
import type { Locale } from '~/lib/i18n/config';
import { getImpactStats, getPage } from '~/lib/content';
import { localizePath, t } from '~/lib/i18n/utils';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHero from '~/components/content/PageHero.astro';
import RichText from '~/components/content/RichText.astro';
import ImpactStats from '~/components/content/ImpactStats.astro';
import CtaBand from '~/components/content/CtaBand.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const [stats, page] = await Promise.all([getImpactStats(), getPage('impact')]);
const heading = t(lang, 'pageImpact');
---

<BaseLayout headerOverlay lang={lang} title={heading} description={t(lang, 'introImpact')}>
  <PageHero
    lang={lang}
    title={heading}
    intro={t(lang, 'introImpact')}
    trail={[{ label: heading }]}
  />

  <section class="section">
    <div class="wrap">
      <ImpactStats lang={lang} stats={stats} />
      <RichText blocks={page?.body} lang={lang} class="mt-8" />
      <p class="mt-8">
        <a href={localizePath('/reports', lang)} class="link-arrow">
          {t(lang, 'seeReports')}
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      </p>
    </div>
  </section>

  <CtaBand lang={lang} title={t(lang, 'ctaImpactTitle')} />
</BaseLayout>
