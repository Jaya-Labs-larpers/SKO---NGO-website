---
import type { Locale } from '~/lib/i18n/config';
import { getImpactStats, getPage, getPrograms, getStories } from '~/lib/content';
import { localizePath, pick, t } from '~/lib/i18n/utils';
import { resolveSeo } from '~/lib/seo';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHero from '~/components/content/PageHero.astro';
import ResponsiveImage from '~/components/media/ResponsiveImage.astro';
import ImpactStats from '~/components/content/ImpactStats.astro';
import SectionedBody from '~/components/content/SectionedBody.astro';
import StoryQuote from '~/components/content/StoryQuote.astro';
import CtaBand from '~/components/content/CtaBand.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const [stats, page, programs, stories] = await Promise.all([
  getImpactStats(),
  getPage('impact'),
  getPrograms(),
  getStories(),
]);

const title = pick(page?.title, lang);
const intro = pick(page?.intro, lang);
const heading = title.value ?? t(lang, 'pageImpact');
const introText = intro.value ?? t(lang, 'introImpact');
const story = stories[0];
const seo = resolveSeo(page?.seo, lang, {
  title: heading,
  description: introText,
  image: page?.heroImage,
});
---

<BaseLayout
  lang={lang}
  title={seo.title}
  description={seo.description}
  ogImage={seo.ogImage}
  noindex={seo.noindex}
>
  <PageHero
    dark
    size="xxl"
    lang={lang}
    title={heading}
    intro={introText}
    introLang={intro.isFallback ? intro.lang : undefined}
    trail={[{ label: heading }]}
  >
    <a href={localizePath('/reports', lang)} class="btn btn-accent btn-lg"
      >{t(lang, 'seeReports')}</a
    >
  </PageHero>

  {
    stats.length > 0 && (
      <section aria-labelledby="glance-title" class="on-wing band band--wing band--tight">
        <div class="wrap-inner flex flex-col gap-10">
          <h2 id="glance-title" class="eyebrow">
            {t(lang, 'resultsAtAGlance')}
          </h2>
          <ImpactStats lang={lang} stats={stats} variant="tiles" />
        </div>
      </section>
    )
  }

  <SectionedBody lang={lang} body={page?.body} variant="plain" />

  {
    programs.length > 0 && (
      <section
        aria-label={t(lang, 'ourPrograms')}
        class="band band--tint !py-[clamp(80px,8vw,120px)]"
      >
        <div class="wrap-inner">
          <ol class="m-0 grid list-none [grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr))] gap-6 p-0">
            {programs.map((program, index) => {
              const title = pick(program.title, lang);
              return (
                <li>
                  <a
                    href={localizePath(`/programs/${program.slug}`, lang)}
                    class="flex flex-col gap-3.5 no-underline"
                  >
                    <div class="aspect-[4/3] overflow-hidden rounded-[var(--radius-lg)]">
                      <ResponsiveImage
                        image={program.cardImage ?? program.image}
                        lang={lang}
                        alt=""
                        aspect="4/3"
                        sizes="(min-width: 64rem) 22vw, 50vw"
                      />
                    </div>
                    <span class="font-[family-name:var(--font-display)] text-sm font-bold text-[color:var(--color-blue-700)]">
                      {String(index + 1).padStart(2, '0')}
                    </span>
                    <span
                      class="font-[family-name:var(--font-display)] text-[1.32rem] leading-[1.1] font-bold text-[color:var(--color-ink-900)]"
                      lang={title.isFallback ? title.lang : undefined}
                    >
                      {title.value}
                    </span>
                  </a>
                </li>
              );
            })}
          </ol>
        </div>
      </section>
    )
  }

  {
    story && (
      <section aria-label="Story" class="px-[var(--gutter-left)] py-[clamp(88px,9vw,136px)]">
        <StoryQuote lang={lang} story={story} quoteOnly linkProgram />
      </section>
    )
  }

  <CtaBand lang={lang} title={t(lang, 'ctaImpactTitle')} />
</BaseLayout>
