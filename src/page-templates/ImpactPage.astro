---
import type { Locale } from '~/lib/i18n/config';
import { getImpactStats, getPage, getPrograms, getStories } from '~/lib/content';
import { localizePath, pick, t } from '~/lib/i18n/utils';
import { resolveSeo } from '~/lib/seo';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHero from '~/components/content/PageHero.astro';
import ImpactStats from '~/components/content/ImpactStats.astro';
import SectionedBody from '~/components/content/SectionedBody.astro';
import SectionHeading from '~/components/content/SectionHeading.astro';
import ProgramRows from '~/components/content/ProgramRows.astro';
import StoryQuote from '~/components/content/StoryQuote.astro';
import CtaBand from '~/components/content/CtaBand.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const [stats, page, programs, stories] = await Promise.all([
  getImpactStats(),
  getPage('impact'),
  getPrograms(),
  getStories(),
]);

const title = pick(page?.title, lang);
const intro = pick(page?.intro, lang);
const heading = title.value ?? t(lang, 'pageImpact');
const introText = intro.value ?? t(lang, 'introImpact');
const story = stories[0] ? { ...stories[0], body: null } : null;
const seo = resolveSeo(page?.seo, lang, {
  title: heading,
  description: introText,
  image: page?.heroImage,
});
---

<BaseLayout
  headerOverlay
  lang={lang}
  title={seo.title}
  description={seo.description}
  ogImage={seo.ogImage}
  noindex={seo.noindex}
>
  <PageHero
    lang={lang}
    title={heading}
    intro={introText}
    introLang={intro.isFallback ? intro.lang : undefined}
    trail={[{ label: heading }]}
  />

  <div class="bg-white pb-[var(--spacing-section)]">
    {
      stats.length > 0 && (
        <section class="section pb-0">
          <div class="wrap">
            <h2 class="eyebrow">{t(lang, 'resultsAtAGlance')}</h2>
            <div class="mt-5">
              <ImpactStats lang={lang} stats={stats} />
            </div>
            <p class="mt-6">
              <a href={localizePath('/reports', lang)} class="link-arrow">
                {t(lang, 'seeReports')}
                <span class="arrow" aria-hidden="true">→</span>
              </a>
            </p>
          </div>
        </section>
      )
    }

    <SectionedBody lang={lang} body={page?.body} />
  </div>

  {
    programs.length > 0 && (
      <section class="section">
        <div class="wrap">
          <div class="flex flex-wrap items-end justify-between gap-5">
            <SectionHeading title={t(lang, 'ourPrograms')} />
            <a href={localizePath('/programs', lang)} class="link-arrow">
              {t(lang, 'viewAll')}
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          </div>
          <div class="mt-8.5">
            <ProgramRows lang={lang} programs={programs} />
          </div>
        </div>
      </section>
    )
  }

  {
    story && (
      <section class="story-band on-inverse">
        <div class="wrap">
          <StoryQuote lang={lang} story={story} inverse />
        </div>
      </section>
    )
  }

  <CtaBand lang={lang} title={t(lang, 'ctaImpactTitle')} />
</BaseLayout>
