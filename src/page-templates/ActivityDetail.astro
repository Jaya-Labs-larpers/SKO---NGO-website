---
import type { Locale } from '~/lib/i18n/config';
import type { Activity } from '~/lib/content/types';
import { formatDate, localizePath, pick, t } from '~/lib/i18n/utils';
import { activityCategoryLabels, label } from '~/lib/labels';
import { blocksToPlainText } from '~/lib/portable-text';
import { resolveSeo } from '~/lib/seo';
import { siteUrl } from '~/lib/config';
import { hasImage, imageUrl } from '~/lib/sanity/image';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/layout/Breadcrumbs.astro';
import Figure from '~/components/media/Figure.astro';
import RichText from '~/components/content/RichText.astro';
import Icon from '~/components/ui/Icon.astro';

interface Props {
  lang: Locale;
  activity: Activity;
  previous?: Activity | null;
  next?: Activity | null;
}

const { lang, activity, previous, next } = Astro.props;

const title = pick(activity.title, lang);
const excerpt = pick(activity.excerpt, lang);
const heading = title.value ?? '';
const seo = resolveSeo(activity.seo, lang, {
  title: heading,
  description: excerpt.value ?? blocksToPlainText(pick(activity.body, lang).value),
  image: activity.coverImage,
});

const canonical = new URL(localizePath(`/activities/${activity.slug}`, lang), siteUrl).href;
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: heading,
  ...(seo.description ? { description: seo.description } : {}),
  ...(activity.publishedAt ? { datePublished: activity.publishedAt } : {}),
  ...(activity.author ? { author: { '@type': 'Organization', name: activity.author } } : {}),
  ...(activity.coverImage && hasImage(activity.coverImage)
    ? { image: imageUrl(activity.coverImage, { width: 1200 }) }
    : {}),
  inLanguage: lang,
  mainEntityOfPage: canonical,
};

const category = label(activityCategoryLabels, activity.category, lang);
const programTitle = pick(activity.program?.title, lang);
---

<BaseLayout
  lang={lang}
  title={seo.title}
  description={seo.description}
  ogImage={seo.ogImage}
  noindex={seo.noindex}
  publishedAt={activity.publishedAt}
  jsonLd={articleJsonLd}
>
  <article class="wrap pt-6 lg:pt-8">
    <Breadcrumbs lang={lang} trail={[{ label: t(lang, 'pageActivities'), path: '/activities' }, { label: heading }]} />

    <header class="grid gap-x-10 gap-y-6 border-b border-line-ink pt-8 pb-8 lg:grid-cols-12 lg:pt-12 lg:pb-10">
      <p class="flex flex-wrap gap-x-4 gap-y-1 self-end text-[13px] text-ink-400 lg:col-span-3 lg:block lg:[&>span]:mb-2">
        <span class="mono block">
          <time datetime={activity.publishedAt ?? undefined} class="text-ink-900">
            {formatDate(activity.publishedAt, lang)}
          </time>
        </span>
        {category && <span class="mono block text-terracotta-700">{category}</span>}
        {activity.author && <span class="block text-ink-900">{activity.author}</span>}
        {
          activity.program && programTitle.value && (
            <span class="block">
              {t(lang, 'relatedProgram')}:{' '}
              <a
                href={localizePath(`/programs/${activity.program.slug}`, lang)}
                class="text-ink-900"
                lang={programTitle.isFallback ? programTitle.lang : undefined}
              >
                {programTitle.value}
              </a>
            </span>
          )
        }
      </p>
      <h1
        class="text-[length:var(--text-h1)] leading-[var(--text-h1--line-height)] tracking-[var(--text-h1--letter-spacing)] lg:col-span-9"
        lang={title.isFallback ? title.lang : undefined}
      >
        {heading}
      </h1>
    </header>

    <div class="grid gap-x-10 pt-8 lg:grid-cols-12 lg:pt-10">
      <div class="lg:col-span-9 lg:col-start-4">
        <Figure
          image={activity.coverImage}
          lang={lang}
          aspect="16/9"
          eager
          sizes="(min-width: 64rem) 900px, 100vw"
        />

        {
          excerpt.value && (
            <p
              class="mt-8 max-w-[52ch] text-[length:var(--text-lead)] leading-[var(--text-lead--line-height)] text-ink-900"
              lang={excerpt.isFallback ? excerpt.lang : undefined}
            >
              {excerpt.value}
            </p>
          )
        }

        <div class="mt-6"><RichText blocks={activity.body} lang={lang} /></div>

        <nav
          class="mt-12 flex flex-wrap justify-between gap-4 border-t border-line pt-5"
          aria-label={t(lang, 'pageActivities')}
        >
          {
            previous ? (
              <a href={localizePath(`/activities/${previous.slug}`, lang)} class="link text-[15px]" rel="prev">
                <Icon name="arrow-left" size={14} />
                {t(lang, 'previous')}
              </a>
            ) : (
              <span />
            )
          }
          {
            next && (
              <a href={localizePath(`/activities/${next.slug}`, lang)} class="link text-[15px]" rel="next">
                {t(lang, 'next')}
                <Icon name="arrow-right" size={14} />
              </a>
            )
          }
        </nav>
      </div>
    </div>
  </article>
</BaseLayout>
