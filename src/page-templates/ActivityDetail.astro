---
import type { Locale } from '~/lib/i18n/config';
import type { Activity } from '~/lib/content/types';
import { formatDate, localizePath, pick, t } from '~/lib/i18n/utils';
import { blocksToPlainText } from '~/lib/portable-text';
import { resolveSeo } from '~/lib/seo';
import { siteUrl } from '~/lib/config';
import { hasImage, imageUrl } from '~/lib/sanity/image';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/layout/Breadcrumbs.astro';
import ResponsiveImage from '~/components/media/ResponsiveImage.astro';
import RichText from '~/components/content/RichText.astro';

interface Props {
  lang: Locale;
  activity: Activity;
  previous?: Activity | null;
  next?: Activity | null;
}

const { lang, activity, previous, next } = Astro.props;

const title = pick(activity.title, lang);
const excerpt = pick(activity.excerpt, lang);
const heading = title.value ?? '';
const seo = resolveSeo(activity.seo, lang, {
  title: heading,
  description: excerpt.value ?? blocksToPlainText(pick(activity.body, lang).value),
  image: activity.coverImage,
});

const canonical = new URL(localizePath(`/activities/${activity.slug}`, lang), siteUrl).href;
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: heading,
  ...(seo.description ? { description: seo.description } : {}),
  ...(activity.publishedAt ? { datePublished: activity.publishedAt } : {}),
  ...(activity.author ? { author: { '@type': 'Organization', name: activity.author } } : {}),
  ...(activity.coverImage && hasImage(activity.coverImage)
    ? { image: imageUrl(activity.coverImage, { width: 1200 }) }
    : {}),
  inLanguage: lang,
  mainEntityOfPage: canonical,
};

const categoryLabels: Record<string, Record<Locale, string>> = {
  news: { en: 'News', km: 'ព័ត៌មាន' },
  event: { en: 'Event', km: 'ព្រឹត្តិការណ៍' },
  story: { en: 'Story', km: 'រឿងរ៉ាវ' },
  announcement: { en: 'Announcement', km: 'សេចក្តីជូនដំណឹង' },
};
const category = activity.category ? categoryLabels[activity.category]?.[lang] : null;
const programTitle = pick(activity.program?.title, lang);
---

<BaseLayout
  lang={lang}
  title={seo.title}
  description={seo.description}
  ogImage={seo.ogImage}
  noindex={seo.noindex}
  publishedAt={activity.publishedAt}
  jsonLd={articleJsonLd}
>
  <article class="section">
    <div class="wrap max-w-[760px]">
      <Breadcrumbs
        lang={lang}
        trail={[{ label: t(lang, 'pageActivities'), path: '/activities' }, { label: heading }]}
      />

      {category && <span class="chip mt-4">{category}</span>}

      <h1
        class="mt-3.5 text-[length:var(--text-h1)] leading-[var(--text-h1--line-height)] tracking-[var(--text-h1--letter-spacing)]"
        lang={title.isFallback ? title.lang : undefined}
      >
        {heading}
      </h1>

      <p class="mt-3.5 flex flex-wrap items-center gap-2.5 text-[13px] text-[color:var(--color-ink-400)]">
        <time datetime={activity.publishedAt ?? undefined}>{formatDate(activity.publishedAt, lang)}</time>
        {activity.author && <span>· {activity.author}</span>}
        {
          activity.program && programTitle.value && (
            <span>
              ·{' '}
              <a
                href={localizePath(`/programs/${activity.program.slug}`, lang)}
                class="text-[color:var(--color-blue-800)]"
              >
                {programTitle.value}
              </a>
            </span>
          )
        }
      </p>

      <div class="mt-6.5 overflow-hidden rounded-[var(--radius-lg)]">
        <ResponsiveImage
          image={activity.coverImage}
          lang={lang}
          alt=""
          aspect="16/9"
          eager
          sizes="(min-width: 48rem) 760px, 100vw"
        />
      </div>

      {
        excerpt.value && (
          <p
            class="mt-6.5 text-[19px] leading-[1.6] text-[color:var(--color-ink-700)]"
            lang={excerpt.isFallback ? excerpt.lang : undefined}
          >
            {excerpt.value}
          </p>
        )
      }

      <div class="mt-4.5"><RichText blocks={activity.body} lang={lang} /></div>

      <nav
        class="mt-8.5 flex flex-wrap justify-between gap-4 border-t border-[color:var(--color-line)] pt-5.5"
        aria-label={t(lang, 'pageActivities')}
      >
        {
          previous ? (
            <a href={localizePath(`/activities/${previous.slug}`, lang)} class="link-arrow" rel="prev">
              ← {t(lang, 'previous')}
            </a>
          ) : (
            <span />
          )
        }
        {
          next && (
            <a href={localizePath(`/activities/${next.slug}`, lang)} class="link-arrow" rel="next">
              {t(lang, 'next')} →
            </a>
          )
        }
      </nav>
    </div>
  </article>
</BaseLayout>
