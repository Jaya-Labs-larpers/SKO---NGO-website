---
import type { Locale } from '~/lib/i18n/config';
import type { JobPost } from '~/lib/content/types';
import { formatDate, localizePath, pick, t } from '~/lib/i18n/utils';
import { employmentTypeLabels, label } from '~/lib/labels';
import { siteUrl } from '~/lib/config';
import { blocksToPlainText } from '~/lib/portable-text';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/layout/Breadcrumbs.astro';
import RichText from '~/components/content/RichText.astro';
import Icon from '~/components/ui/Icon.astro';

interface Props {
  lang: Locale;
  job: JobPost;
}

const { lang, job } = Astro.props;

const title = pick(job.title, lang);
const location = pick(job.location, lang);
const heading = title.value ?? '';
const description =
  blocksToPlainText(pick(job.description, lang).value) ||
  [heading, location.value].filter(Boolean).join(' · ');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'JobPosting',
  title: heading,
  ...(job.publishedAt ? { datePosted: job.publishedAt } : {}),
  ...(job.deadline ? { validThrough: job.deadline } : {}),
  employmentType: job.employmentType ?? undefined,
  jobLocation: {
    '@type': 'Place',
    address: { '@type': 'PostalAddress', addressLocality: 'Phnom Penh', addressCountry: 'KH' },
  },
  url: new URL(localizePath(`/careers/${job.slug}`, lang), siteUrl).href,
};
---

<BaseLayout lang={lang} title={heading} description={description} jsonLd={jsonLd}>
  <article class="wrap pt-6 lg:pt-8">
    <Breadcrumbs lang={lang} trail={[{ label: t(lang, 'pageCareers'), path: '/careers' }, { label: heading }]} />

    <header class="grid gap-x-10 gap-y-6 border-b border-line-ink pt-8 pb-8 lg:grid-cols-12 lg:pt-12 lg:pb-10">
      <p class="flex flex-wrap gap-x-4 gap-y-1 self-end text-[13px] text-ink-400 lg:col-span-3 lg:block lg:[&>span]:mb-2">
        {
          location.value && (
            <span class="block text-ink-900" lang={location.isFallback ? location.lang : undefined}>
              {location.value}
            </span>
          )
        }
        {
          job.employmentType && (
            <span class="block text-ink-900">
              {label(employmentTypeLabels, job.employmentType, lang) ?? job.employmentType}
            </span>
          )
        }
        {
          job.deadline && (
            <span class="mono block text-terracotta-700">
              {t(lang, 'closesOn')} <time datetime={job.deadline}>{formatDate(job.deadline, lang)}</time>
            </span>
          )
        }
      </p>
      <h1
        class="text-[length:var(--text-h1)] leading-[var(--text-h1--line-height)] tracking-[var(--text-h1--letter-spacing)] lg:col-span-9"
        lang={title.isFallback ? title.lang : undefined}
      >
        {heading}
      </h1>
    </header>

    <div class="grid gap-x-10 pt-8 lg:grid-cols-12 lg:pt-10">
      <div class="lg:col-span-9 lg:col-start-4">
        <RichText blocks={job.description} lang={lang} />

        <div class="mt-10 border-y border-line py-6">
          <RichText blocks={job.howToApply} lang={lang} class="max-w-none text-[15px]" />
        </div>

        <p class="mt-8">
          <a href={localizePath('/careers', lang)} class="link text-[15px]">
            <Icon name="arrow-left" size={14} />
            {t(lang, 'pageCareers')}
          </a>
        </p>
      </div>
    </div>
  </article>
</BaseLayout>
