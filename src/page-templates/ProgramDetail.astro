---
import type { Locale } from '~/lib/i18n/config';
import type { Program } from '~/lib/content/types';
import { pick, t } from '~/lib/i18n/utils';
import { resolveSeo } from '~/lib/seo';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeading from '~/components/content/PageHeading.astro';
import Figure from '~/components/media/Figure.astro';
import ImpactFigures from '~/components/content/ImpactFigures.astro';
import RichText from '~/components/content/RichText.astro';
import CloseBand from '~/components/content/CloseBand.astro';

interface Props {
  lang: Locale;
  program: Program;
}

const { lang, program } = Astro.props;

const title = pick(program.title, lang);
const summary = pick(program.summary, lang);
const heading = title.value ?? '';
const stats = program.impactStats ?? [];
const seo = resolveSeo(program.seo, lang, {
  title: heading,
  description: summary.value,
  image: program.image,
});
---

<BaseLayout
  lang={lang}
  title={seo.title}
  description={seo.description}
  ogImage={seo.ogImage}
  noindex={seo.noindex}
>
  <PageHeading
    lang={lang}
    title={heading}
    titleLang={title.isFallback ? title.lang : undefined}
    intro={summary.value}
    introLang={summary.isFallback ? summary.lang : undefined}
    trail={[{ label: t(lang, 'pagePrograms'), path: '/programs' }, { label: heading }]}
  />

  <section class="wrap pt-8 lg:pt-10">
    <Figure image={program.image} lang={lang} aspect="21/9" eager sizes="(min-width: 80rem) 1280px, 100vw" />
  </section>

  {
    stats.length > 0 && (
      <section class="wrap mt-[var(--spacing-section)]">
        <div class="ledger">
          <h2 class="text-[length:var(--text-h2)] leading-[var(--text-h2--line-height)] tracking-[var(--text-h2--letter-spacing)]">
            {t(lang, 'pageImpact')}
          </h2>
          <div>
            <ImpactFigures lang={lang} stats={stats} />
            <p class="mt-4 max-w-[62ch] text-[15px] text-ink-600">
              <b class="font-medium text-ink-900">{t(lang, 'methodologyTitle')}</b> {t(lang, 'methodologyBody')}
            </p>
          </div>
        </div>
      </section>
    )
  }

  <section class="wrap">
    <div
      class:list={[
        'grid gap-x-10 lg:grid-cols-12',
        stats.length > 0 ? 'border-t border-line pt-[var(--spacing-section)]' : 'pt-10 lg:pt-14',
      ]}
    >
      <div class="lg:col-span-8 lg:col-start-5">
        <RichText blocks={program.body} lang={lang} />
      </div>
    </div>
  </section>

  <CloseBand lang={lang} title={t(lang, 'ctaProgramTitle')} />
</BaseLayout>
