---
import type { Locale } from '~/lib/i18n/config';
import type { Program } from '~/lib/content/types';
import { pick, t } from '~/lib/i18n/utils';
import { resolveSeo } from '~/lib/seo';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/layout/Breadcrumbs.astro';
import ResponsiveImage from '~/components/media/ResponsiveImage.astro';
import ImpactStats from '~/components/content/ImpactStats.astro';
import RichText from '~/components/content/RichText.astro';
import CtaBand from '~/components/content/CtaBand.astro';

interface Props {
  lang: Locale;
  program: Program;
}

const { lang, program } = Astro.props;

const title = pick(program.title, lang);
const summary = pick(program.summary, lang);
const heading = title.value ?? '';
const stats = program.impactStats ?? [];
const seo = resolveSeo(program.seo, lang, {
  title: heading,
  description: summary.value,
  image: program.image,
});
---

<BaseLayout
  lang={lang}
  title={seo.title}
  description={seo.description}
  ogImage={seo.ogImage}
  noindex={seo.noindex}
>
  <div class="border-b border-[color:var(--color-line-subtle)]">
    <ResponsiveImage image={program.image} lang={lang} alt="" aspect="21/9" eager sizes="100vw" />
  </div>

  <section class="section">
    <div class="wrap">
      <Breadcrumbs
        lang={lang}
        trail={[{ label: t(lang, 'pagePrograms'), path: '/programs' }, { label: heading }]}
      />
      <div class="rule-accent mt-4"></div>
      <h1
        class="mt-3 text-[length:var(--text-h1)] leading-[var(--text-h1--line-height)] tracking-[var(--text-h1--letter-spacing)]"
        lang={title.isFallback ? title.lang : undefined}
      >
        {heading}
      </h1>
      {
        summary.value && (
          <p
            class="mt-3 max-w-[56ch] text-[length:var(--text-lead)] text-[color:var(--color-ink-400)]"
            lang={summary.isFallback ? summary.lang : undefined}
          >
            {summary.value}
          </p>
        )
      }

      {stats.length > 0 && <div class="mt-7.5"><ImpactStats lang={lang} stats={stats} columns={3} /></div>}

      <div class="mt-8.5"><RichText blocks={program.body} lang={lang} /></div>
    </div>
  </section>

  <CtaBand lang={lang} title={t(lang, 'ctaProgramTitle')} />
</BaseLayout>
