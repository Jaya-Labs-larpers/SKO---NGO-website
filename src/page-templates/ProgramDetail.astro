---
import type { Locale } from '~/lib/i18n/config';
import type { Program } from '~/lib/content/types';
import { getPartners, getPrograms } from '~/lib/content';
import { ACTIVITY_LIMITS } from '~/lib/content/sections';
import { localizePath, pick, t } from '~/lib/i18n/utils';
import { resolveSeo } from '~/lib/seo';
import { serviceJsonLd } from '~/lib/seo/page-schema';
import BaseLayout from '~/layouts/BaseLayout.astro';
import ResponsiveImage from '~/components/media/ResponsiveImage.astro';
import ProgramStats from '~/components/content/ProgramStats.astro';
import SectionedBody from '~/components/content/SectionedBody.astro';
import ProgramRows from '~/components/content/ProgramRows.astro';
import Breadcrumbs from '~/components/layout/Breadcrumbs.astro';
import Icon from '~/components/Icon.astro';
import CtaBand from '~/components/content/CtaBand.astro';

interface Props {
  lang: Locale;
  program: Program;
}

const { lang, program } = Astro.props;

const [programs, partners] = await Promise.all([getPrograms(), getPartners()]);

const title = pick(program.title, lang);
const summary = pick(program.summary, lang);
const heading = title.value ?? '';
const stats = program.impactStats ?? [];
const position = programs.findIndex((entry) => entry.slug === program.slug) + 1;
const others = programs.filter((entry) => entry.slug !== program.slug);
const pad = (n: number) => String(n).padStart(2, '0');

const seo = resolveSeo(program.seo, lang, {
  title: heading,
  description: summary.value,
  image: program.image,
});
const service = serviceJsonLd({
  slug: program.slug,
  pathname: Astro.url.pathname,
  name: heading,
  description: seo.description,
});
---

<BaseLayout
  lang={lang}
  title={seo.title}
  description={seo.description}
  ogImage={seo.ogImage}
  noindex={seo.noindex}
  jsonLd={service}
  lcpImage={program.image}
>
  <section
    aria-labelledby="page-title"
    class="mx-auto flex max-w-[var(--container-page)] flex-col gap-10 px-[var(--gutter-left)] pt-10 pb-[clamp(56px,6vw,88px)]"
  >
    <Breadcrumbs
      lang={lang}
      trail={[{ label: t(lang, 'pagePrograms'), path: '/programs' }, { label: heading }]}
    />
    <div class="flex flex-col gap-5">
      {
        position > 0 && (
          <p class="eyebrow !text-[15px] !text-[color:var(--color-blue-700)]">
            {t(lang, 'programLabel')} {pad(position)} / {pad(programs.length)}
          </p>
        )
      }
      <h1
        id="page-title"
        class="t-lg m-0 max-w-[16ch]"
        style="font-size:calc(clamp(2.45rem,5.32vw,5.425rem)*var(--display-scale))"
        lang={title.isFallback ? title.lang : undefined}
      >
        {heading}
      </h1>
    </div>
    <div
      class="rule-top grid [grid-template-columns:repeat(auto-fit,minmax(min(100%,440px),1fr))] items-end gap-x-[clamp(48px,6vw,96px)] gap-y-8 pt-8"
    >
      <p class="t-lead-sm m-0 font-medium" lang={summary.isFallback ? summary.lang : undefined}>
        {summary.value}
      </p>
      <a href={localizePath('/contact', lang)} class="btn btn-primary btn-lg justify-self-start">
        {t(lang, 'contactUs')}
      </a>
    </div>
  </section>

  <div class="h-[clamp(360px,44vw,640px)]">
    <ResponsiveImage image={program.image} lang={lang} alt="" aspect="16/9" eager sizes="100vw" />
  </div>

  {
    stats.length > 0 && (
      <section
        aria-labelledby="results-title"
        class="on-navy bg-[color:var(--color-blue-900)] px-[var(--gutter-left)] py-[clamp(80px,8vw,120px)] text-white"
      >
        <div class="mx-auto flex max-w-[var(--container-inner)] flex-col gap-12">
          <h2 id="results-title" class="eyebrow">
            {t(lang, 'resultsAtAGlance')}
          </h2>
          <ProgramStats lang={lang} stats={stats} />
        </div>
      </section>
    )
  }

  <SectionedBody
    lang={lang}
    body={program.body}
    limits={ACTIVITY_LIMITS}
    partners={partners}
    variant="program"
  />

  {
    others.length > 0 && (
      <section
        aria-labelledby="other-title"
        class="mx-auto flex max-w-[var(--container-page)] flex-col gap-10 px-[var(--gutter-left)] py-[clamp(88px,9vw,128px)]"
      >
        <div class="flex flex-wrap items-end justify-between gap-6">
          <h2 id="other-title" class="t-xs m-0">
            {t(lang, 'otherPrograms')}
          </h2>
          <a href={localizePath('/programs', lang)} class="link-arrow">
            {t(lang, 'viewAll')}
            <Icon name="arrow-right" size={18} />
          </a>
        </div>
        <ProgramRows lang={lang} programs={programs} exclude={program.slug} variant="cards" />
      </section>
    )
  }

  <CtaBand lang={lang} title={t(lang, 'ctaProgramTitle')} />
</BaseLayout>
