---
import type { Locale } from '~/lib/i18n/config';
import { getSiteSettings } from '~/lib/content';
import { t } from '~/lib/i18n/utils';
import { donationDetails } from '~/lib/donation';
import { encodeQr, qrSvgPath } from '~/lib/qr';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHero from '~/components/content/PageHero.astro';
import FaqSection from '~/components/content/FaqSection.astro';
import CopyButton from '~/components/content/CopyButton.astro';
import Icon from '~/components/Icon.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const settings = await getSiteSettings();
const { accountName, accounts, bank, isPlaceholder } = donationDetails;
const heading = t(lang, 'pageDonate');
const description = `${t(lang, 'donateHeroIntro')} ${t(lang, 'noCardNotice')}`;
const QUIET_ZONE = 4;

/**
 * No card fields, no payment SDK, no iframes: static KHQR codes and bank
 * details only, rendered here at build time from the validated payloads.
 */
const cards = accounts.map((account) => {
  const matrix = encodeQr(account.khqr);
  const slug = account.currency.toLowerCase();
  return {
    ...account,
    slug,
    popoverId: `khqr-${slug}-large`,
    viewBox: `0 0 ${matrix.length + QUIET_ZONE * 2} ${matrix.length + QUIET_ZONE * 2}`,
    path: qrSvgPath(matrix, QUIET_ZONE),
    label: t(lang, 'donateQrLabel').replace('{currency}', account.currency),
  };
});
const copyable = (value: string) => value.replace(/\s+/g, '');
const termClass = 'eyebrow !text-xs';
const valueClass =
  'm-0 flex items-center justify-between gap-3 font-[family-name:var(--font-display)] text-xl font-bold tracking-[0.04em]';
---

<BaseLayout analytics={false} lang={lang} title={heading} description={description}>
  <PageHero
    dark
    size="xl"
    lang={lang}
    title={t(lang, 'donateHeroTitle')}
    intro={description}
    trail={[{ label: heading }]}
  />

  {
    isPlaceholder && (
      <p
        role="note"
        class="m-0 flex items-center justify-center gap-3 border-b border-[#f3c7c1] bg-[color:var(--color-danger-50)] px-[var(--gutter-left)] py-4 text-[15px] font-semibold text-[color:var(--color-danger-700)]"
      >
        <Icon name="exclamation-triangle" size={18} class="flex-none" />
        {t(lang, 'donatePlaceholder')}
      </p>
    )
  }

  <section
    aria-labelledby="scan-title"
    class="mx-auto flex max-w-[var(--container-page)] flex-col gap-12 px-[var(--gutter-left)] py-[clamp(80px,8vw,120px)]"
  >
    <div
      class="grid [grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr))] items-end gap-x-[clamp(48px,6vw,96px)] gap-y-6"
    >
      <h2 id="scan-title" class="t-lg m-0">{t(lang, 'scanToGive')}</h2>
      <p class="m-0 max-w-[44ch] text-xl leading-normal">{t(lang, 'scanToGiveIntro')}</p>
    </div>
    <ul
      class="m-0 grid list-none [grid-template-columns:repeat(auto-fit,minmax(min(100%,480px),1fr))] gap-8 p-0"
    >
      {
        cards.map((card) => (
          <li class="grid [grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr))] gap-8 rounded-[var(--radius-lg)] border border-t-[6px] border-[color:var(--color-line-strong)] border-t-[color:var(--color-blue-700)] p-[clamp(24px,3vw,40px)]">
            <div class="flex flex-col gap-3">
              <h3 class="eyebrow m-0 !text-[15px] !text-[color:var(--color-blue-700)]">
                KHQR · {card.currency}
              </h3>
              <button
                type="button"
                popovertarget={card.popoverId}
                class="flex w-full cursor-zoom-in flex-col items-center gap-2.5 rounded-[var(--radius-md)] border-0 bg-white p-4 shadow-[inset_0_0_0_1px_var(--color-line-strong)]"
              >
                <svg
                  viewBox={card.viewBox}
                  role="img"
                  aria-label={card.label}
                  shape-rendering="crispEdges"
                  class="block h-auto w-full"
                >
                  <rect width="100%" height="100%" fill="#fff" />
                  <path d={card.path} fill="#000" />
                </svg>
                <span class="text-sm font-semibold text-[color:var(--color-blue-700)]">
                  {t(lang, 'tapToEnlarge')}
                </span>
              </button>
            </div>
            <div class="flex min-w-0 flex-col gap-5">
              <p class="m-0 flex items-start gap-2.5 rounded-[var(--radius-md)] bg-[color:var(--color-blue-50)] px-4 py-3.5 text-[15px] leading-normal">
                <Icon
                  name="information-circle"
                  size={18}
                  class="mt-0.5 flex-none text-[color:var(--color-blue-700)]"
                />
                <span>
                  {t(lang, 'donateCheckName')} <strong>{accountName}</strong>
                </span>
              </p>
              <dl class="m-0 flex flex-col">
                <div class="flex flex-col border-t border-[color:var(--color-line)] py-3">
                  <dt class={termClass}>{t(lang, 'accountName')}</dt>
                  <dd class="m-0 font-semibold">{accountName}</dd>
                </div>
                <div class="flex flex-col border-y border-[color:var(--color-line)] py-3">
                  <dt class={termClass}>{t(lang, 'accountNumber')}</dt>
                  <dd class={valueClass}>
                    <span class="break-all">{card.accountNumber}</span>
                    <CopyButton lang={lang} value={copyable(card.accountNumber)} />
                  </dd>
                </div>
              </dl>
              <div class="flex flex-col items-start gap-3">
                {card.abaLink && (
                  <a href={card.abaLink} class="btn btn-primary" rel="noopener noreferrer">
                    {t(lang, 'donateOpenAba')}
                  </a>
                )}
                <a
                  href={`/khqr/${card.slug}.png`}
                  download={`sko-donate-khqr-${card.slug}.png`}
                  class={card.abaLink ? 'btn btn-secondary' : 'btn btn-primary'}
                >
                  <Icon name="arrow-down-tray" size={18} />
                  {t(lang, 'donateSaveQr')}
                </a>
                <p class="m-0 text-sm text-[color:var(--color-ink-400)]">
                  {t(lang, 'donateSaveHint')}
                </p>
              </div>
            </div>

            <div
              id={card.popoverId}
              popover
              class="m-auto w-[min(92vw,520px)] rounded-[var(--radius-lg)] border-0 bg-white p-5 shadow-[var(--shadow-md)] backdrop:bg-black/60"
            >
              <p class="eyebrow m-0 text-center">KHQR · {card.currency}</p>
              <svg
                viewBox={card.viewBox}
                role="img"
                aria-label={card.label}
                shape-rendering="crispEdges"
                class="mt-3 block h-auto w-full"
              >
                <rect width="100%" height="100%" fill="#fff" />
                <path d={card.path} fill="#000" />
              </svg>
              <p class="mt-3 text-center text-[15px]">
                {t(lang, 'donateCheckName')} <strong>{accountName}</strong>
              </p>
              <button
                type="button"
                popovertarget={card.popoverId}
                popovertargetaction="hide"
                class="btn btn-secondary btn-block mt-4"
              >
                {t(lang, 'close')}
              </button>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="wire-title" class="band band--tint !py-[clamp(80px,8vw,120px)]">
    <div
      class="wrap-inner grid [grid-template-columns:repeat(auto-fit,minmax(min(100%,360px),1fr))] gap-x-[clamp(48px,6vw,96px)] gap-y-10"
    >
      <div class="flex flex-col gap-5">
        <h2 id="wire-title" class="t-sm m-0">{t(lang, 'bankTransfer')}</h2>
        <p class="m-0 text-xl">{t(lang, 'bankTransferIntro')}</p>
      </div>
      <dl
        class="rule-top m-0 grid min-w-0 [grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr))] gap-x-10 md:col-span-2"
      >
        <div class="flex flex-col gap-1 border-b border-[color:var(--color-blue-200)] py-[18px]">
          <dt class={termClass}>{t(lang, 'accountName')}</dt>
          <dd class="m-0 text-[19px] font-semibold">{accountName}</dd>
        </div>
        <div class="flex flex-col gap-1 border-b border-[color:var(--color-blue-200)] py-[18px]">
          <dt class={termClass}>{t(lang, 'bankName')}</dt>
          <dd class="m-0 text-[19px] font-semibold">{bank.name}</dd>
        </div>
        {
          accounts.map((account) => (
            <div class="flex flex-col gap-1 border-b border-[color:var(--color-blue-200)] py-[18px]">
              <dt class={termClass}>
                {t(lang, 'accountNumber')} ({account.currency})
              </dt>
              <dd class={valueClass}>
                <span class="break-all">{account.accountNumber}</span>
                <CopyButton lang={lang} value={copyable(account.accountNumber)} />
              </dd>
            </div>
          ))
        }
        <div class="flex flex-col gap-1 border-b border-[color:var(--color-blue-200)] py-[18px]">
          <dt class={termClass}>{t(lang, 'swift')}</dt>
          <dd class={valueClass}>
            <span>{bank.swift}</span>
            <CopyButton lang={lang} value={bank.swift} />
          </dd>
        </div>
        <div class="flex flex-col gap-1 border-b border-[color:var(--color-blue-200)] py-[18px]">
          <dt class={termClass}>{t(lang, 'bankAddress')}</dt>
          <dd class="m-0 text-[19px] font-semibold">{bank.address}</dd>
        </div>
      </dl>
    </div>
  </section>

  {
    settings.donationFaqs && settings.donationFaqs.length > 0 && (
      <FaqSection lang={lang} faqs={settings.donationFaqs} />
    )
  }

  <script is:inline src="/donate.js" defer></script>
</BaseLayout>
