---
import type { Locale } from '~/lib/i18n/config';
import { getSiteSettings } from '~/lib/content';
import { localizePath, pick, t } from '~/lib/i18n/utils';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeading from '~/components/content/PageHeading.astro';
import ResponsiveImage from '~/components/media/ResponsiveImage.astro';
import RichText from '~/components/content/RichText.astro';
import FaqSection from '~/components/content/FaqSection.astro';
import Icon from '~/components/ui/Icon.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const settings = await getSiteSettings();
const donation = settings.donation ?? {};
const qrCodes = donation.qrCodes ?? [];
const accounts = donation.bankAccounts ?? [];
const allocation = donation.allocation ?? [];
const heading = t(lang, 'pageDonate');

/**
 * No card fields, no payment SDK, no iframes — QR images and bank details only.
 * The site carries zero PCI scope by construction.
 */
const h2 =
  'text-[length:var(--text-h2)] leading-[var(--text-h2--line-height)] tracking-[var(--text-h2--letter-spacing)]';

/** Mirrors the readiness check: these are not bank details, they are gaps. */
const usable = (value: string | null | undefined) =>
  Boolean(value && value.trim() && !/^(N\/A|TBD|TODO)$/i.test(value.trim()) && !/\[(NEEDS SKO|PLACEHOLDER)/i.test(value));
---

<BaseLayout lang={lang} title={heading} description={t(lang, 'noCardNotice')}>
  <PageHeading
    lang={lang}
    title={t(lang, 'donateHeroTitle')}
    intro={t(lang, 'donateHeroIntro')}
    trail={[{ label: heading }]}
    display
  >
    <p class="mono flex items-center gap-2 py-4 text-ink-900">
      <Icon name="check" size={14} class="text-success-700" />
      {t(lang, 'noCardNotice')}
    </p>
  </PageHeading>

  {
    qrCodes.length > 0 && (
      <section class="wrap">
        <div class="ledger">
          <h2 class={h2}>{t(lang, 'scanToGive')}</h2>
          <ul class="grid list-none gap-8 p-0 sm:grid-cols-2">
            {qrCodes.map((qr) => {
              const label = pick(qr.label, lang);
              const instructions = pick(qr.instructions, lang);
              return (
                <li>
                  <div class="max-w-[16rem]">
                    <ResponsiveImage image={qr.image} lang={lang} alt="" aspect="1/1" sizes="256px" placeholder="[QR code]" />
                  </div>
                  <p class="mt-3 max-w-[16rem] border-t border-line pt-3">
                    <span class="block text-[15px] font-medium text-ink-900" lang={label.isFallback ? label.lang : undefined}>
                      {label.value}
                    </span>
                    {instructions.value && (
                      <span class="mt-1 block text-[13px] text-ink-400" lang={instructions.isFallback ? instructions.lang : undefined}>
                        {instructions.value}
                      </span>
                    )}
                  </p>
                </li>
              );
            })}
          </ul>
        </div>
      </section>
    )
  }

  <section class="wrap">
    <div class="ledger">
      <h2 class={h2}>{t(lang, 'bankTransfer')}</h2>
      <div>
        {
          accounts.map((account) => (
            <dl class="border-b border-line">
              {(
                [
                  [t(lang, 'accountName'), account.accountName],
                  [t(lang, 'accountNumber'), account.accountNumber],
                  [t(lang, 'bankName'), account.bankName],
                  [t(lang, 'swift'), account.swift],
                  [t(lang, 'bankAddress'), account.branchAddress],
                  [t(lang, 'currency'), account.currency],
                ] as [string, string | null | undefined][]
              )
                .filter(([, value]) => Boolean(value))
                .map(([label, value]) => (
                  <div class="grid gap-x-6 gap-y-1 border-t border-line py-3.5 sm:grid-cols-[11rem_minmax(0,1fr)_auto] sm:items-center">
                    <dt class="label">{label}</dt>
                    <dd class:list={['m-0 font-mono text-[15px] break-all', usable(value) ? 'text-ink-900' : 'text-ink-400']}>
                      {usable(value) ? value : '[NEEDS SKO]'}
                    </dd>
                    <dd class="m-0 sm:justify-self-end">
                      {usable(value) && <button
                        type="button"
                        class="inline-flex min-h-11 min-w-11 items-center gap-1.5 border border-line-strong bg-transparent px-3 text-[13px] font-medium text-indigo-700 hover:border-indigo-700"
                        data-copy={value}
                        data-copied-label={t(lang, 'copied')}
                      >
                        {t(lang, 'copy')}
                      </button>}
                    </dd>
                  </div>
                ))}
            </dl>
          ))
        }
        <RichText blocks={donation.note} lang={lang} class="mt-5 text-[15px]" />
      </div>
    </div>
  </section>

  {
    allocation.length > 0 && (
      <section class="wrap">
        <div class="ledger">
          <h2 class={h2}>{t(lang, 'whereMoneyGoes')}</h2>
          <ul class="list-none border-b border-line p-0">
            {allocation.map((item) => {
              const label = pick(item.label, lang);
              const note = pick(item.note, lang);
              return (
                <li class="grid gap-x-6 gap-y-1 border-t border-line py-4 sm:grid-cols-[5rem_minmax(0,1fr)]">
                  <span class="text-[length:var(--text-h3)] font-semibold text-ink-900 tabular-nums">{item.percent}%</span>
                  <span>
                    <span class="block text-[15px] font-medium text-ink-900" lang={label.isFallback ? label.lang : undefined}>
                      {label.value}
                    </span>
                    {note.value && (
                      <span class="mt-1 block text-[13px] text-ink-400" lang={note.isFallback ? note.lang : undefined}>
                        {note.value}
                      </span>
                    )}
                  </span>
                </li>
              );
            })}
          </ul>
          <p class="mt-5 text-[15px] lg:col-start-2">
            <a href={localizePath('/reports', lang)} class="link">
              {t(lang, 'seeReports')}
              <Icon name="arrow-right" size={14} />
            </a>
          </p>
        </div>
      </section>
    )
  }

  {
    settings.donationFaqs && settings.donationFaqs.length > 0 && (
      <FaqSection lang={lang} faqs={settings.donationFaqs} />
    )
  }
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
    button.addEventListener('click', async () => {
      const value = button.dataset.copy;
      if (!value) return;
      try {
        await navigator.clipboard.writeText(value);
        const original = button.textContent;
        button.textContent = button.dataset.copiedLabel ?? 'Copied';
        window.setTimeout(() => {
          button.textContent = original;
        }, 1800);
      } catch {
        // Clipboard blocked — the value is on screen and selectable anyway.
      }
    });
  });
</script>
