---
import type { Locale } from '~/lib/i18n/config';
import { getPrograms } from '~/lib/content';
import { localizePath, pick, t } from '~/lib/i18n/utils';
import InlineLinks from '~/components/content/InlineLinks.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/layout/Breadcrumbs.astro';
import ProgramArticle from '~/components/content/ProgramArticle.astro';
import IndexList from '~/components/content/IndexList.astro';
import EmptyState from '~/components/content/EmptyState.astro';
import CtaBand from '~/components/content/CtaBand.astro';
import { stripInlineLinks } from '~/lib/inline-links';
import { canonicalUrl, collectionPageJsonLd } from '~/lib/seo/page-schema';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const programs = await getPrograms();
const heading = t(lang, 'pagePrograms');
const title = t(lang, 'seoPrograms') || heading;
const description = t(lang, 'metaPrograms') || stripInlineLinks(t(lang, 'introPrograms'));
const collection = collectionPageJsonLd({
  pathname: Astro.url.pathname,
  name: title,
  description,
  items: programs.map((program) => ({
    name: pick(program.title, lang).value ?? '',
    url: canonicalUrl(localizePath(`/programs/${program.slug}`, lang)),
  })),
});
---

<BaseLayout lang={lang} title={title} description={description} jsonLd={collection}>
  <section
    aria-labelledby="page-title"
    class="mx-auto flex max-w-[var(--container-page)] flex-col gap-12 px-[var(--gutter-left)] pt-10 pb-[clamp(72px,7vw,112px)]"
  >
    <Breadcrumbs lang={lang} trail={[{ label: heading }]} />
    <div
      class="grid [grid-template-columns:repeat(auto-fit,minmax(min(100%,460px),1fr))] items-start gap-x-[clamp(48px,6vw,96px)] gap-y-12"
    >
      <div class="flex flex-col gap-8">
        <h1
          id="page-title"
          class="t-xl m-0"
          style="font-size:calc(clamp(2.8rem,5.88vw,5.95rem)*var(--display-scale))"
        >
          {heading}
        </h1>
        <p class="inline-links t-lead m-0 max-w-[40ch]">
          <InlineLinks text={t(lang, 'introPrograms')} />
        </p>
      </div>
      {
        programs.length > 0 && (
          <div class="flex flex-col items-start gap-6 self-end">
            <IndexList
              label={t(lang, 'ourPrograms')}
              items={programs.map((program) => {
                const title = pick(program.title, lang);
                return {
                  href: `#${program.slug}`,
                  label: title.value ?? '',
                  lang: title.isFallback ? title.lang : undefined,
                };
              })}
            />
            <a href={localizePath('/contact', lang)} class="btn btn-primary">
              {t(lang, 'contactUs')}
            </a>
          </div>
        )
      }
    </div>
  </section>

  {
    programs.length === 0 ? (
      <div class="wrap section">
        <EmptyState message={t(lang, 'emptyGeneric')} />
      </div>
    ) : (
      <section aria-labelledby="programs-title">
        <h2
          id="programs-title"
          class="t-sm m-0 bg-[color:var(--color-blue-200)] px-[var(--gutter-left)] py-[clamp(48px,5vw,72px)] !text-[color:var(--color-blue-750)]"
          style="font-size:calc(clamp(1.75rem,3.78vw,3.675rem)*var(--display-scale))"
        >
          {t(lang, 'programsSectionTitle')}
        </h2>
        {programs.map((program, index) => (
          <ProgramArticle lang={lang} program={program} index={index} />
        ))}
      </section>
    )
  }
  <CtaBand lang={lang} title={t(lang, 'ctaProgramsTitle')} />
</BaseLayout>
