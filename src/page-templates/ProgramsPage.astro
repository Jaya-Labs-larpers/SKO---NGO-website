---
import type { Locale } from '~/lib/i18n/config';
import { getPrograms } from '~/lib/content';
import { t } from '~/lib/i18n/utils';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHero from '~/components/content/PageHero.astro';
import ProgramCard from '~/components/content/ProgramCard.astro';
import EmptyState from '~/components/content/EmptyState.astro';
import CtaBand from '~/components/content/CtaBand.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const programs = await getPrograms();
const heading = t(lang, 'pagePrograms');
---

<BaseLayout lang={lang} title={heading} description={t(lang, 'introPrograms')}>
  <PageHero
    lang={lang}
    title={heading}
    intro={t(lang, 'introPrograms')}
    trail={[{ label: heading }]}
  />
  <section class="section">
    <div class="wrap">
      {
        programs.length === 0 ? (
          <EmptyState message={t(lang, 'emptyGeneric')} />
        ) : (
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {programs.map((program) => (
              <ProgramCard lang={lang} program={program} />
            ))}
          </div>
        )
      }
    </div>
  </section>
  <CtaBand lang={lang} title={t(lang, 'ctaProgramsTitle')} />
</BaseLayout>
