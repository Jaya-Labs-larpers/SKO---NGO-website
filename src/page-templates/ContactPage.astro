---
import type { Locale } from '~/lib/i18n/config';
import { getSiteSettings } from '~/lib/content';
import { pick, t } from '~/lib/i18n/utils';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHero from '~/components/content/PageHero.astro';
import ContactForm from '~/components/forms/ContactForm.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const settings = await getSiteSettings();
const address = pick(settings.address, lang);
const hours = pick(settings.officeHours, lang);
const safeguarding = pick(settings.safeguardingContact, lang);
const heading = t(lang, 'pageContact');
---

<BaseLayout lang={lang} title={heading} description={t(lang, 'introContact')}>
  <PageHero lang={lang} title={heading} trail={[{ label: heading }]} />

  <section class="section">
    <div class="wrap grid items-start gap-9 lg:grid-cols-2">
      <div>
        <a
          href={settings.mapUrl ?? '#'}
          rel="noopener noreferrer"
          target="_blank"
          class="block overflow-hidden rounded-[var(--radius-lg)] border border-[color:var(--color-line)] no-underline"
        >
          <div class="media-placeholder aspect-4/3 w-full">{t(lang, 'mapPlaceholder')}</div>
        </a>

        <div class="mt-4.5 text-[15px]">
          {
            address.value && (
              <p class="whitespace-pre-line" lang={address.isFallback ? address.lang : undefined}>
                <b class="mb-1.5 block text-[color:var(--color-ink-900)]">
                  {t(lang, 'footerContactHeading')}
                </b>
                {address.value}
              </p>
            )
          }
          <p class="mt-3.5">
            {settings.phone && <span class="block">{settings.phone}</span>}
            {
              settings.email && (
                <a href={`mailto:${settings.email}`} class="text-[color:var(--color-blue-800)]">
                  {settings.email}
                </a>
              )
            }
            {
              hours.value && (
                <span class="mt-1 block text-[color:var(--color-ink-400)]" lang={hours.isFallback ? hours.lang : undefined}>
                  {hours.value}
                </span>
              )
            }
          </p>
        </div>
      </div>

      <ContactForm lang={lang} variant="general" fallbackEmail={settings.email} />
    </div>

    {
      safeguarding.value && (
        <div class="wrap">
          <p
            class="mt-6.5 rounded-r-[var(--radius-md)] border-l-[3px] border-[color:var(--color-blue-700)] bg-[color:var(--color-aqua-50)] px-4.5 py-4 text-[14.5px] text-[color:var(--color-ink-700)]"
            lang={safeguarding.isFallback ? safeguarding.lang : undefined}
          >
            {safeguarding.value}
          </p>
        </div>
      )
    }
  </section>
</BaseLayout>
