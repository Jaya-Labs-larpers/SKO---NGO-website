---
import type { Locale } from '~/lib/i18n/config';
import { getSiteSettings } from '~/lib/content';
import { pick, t } from '~/lib/i18n/utils';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeading from '~/components/content/PageHeading.astro';
import ContactForm from '~/components/forms/ContactForm.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const settings = await getSiteSettings();
const address = pick(settings.address, lang);
const hours = pick(settings.officeHours, lang);
const safeguarding = pick(settings.safeguardingContact, lang);
const heading = t(lang, 'pageContact');
---

<BaseLayout lang={lang} title={heading} description={t(lang, 'introContact')}>
  <PageHeading lang={lang} title={heading} intro={t(lang, 'introContact')} trail={[{ label: heading }]} />

  <section class="wrap grid items-start gap-x-10 gap-y-10 pt-10 lg:grid-cols-12 lg:pt-14">
    <div class="lg:col-span-5">
      <dl class="border-b border-line">
        {
          address.value && (
            <div class="grid gap-x-6 gap-y-1 border-t border-line py-4 sm:grid-cols-[7rem_minmax(0,1fr)]">
              <dt class="label">{t(lang, 'footerContactHeading')}</dt>
              <dd class="m-0 whitespace-pre-line text-ink-900" lang={address.isFallback ? address.lang : undefined}>
                {address.value}
              </dd>
            </div>
          )
        }
        {
          (settings.phone || settings.email || hours.value) && (
            <div class="grid gap-x-6 gap-y-1 border-t border-line py-4 sm:grid-cols-[7rem_minmax(0,1fr)]">
              <dt class="label">{t(lang, 'formEmail')}</dt>
              <dd class="m-0">
                {settings.email && <a href={`mailto:${settings.email}`} class="block">{settings.email}</a>}
                {settings.phone && <a href={`tel:${settings.phone.replace(/\s+/g, '')}`} class="block">{settings.phone}</a>}
                {hours.value && (
                  <span class="mt-1 block text-[15px] text-ink-400" lang={hours.isFallback ? hours.lang : undefined}>
                    {hours.value}
                  </span>
                )}
              </dd>
            </div>
          )
        }
      </dl>

      {
        settings.mapUrl && (
          <a href={settings.mapUrl} rel="noopener noreferrer" target="_blank" class="mt-6 block no-underline">
            <span class="media-placeholder aspect-[3/2] w-full">{t(lang, 'mapPlaceholder')}</span>
          </a>
        )
      }

      {
        safeguarding.value && (
          <p
            class="mt-8 border-t border-terracotta-700 pt-4 text-[15px] text-ink-900"
            lang={safeguarding.isFallback ? safeguarding.lang : undefined}
          >
            {safeguarding.value}
          </p>
        )
      }
    </div>

    <div class="lg:col-span-6 lg:col-start-7">
      <ContactForm lang={lang} variant="general" fallbackEmail={settings.email} />
    </div>
  </section>
</BaseLayout>
