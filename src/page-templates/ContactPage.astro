---
import type { Locale } from '~/lib/i18n/config';
import { getSiteSettings } from '~/lib/content';
import { pick, t } from '~/lib/i18n/utils';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHero from '~/components/content/PageHero.astro';
import ContactForm from '~/components/forms/ContactForm.astro';
import Icon from '~/components/Icon.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const settings = await getSiteSettings();
const address = pick(settings.address, lang);
const hours = pick(settings.officeHours, lang);
const safeguarding = pick(settings.safeguardingContact, lang);
const heading = t(lang, 'pageContact');
---

<BaseLayout lang={lang} title={heading} description={t(lang, 'introContact')}>
  <PageHero lang={lang} title={heading} trail={[{ label: heading }]} />

  <section class="section">
    <div class="wrap grid items-start gap-9 lg:grid-cols-2">
      <div>
        <a
          href={settings.mapUrl ?? '#'}
          rel="noopener noreferrer"
          target="_blank"
          class="block overflow-hidden rounded-[var(--radius-lg)] border border-[color:var(--color-line)] no-underline"
        >
          <div class="media-placeholder aspect-4/3 w-full">{t(lang, 'mapPlaceholder')}</div>
        </a>
        {
          settings.mapUrl && (
            <a
              href={settings.mapUrl}
              rel="noopener noreferrer"
              target="_blank"
              class="link-arrow mt-2.5 inline-flex"
            >
              {t(lang, 'viewOnGoogleMaps')}
              <Icon name="arrow-top-right-on-square" size={16} class="arrow" />
            </a>
          )
        }

        <div class="mt-4.5 flex flex-col gap-3 text-[15px] text-[color:var(--color-blue-700)]">
          {
            address.value && (
              <p class="flex gap-2 whitespace-pre-line" lang={address.isFallback ? address.lang : undefined}>
                <Icon name="map-pin" size={20} class="mt-0.5 flex-none" />
                <span class="text-[color:var(--color-ink-600)]">
                  <b class="mb-1 block text-[color:var(--color-ink-900)]">
                    {t(lang, 'footerContactHeading')}
                  </b>
                  {address.value}
                </span>
              </p>
            )
          }
          {
            settings.phone && (
              <p class="flex items-center gap-2">
                <Icon name="phone" size={20} />
                <span class="text-[color:var(--color-ink-600)]">{settings.phone}</span>
              </p>
            )
          }
          {
            settings.email && (
              <p class="flex items-center gap-2">
                <Icon name="envelope" size={20} />
                <a href={`mailto:${settings.email}`} class="text-[color:var(--color-blue-800)]">
                  {settings.email}
                </a>
              </p>
            )
          }
          {
            hours.value && (
              <p class="flex items-center gap-2">
                <Icon name="clock" size={20} />
                <span class="text-[color:var(--color-ink-400)]" lang={hours.isFallback ? hours.lang : undefined}>
                  {hours.value}
                </span>
              </p>
            )
          }
        </div>
      </div>

      <ContactForm lang={lang} variant="general" fallbackEmail={settings.email} />
    </div>

    {
      safeguarding.value && (
        <div class="wrap">
          <p
            class="mt-6.5 flex gap-3 rounded-[var(--radius-md)] bg-[color:var(--color-blue-200)] px-4.5 py-4 text-[14.5px] text-[color:var(--color-ink-700)]"
            lang={safeguarding.isFallback ? safeguarding.lang : undefined}
          >
            <Icon name="shield-exclamation" size={20} class="mt-0.5 flex-none text-[#0A55A0]" />
            <span>{safeguarding.value}</span>
          </p>
        </div>
      )
    }
  </section>
</BaseLayout>
