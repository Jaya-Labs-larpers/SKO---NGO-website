---
import type { Locale } from '~/lib/i18n/config';
import type { UIKey } from '~/lib/i18n/strings';
import { getSiteSettings } from '~/lib/content';
import { pick, t } from '~/lib/i18n/utils';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHero from '~/components/content/PageHero.astro';
import ContactForm from '~/components/forms/ContactForm.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const settings = await getSiteSettings();
const address = pick(settings.address, lang);
const hours = pick(settings.officeHours, lang);
const safeguarding = pick(settings.safeguardingContact, lang);
const heading = t(lang, 'pageContact');
const formId = 'form-contact';
const tel = (phone: string) => `tel:${phone.replace(/[^+\d]/g, '')}`;
const nextSteps: UIKey[] = ['nextStep1', 'nextStep2', 'nextStep3'];
---

<BaseLayout
  headerOverlay
  lang={lang}
  title={t(lang, 'seoContact') || heading}
  description={t(lang, 'metaContact') || t(lang, 'introContact')}
>
  <PageHero
    lang={lang}
    title={heading}
    intro={t(lang, 'introContact')}
    trail={[{ label: heading }]}
  />

  <section class="section pb-0">
    <div class="wrap">
      <dl class="contact-details contact-enter max-w-none" data-enter="pending">
        {
          settings.phone && (
            <div class="contact-details__item">
              <dt>{t(lang, 'contactCall')}</dt>
              <dd>
                <a href={tel(settings.phone)}>{settings.phone}</a>
                {hours.value && (
                  <span
                    class="contact-details__meta"
                    lang={hours.isFallback ? hours.lang : undefined}
                  >
                    {hours.value}
                  </span>
                )}
              </dd>
            </div>
          )
        }
        {
          settings.email && (
            <div class="contact-details__item">
              <dt>{t(lang, 'contactEmail')}</dt>
              <dd>
                <a href={`mailto:${settings.email}`} class="break-all">
                  {settings.email}
                </a>
                <span class="contact-details__meta">{t(lang, 'contactEmailAction')}</span>
              </dd>
            </div>
          )
        }
        {
          address.value && (
            <div class="contact-details__item">
              <dt>{t(lang, 'contactVisit')}</dt>
              <dd>
                <span
                  class="whitespace-pre-line"
                  lang={address.isFallback ? address.lang : undefined}
                >
                  {address.value}
                </span>
                {settings.mapUrl && (
                  <a
                    href={settings.mapUrl}
                    rel="noopener noreferrer"
                    target="_blank"
                    class="contact-details__meta"
                  >
                    {t(lang, 'viewOnGoogleMaps')}
                  </a>
                )}
              </dd>
            </div>
          )
        }
      </dl>
    </div>
  </section>

  {
    /*
    Which extra questions show — and whether the form gives way to the
    safeguarding panel — follows the reason chosen in the form, in pure CSS on
    :has(), so the page works before (and without) any script.
  */
  }
  <section class="section contact-desk pt-10 lg:pt-12">
    <div class="wrap">
      <div class="grid items-start gap-8 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-10">
        <div>
          <ContactForm lang={lang} id={formId} />

          <div
            class="safeguarding-panel"
            role="region"
            aria-label={t(lang, 'safeguardingPanelTitle')}
          >
            <h2 class="safeguarding-panel__title">
              {t(lang, 'safeguardingPanelTitle')}
            </h2>
            {
              safeguarding.value && (
                <p
                  class="safeguarding-panel__body"
                  lang={safeguarding.isFallback ? safeguarding.lang : undefined}
                >
                  {safeguarding.value}
                </p>
              )
            }
            <div class="mt-5 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
              {
                settings.phone && (
                  <a href={tel(settings.phone)} class="btn btn-primary">
                    {settings.phone}
                  </a>
                )
              }
              {
                settings.safeguardingEmail && (
                  <a
                    href={`mailto:${settings.safeguardingEmail}`}
                    class="btn btn-secondary break-all"
                  >
                    {settings.safeguardingEmail}
                  </a>
                )
              }
            </div>
          </div>
        </div>

        <aside
          class="contact-next contact-enter lg:sticky lg:top-[calc(var(--header-offset)+1.5rem)]"
          data-enter="pending"
        >
          <h2 class="contact-next__title">{t(lang, 'nextTitle')}</h2>
          <ol class="contact-next__steps">
            {nextSteps.map((step) => <li>{t(lang, step)}</li>)}
          </ol>
          {
            hours.value && (
              <div class="contact-next__block">
                <b>{t(lang, 'nextHours')}</b>
                <span lang={hours.isFallback ? hours.lang : undefined}>{hours.value}</span>
              </div>
            )
          }
          <p class="contact-next__block contact-next__privacy">
            {t(lang, 'nextPrivacy')}
          </p>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

{
  /*
  The three boxes arrive one after another as each comes into view: a slow
  rise that sharpens from a blur (.contact-enter, global.css). The form's own
  rows follow inside that window. A box already on screen at load goes first.
*/
}
<script>
  const ENTER_MS = 2000;
  const STAGGER_MS = 180;
  const boxes = Array.from(document.querySelectorAll<HTMLElement>('.contact-enter'));

  const show = (box: HTMLElement, index: number) => {
    const delay = index * STAGGER_MS;
    box.style.setProperty('--enter-delay', `${delay}ms`);
    box.dataset.enter = 'shown';
    setTimeout(
      () => {
        box.dataset.enter = 'done';
        box.style.removeProperty('--enter-delay');
      },
      delay + ENTER_MS + 900,
    );
  };

  if (typeof IntersectionObserver !== 'function') {
    boxes.forEach(show);
  } else {
    const arrival = new IntersectionObserver(
      (entries) => {
        entries
          .filter((entry) => entry.isIntersecting)
          .forEach((entry, index) => {
            arrival.unobserve(entry.target);
            show(entry.target as HTMLElement, index);
          });
      },
      { threshold: 0.05 },
    );
    boxes.forEach((box) => arrival.observe(box));
  }
</script>
