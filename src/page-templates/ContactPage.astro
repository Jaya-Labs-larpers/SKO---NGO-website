---
import type { Locale } from '~/lib/i18n/config';
import type { UIKey } from '~/lib/i18n/strings';
import { getSiteSettings } from '~/lib/content';
import { pick, t } from '~/lib/i18n/utils';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHero from '~/components/content/PageHero.astro';
import ContactForm from '~/components/forms/ContactForm.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const settings = await getSiteSettings();
const address = pick(settings.address, lang);
const hours = pick(settings.officeHours, lang);
const safeguarding = pick(settings.safeguardingContact, lang);
const heading = t(lang, 'pageContact');
const formId = 'form-contact';
const tel = (phone: string) => `tel:${phone.replace(/[^+\d]/g, '')}`;
const nextSteps: UIKey[] = ['nextStep1', 'nextStep2', 'nextStep3'];
---

<BaseLayout headerOverlay lang={lang} title={heading} description={t(lang, 'introContact')}>
  <PageHero lang={lang} title={heading} intro={t(lang, 'introContact')} trail={[{ label: heading }]} />

  <section class="section pb-0">
    <div class="wrap">
    <dl class="contact-details max-w-none">
      {
        settings.phone && (
          <div>
            <dt>{t(lang, 'contactCall')}</dt>
            <dd>
              <a href={tel(settings.phone)}>{settings.phone}</a>
              {hours.value && (
                <span class="contact-details__meta" lang={hours.isFallback ? hours.lang : undefined}>
                  {hours.value}
                </span>
              )}
            </dd>
          </div>
        )
      }
      {
        settings.email && (
          <div>
            <dt>{t(lang, 'contactEmail')}</dt>
            <dd>
              <a href={`mailto:${settings.email}`} class="break-all">{settings.email}</a>
            </dd>
          </div>
        )
      }
      {
        address.value && (
          <div>
            <dt>{t(lang, 'contactVisit')}</dt>
            <dd>
              <span class="whitespace-pre-line" lang={address.isFallback ? address.lang : undefined}>
                {address.value}
              </span>
              {settings.mapUrl && (
                <a href={settings.mapUrl} rel="noopener noreferrer" target="_blank" class="contact-details__meta">
                  {t(lang, 'viewOnGoogleMaps')}
                </a>
              )}
            </dd>
          </div>
        )
      }
    </dl>
    </div>
  </section>

  {/*
    Which extra questions show — and whether the form gives way to the
    safeguarding panel — follows the reason chosen in the form, in pure CSS on
    :has(), so the page works before (and without) any script.
  */}
  <section class="section contact-desk pt-10 lg:pt-12">
    <div class="wrap">
      <div class="grid items-start gap-8 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-10">
        <div>
          <ContactForm lang={lang} id={formId} />

          <div class="safeguarding-panel" role="region" aria-label={t(lang, 'safeguardingPanelTitle')}>
            <h2 class="safeguarding-panel__title">{t(lang, 'safeguardingPanelTitle')}</h2>
            {
              safeguarding.value && (
                <p class="safeguarding-panel__body" lang={safeguarding.isFallback ? safeguarding.lang : undefined}>
                  {safeguarding.value}
                </p>
              )
            }
            <div class="mt-5 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
              {
                settings.phone && (
                  <a href={tel(settings.phone)} class="btn btn-primary">
                    {settings.phone}
                  </a>
                )
              }
              {
                settings.safeguardingEmail && (
                  <a href={`mailto:${settings.safeguardingEmail}`} class="btn btn-secondary break-all">
                    {settings.safeguardingEmail}
                  </a>
                )
              }
            </div>
          </div>
        </div>

        <aside class="contact-next lg:sticky lg:top-[calc(var(--header-offset)+1.5rem)]">
          <h2 class="contact-next__title">{t(lang, 'nextTitle')}</h2>
          <ol class="contact-next__steps">
            {nextSteps.map((step) => <li>{t(lang, step)}</li>)}
          </ol>
          {
            hours.value && (
              <div class="contact-next__block">
                <b>{t(lang, 'nextHours')}</b>
                <span lang={hours.isFallback ? hours.lang : undefined}>{hours.value}</span>
              </div>
            )
          }
          <p class="contact-next__block contact-next__privacy">{t(lang, 'nextPrivacy')}</p>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

{/* Links from elsewhere on the site arrive as /contact/?topic=partner and so on. */}
<script>
  const topic = new URLSearchParams(window.location.search).get('topic');
  if (topic) {
    const reason = document.querySelector<HTMLSelectElement>('select[name="formType"]');
    if (reason && Array.from(reason.options).some((option) => option.value === topic)) reason.value = topic;
  }
</script>
