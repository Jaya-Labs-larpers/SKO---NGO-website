---
import type { Locale } from '~/lib/i18n/config';
import { getSiteSettings } from '~/lib/content';
import { pick, t } from '~/lib/i18n/utils';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHero from '~/components/content/PageHero.astro';
import ContactForm from '~/components/forms/ContactForm.astro';
import Icon from '~/components/Icon.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const settings = await getSiteSettings();
const address = pick(settings.address, lang);
const hours = pick(settings.officeHours, lang);
const safeguarding = pick(settings.safeguardingContact, lang);
const heading = t(lang, 'pageContact');
---

<BaseLayout lang={lang} title={heading} description={t(lang, 'introContact')}>
  <PageHero lang={lang} title={heading} trail={[{ label: heading }]} />

  <section class="section">
    <!--
      Information first, form second — in the DOM as well as on screen. On a
      phone the grid collapses to one column in source order, so a visitor
      reads the address, phone and email before being asked to type anything.
      On desktop the form takes the right-hand column and sticks there while
      the contact details scroll past it.
    -->
    {
      safeguarding.value && (
        <div class="wrap">
          <p
            class="mb-8 rounded-[var(--radius-md)] bg-[color:var(--color-blue-200)] px-4.5 py-4 text-[14.5px] text-[color:var(--color-ink-700)]"
            lang={safeguarding.isFallback ? safeguarding.lang : undefined}
          >
            {safeguarding.value}
          </p>
        </div>
      )
    }

    <div class="wrap grid items-start gap-9 lg:grid-cols-[1fr_minmax(0,29rem)] lg:gap-12">
      <div>
        {/*
          There is no static map image, and there was never going to be one
          without a maps API key. What stood here was an empty framed box
          reading "[STATIC MAP IMAGE → LINKS TO GOOGLE MAPS]" — a note to the
          build team wrapped in a link. The address below and the Google Maps
          link are the part that actually gets someone to the office.
        */}
        {
          settings.mapUrl && (
            <a
              href={settings.mapUrl}
              rel="noopener noreferrer"
              target="_blank"
              class="link-arrow inline-flex"
            >
              {t(lang, 'viewOnGoogleMaps')}
              <Icon name="arrow-top-right-on-square" size={16} class="arrow" />
            </a>
          )
        }

        <div class="mt-3.5 flex flex-col gap-3 text-[15px] text-[color:var(--color-blue-700)]">
          {
            address.value && (
              <p class="whitespace-pre-line" lang={address.isFallback ? address.lang : undefined}>
                <span class="text-[color:var(--color-ink-600)]">
                  <b class="mb-1 block text-[color:var(--color-ink-900)]">
                    {t(lang, 'footerContactHeading')}
                  </b>
                  {address.value}
                </span>
              </p>
            )
          }
          {
            settings.phone && (
              <p>
                <span class="text-[color:var(--color-ink-600)]">{settings.phone}</span>
              </p>
            )
          }
          {
            settings.email && (
              <p>
                <a href={`mailto:${settings.email}`} class="text-[color:var(--color-blue-800)]">
                  {settings.email}
                </a>
              </p>
            )
          }
          {
            hours.value && (
              <p>
                <span class="text-[color:var(--color-ink-400)]" lang={hours.isFallback ? hours.lang : undefined}>
                  {hours.value}
                </span>
              </p>
            )
          }
        </div>
      </div>

      <ContactForm
        lang={lang}
        variant="general"
        class="lg:sticky lg:top-[calc(var(--header-h)+1.5rem)]"
      />
    </div>

  </section>
</BaseLayout>
