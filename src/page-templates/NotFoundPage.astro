---
import type { Locale } from '~/lib/i18n/config';
import { localizePath, t } from '~/lib/i18n/utils';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Icon from '~/components/ui/Icon.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
---

<BaseLayout lang={lang} title={t(lang, 'notFoundTitle')} noindex>
  <section class="wrap pt-8 lg:pt-14">
    <div class="grid gap-x-10 gap-y-4 border-y border-line-ink py-12 lg:grid-cols-12 lg:py-20">
      <p class="mono mono-lg text-terracotta-700 lg:col-span-3">404</p>
      <div class="lg:col-span-9">
        <h1 class="text-[length:var(--text-h1)] leading-[var(--text-h1--line-height)] tracking-[var(--text-h1--letter-spacing)]">
          {t(lang, 'notFoundTitle')}
        </h1>
        <p class="mt-4 max-w-[48ch] text-[length:var(--text-lead)] text-ink-600">{t(lang, 'notFoundBody')}</p>
        <a href={localizePath('/', lang)} class="btn btn-primary mt-8">
          {t(lang, 'notFoundCta')}
          <Icon name="arrow-right" size={16} />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
