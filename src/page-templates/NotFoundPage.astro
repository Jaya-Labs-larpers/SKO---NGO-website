---
import type { Locale } from '~/lib/i18n/config';
import { localizePath, t } from '~/lib/i18n/utils';
import BaseLayout from '~/layouts/BaseLayout.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
---

<BaseLayout lang={lang} title={t(lang, 'notFoundTitle')} noindex>
  <section
    class="mx-auto flex max-w-[var(--container-page)] flex-col items-start gap-6 px-[var(--gutter-left)] py-[clamp(88px,9vw,136px)]"
  >
    <p class="eyebrow">404</p>
    <h1 class="t-xl m-0">{t(lang, 'notFoundTitle')}</h1>
    <p class="t-lead-sm m-0 max-w-[48ch]">{t(lang, 'notFoundBody')}</p>
    <a href={localizePath('/', lang)} class="btn btn-primary btn-lg">{t(lang, 'notFoundCta')}</a>
  </section>
</BaseLayout>
