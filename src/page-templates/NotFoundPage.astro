---
import type { Locale } from '~/lib/i18n/config';
import { localizePath, t } from '~/lib/i18n/utils';
import BaseLayout from '~/layouts/BaseLayout.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
---

<BaseLayout lang={lang} title={t(lang, 'notFoundTitle')} noindex>
  <section class="section">
    <div class="wrap py-16">
      <p class="eyebrow">404</p>
      <h1 class="mt-3 text-[length:var(--text-h1)] leading-[var(--text-h1--line-height)]">
        {t(lang, 'notFoundTitle')}
      </h1>
      <p class="mt-4 text-[length:var(--text-lead)] text-[color:var(--color-ink-400)]">
        {t(lang, 'notFoundBody')}
      </p>
      <a href={localizePath('/', lang)} class="btn btn-primary mt-7">{t(lang, 'notFoundCta')}</a>
    </div>
  </section>
</BaseLayout>
