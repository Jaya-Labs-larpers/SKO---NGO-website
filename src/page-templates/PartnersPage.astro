---
import type { Locale } from '~/lib/i18n/config';
import { getPartners } from '~/lib/content';
import { t } from '~/lib/i18n/utils';
import { partnerCategoryLabels } from '~/lib/labels';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeading from '~/components/content/PageHeading.astro';
import PartnerIndex from '~/components/content/PartnerIndex.astro';
import EmptyState from '~/components/content/EmptyState.astro';
import CloseBand from '~/components/content/CloseBand.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const partners = await getPartners();
const heading = t(lang, 'pagePartners');

const groups = [...new Set(partners.map((partner) => partner.category ?? 'other'))];
---

<BaseLayout lang={lang} title={heading} description={t(lang, 'introPartners')}>
  <PageHeading lang={lang} title={heading} intro={t(lang, 'introPartners')} trail={[{ label: heading }]} />

  <section class="wrap pt-4 lg:pt-8">
    {
      partners.length === 0 ? (
        <EmptyState message={t(lang, 'emptyGeneric')} />
      ) : (
        groups.map((group) => (
          <div class="ledger">
            <h2 class="text-[length:var(--text-h3)] leading-[var(--text-h3--line-height)] tracking-[var(--text-h3--letter-spacing)]">{partnerCategoryLabels[group]?.[lang] ?? group}</h2>
            <PartnerIndex
              lang={lang}
              partners={partners.filter((partner) => (partner.category ?? 'other') === group)}
              categories={false}
            />
          </div>
        ))
      )
    }
  </section>

  <CloseBand lang={lang} title={t(lang, 'ctaPartnersTitle')} />
</BaseLayout>
