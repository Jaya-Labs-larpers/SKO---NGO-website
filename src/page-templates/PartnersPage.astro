---
import type { Locale } from '~/lib/i18n/config';
import { getPartners } from '~/lib/content';
import { t } from '~/lib/i18n/utils';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHero from '~/components/content/PageHero.astro';
import PartnerWall from '~/components/content/PartnerWall.astro';
import EmptyState from '~/components/content/EmptyState.astro';
import CtaBand from '~/components/content/CtaBand.astro';
import { stripInlineLinks } from '~/lib/inline-links';
import { partnersJsonLd } from '~/lib/seo/page-schema';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const partners = await getPartners();
const heading = t(lang, 'pagePartners');

const categoryLabels: Record<string, Record<Locale, string>> = {
  'un-agency': { en: 'UN agencies', km: 'ទីភ្នាក់ងារអង្គការសហប្រជាជាតិ' },
  ingo: { en: 'International NGOs', km: 'អង្គការក្រៅរដ្ឋាភិបាលអន្តរជាតិ' },
  government: { en: 'Government', km: 'រដ្ឋាភិបាល' },
  foundation: { en: 'Foundations', km: 'មូលនិធិ' },
  corporate: { en: 'Corporate', km: 'ក្រុមហ៊ុន' },
};

const groups = [...new Set(partners.map((partner) => partner.category ?? 'other'))];
const title = t(lang, 'seoPartners') || heading;
const description = t(lang, 'metaPartners') || stripInlineLinks(t(lang, 'introPartners'));
const partnerList = partnersJsonLd({ name: title, partners });
---

<BaseLayout lang={lang} title={title} description={description} jsonLd={partnerList}>
  <PageHero
    lang={lang}
    title={heading}
    intro={t(lang, 'introPartners')}
    trail={[{ label: heading }]}
  />
  <section
    aria-label={heading}
    class="mx-auto flex max-w-[var(--container-page)] flex-col px-[var(--gutter-left)] pb-[clamp(88px,9vw,128px)]"
  >
    {
      partners.length === 0 ? (
        <EmptyState message={t(lang, 'emptyGeneric')} />
      ) : (
        groups.map((group) => (
          <div class="grid [grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr))] gap-x-10 gap-y-6 border-t-[3px] border-t-[color:var(--color-ink-900)] py-10">
            <h2 class="eyebrow !text-sm !text-[color:var(--color-blue-700)]">
              {categoryLabels[group]?.[lang] ?? group}
            </h2>
            <div class="min-w-0 md:col-span-3">
              <PartnerWall
                lang={lang}
                variant="cards"
                partners={partners.filter((partner) => (partner.category ?? 'other') === group)}
              />
            </div>
          </div>
        ))
      )
    }
  </section>
  <CtaBand lang={lang} title={t(lang, 'ctaPartnersTitle')} />
</BaseLayout>
