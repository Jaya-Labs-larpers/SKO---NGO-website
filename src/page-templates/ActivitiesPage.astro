---
import type { Locale } from '~/lib/i18n/config';
import type { Activity } from '~/lib/content/types';
import { localizePath, pick, t } from '~/lib/i18n/utils';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHero from '~/components/content/PageHero.astro';
import ActivityCard from '~/components/content/ActivityCard.astro';
import EmptyState from '~/components/content/EmptyState.astro';
import Pagination from '~/components/content/Pagination.astro';
import { cardGridCols, cardImageSizes } from '~/lib/grid';
import { stripInlineLinks } from '~/lib/inline-links';
import { canonicalUrl, collectionPageJsonLd } from '~/lib/seo/page-schema';

interface Props {
  lang: Locale;
  activities: Activity[];
  currentPage: number;
  totalPages: number;
}

const { lang, activities, currentPage, totalPages } = Astro.props;
const heading = t(lang, 'pageActivities');

const hrefFor = (page: number) =>
  page === 1 ? localizePath('/activities', lang) : localizePath(`/activities/page/${page}`, lang);

const title = t(lang, 'seoActivities') || heading;
const description = t(lang, 'metaActivities') || stripInlineLinks(t(lang, 'introActivities'));
const collection = collectionPageJsonLd({
  pathname: Astro.url.pathname,
  name: title,
  description,
  parts: activities.map((activity) => ({
    name: pick(activity.title, lang).value ?? '',
    url: canonicalUrl(localizePath(`/activities/${activity.slug}`, lang)),
  })),
});
---

<BaseLayout
  headerOverlay
  lang={lang}
  title={title}
  description={description}
  noindex={currentPage > 1}
  jsonLd={collection}
>
  <PageHero
    lang={lang}
    title={heading}
    intro={t(lang, 'introActivities')}
    trail={[{ label: heading }]}
  />
  <section class="section" aria-labelledby="all-activities">
    <div class="wrap">
      <h2 id="all-activities" class="sr-only">{t(lang, 'allActivities')}</h2>
      {
        activities.length === 0 ? (
          <EmptyState message={t(lang, 'emptyActivities')} />
        ) : (
          <div class={cardGridCols(activities.length)}>
            {activities.map((activity) => (
              <ActivityCard
                lang={lang}
                activity={activity}
                sizes={cardImageSizes(activities.length)}
              />
            ))}
          </div>
        )
      }
      <Pagination lang={lang} current={currentPage} total={totalPages} hrefFor={hrefFor} />
    </div>
  </section>
</BaseLayout>
