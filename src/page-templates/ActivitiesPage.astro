---
import type { Locale } from '~/lib/i18n/config';
import type { Activity } from '~/lib/content/types';
import { localizePath, t } from '~/lib/i18n/utils';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeading from '~/components/content/PageHeading.astro';
import ActivitySpread from '~/components/content/ActivitySpread.astro';
import EmptyState from '~/components/content/EmptyState.astro';
import Pagination from '~/components/content/Pagination.astro';

interface Props {
  lang: Locale;
  activities: Activity[];
  currentPage: number;
  totalPages: number;
}

const { lang, activities, currentPage, totalPages } = Astro.props;
const heading = t(lang, 'pageActivities');

const hrefFor = (page: number) =>
  page === 1 ? localizePath('/activities', lang) : localizePath(`/activities/page/${page}`, lang);
---

<BaseLayout lang={lang} title={heading} description={t(lang, 'introActivities')} noindex={currentPage > 1}>
  <PageHeading lang={lang} title={heading} intro={t(lang, 'introActivities')} trail={[{ label: heading }]} />
  <section class="wrap pt-4 lg:pt-8">
    {
      activities.length === 0 ? (
        <EmptyState message={t(lang, 'emptyActivities')} />
      ) : (
        <div class="border-b border-line">
          {activities.map((activity, index) => (
            <ActivitySpread lang={lang} activity={activity} eager={index === 0} />
          ))}
        </div>
      )
    }
    <Pagination lang={lang} current={currentPage} total={totalPages} hrefFor={hrefFor} />
  </section>
</BaseLayout>
