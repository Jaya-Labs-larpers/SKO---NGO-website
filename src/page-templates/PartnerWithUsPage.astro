---
import type { Locale } from '~/lib/i18n/config';
import { getPage } from '~/lib/content';
import { pick, t } from '~/lib/i18n/utils';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHero from '~/components/content/PageHero.astro';
import RichText from '~/components/content/RichText.astro';
import ContactForm from '~/components/forms/ContactForm.astro';

interface Props {
  lang: Locale;
  variant: 'partner' | 'volunteer';
  slug: string;
}

const { lang, variant, slug } = Astro.props;

const page = await getPage(slug);
const title = pick(page?.title, lang);
const intro = pick(page?.intro, lang);
const heading = title.value ?? t(lang, variant === 'partner' ? 'pagePartnerInquiry' : 'pageVolunteer');
---

<BaseLayout lang={lang} title={heading} description={intro.value ?? undefined}>
  <PageHero
    lang={lang}
    title={heading}
    intro={intro.value}
    introLang={intro.isFallback ? intro.lang : undefined}
    trail={[{ label: heading }]}
  />
  <section class="section">
    <!--
      Information first, form second — in the DOM as well as on screen, so the
      single-column phone layout puts the page's own copy above the form.
    -->
    <div class="wrap grid items-start gap-9 lg:grid-cols-[1fr_minmax(0,29rem)] lg:gap-12">
      <RichText blocks={page?.body} lang={lang} />
      <ContactForm
        lang={lang}
        variant={variant}
        class="lg:sticky lg:top-[calc(var(--header-h)+1.5rem)]"
      />
    </div>
  </section>
</BaseLayout>
