---
import type { Locale } from '~/lib/i18n/config';
import { getPage } from '~/lib/content';
import { pick, t } from '~/lib/i18n/utils';
import type { UIKey } from '~/lib/i18n/strings';
import { blocksToPlainText } from '~/lib/portable-text';
import { resolveSeo } from '~/lib/seo';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeading from '~/components/content/PageHeading.astro';
import RichText from '~/components/content/RichText.astro';
import FaqSection from '~/components/content/FaqSection.astro';
import type { Crumb } from '~/lib/breadcrumbs';

interface Props {
  lang: Locale;
  slug: string;
  /** Used when the CMS page is missing entirely. */
  fallbackTitleKey: UIKey;
  trail?: Crumb[];
}

const { lang, slug, fallbackTitleKey, trail } = Astro.props;

const page = await getPage(slug);
const title = pick(page?.title, lang);
const intro = pick(page?.intro, lang);
const heading = title.value ?? t(lang, fallbackTitleKey);
const seo = resolveSeo(page?.seo, lang, {
  title: heading,
  description: intro.value ?? blocksToPlainText(pick(page?.body, lang).value),
  image: page?.heroImage,
});
---

<BaseLayout
  lang={lang}
  title={seo.title}
  description={seo.description}
  ogImage={seo.ogImage}
  noindex={seo.noindex}
>
  <PageHeading
    lang={lang}
    title={heading}
    titleLang={title.isFallback ? title.lang : undefined}
    intro={intro.value}
    introLang={intro.isFallback ? intro.lang : undefined}
    trail={trail ?? [{ label: heading }]}
  />

  <section class="wrap grid gap-x-10 gap-y-10 pt-10 lg:grid-cols-12 lg:pt-14">
    <div class="lg:col-span-8 lg:col-start-1">
      <RichText blocks={page?.body} lang={lang} />
    </div>
    <slot />
  </section>

  {page?.faqs && page.faqs.length > 0 && <FaqSection lang={lang} faqs={page.faqs} />}

  <slot name="after" />
</BaseLayout>
