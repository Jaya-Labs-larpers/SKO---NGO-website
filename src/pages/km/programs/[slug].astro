---
import { getProgram, getPrograms } from '~/lib/content';
import ProgramDetail from '~/page-templates/ProgramDetail.astro';
import type { Program } from '~/lib/content/types';

export async function getStaticPaths() {
  const list = await getPrograms();
  const detailed = await Promise.all(list.map((entry) => getProgram(entry.slug)));
  return detailed
    .map((program) => (program ? { params: { slug: program.slug }, props: { program } } : null))
    .filter((route): route is NonNullable<typeof route> => route !== null);
}

const { program } = Astro.props as { program: Program };
---

<!--
  Route shell. All page markup lives in src/page-templates/ so the English and
  Khmer routes render from one source and can never drift apart.
  Locale: km
-->
<ProgramDetail lang="km" program={program} />
