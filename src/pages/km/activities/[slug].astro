---
import { getActivities, getActivity } from '~/lib/content';
import ActivityDetail from '~/page-templates/ActivityDetail.astro';
import type { Activity } from '~/lib/content/types';

export async function getStaticPaths() {
  const list = await getActivities();
  const detailed = await Promise.all(list.map((entry) => getActivity(entry.slug)));

  return detailed
    .map((activity, index) =>
      activity
        ? {
            params: { slug: activity.slug },
            // Newest first, so "previous" is the newer post.
            props: {
              activity,
              previous: list[index - 1] ?? null,
              next: list[index + 1] ?? null,
            },
          }
        : null,
    )
    .filter((route): route is NonNullable<typeof route> => route !== null);
}

const { activity, previous, next } = Astro.props as {
  activity: Activity;
  previous: Activity | null;
  next: Activity | null;
};
---

<!--
  Route shell. All page markup lives in src/page-templates/ so the English and
  Khmer routes render from one source and can never drift apart.
  Locale: km
-->
<ActivityDetail lang="km" activity={activity} previous={previous} next={next} />
