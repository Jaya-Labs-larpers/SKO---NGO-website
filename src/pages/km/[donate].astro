---
import type { GetStaticPaths } from 'astro';
import DonatePage from '~/page-templates/DonatePage.astro';
import { donationEnabled } from '~/lib/donation';

// The one path this route builds is /donate/, and only while donations are switched on.
export const getStaticPaths = (() =>
  donationEnabled ? [{ params: { donate: 'donate' } }] : []) satisfies GetStaticPaths;
---

<!--
  Route shell. All page markup lives in src/page-templates/ so the English and
  Khmer routes render from one source and can never drift apart.
  Locale: km
-->
<DonatePage lang="km" />
