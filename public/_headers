# Applied to static asset responses by Cloudflare Workers. Responses generated
# by worker/index.ts (the /api/* routes) set their own headers.
#
# The page-level Content-Security-Policy lives in each HTML file's <meta> tag,
# written per page by scripts/csp.mjs. Only frame-ancestors is here, because a
# meta-delivered policy cannot express it.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: frame-ancestors 'none'

# Astro content-hashes everything under /_astro/, so it is safe to cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=86400
