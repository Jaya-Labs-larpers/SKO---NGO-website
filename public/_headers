/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: frame-ancestors 'none'

# ---------------------------------------------------------------------------
# The full Content-Security-Policy is delivered per page in a <meta http-equiv>
# tag, generated by scripts/csp.mjs after the Astro build.
#
# Why not here: every page carries structured data in an inline
# <script type="application/ld+json">, and Chrome enforces script-src against
# those blocks (verified — it logs "Executing inline script violates… The action
# has been blocked"). A strict policy therefore needs a hash per inline block.
# Those hashes differ per page and change whenever staff edit content, so a
# static file cannot hold them, and a union of every page's hashes would be
# kilobytes on every response.
#
# `frame-ancestors` is the one directive a meta-delivered policy cannot set, so
# it stays here — together with X-Frame-Options for older clients.
# ---------------------------------------------------------------------------

# Hashed build assets never change under the same URL.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# The form endpoint must never be cached.
/api/*
  Cache-Control: no-store
