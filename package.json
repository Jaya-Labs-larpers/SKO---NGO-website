{
  "name": "sko-website",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Bilingual (km/en) website for Samatapheap Khnom Organization",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/csp.mjs && node scripts/not-found.mjs && node scripts/check-build.mjs",
    "build:production": "PUBLIC_DEPLOYMENT_ENV=production npm run build",
    "check": "npm test && npm run typecheck && npm run build",
    "check:edge": "node scripts/check-edge.mjs",
    "check:config": "node scripts/check-config.mjs",
    "test": "node --test tests/*.test.mjs",
    "preview": "npm run build && wrangler dev",
    "preview:astro": "astro preview",
    "deploy:rehearsal": "wrangler deploy --env \"\"",
    "deploy:production": "wrangler deploy --env production",
    "verify": "npm run build",
    "typecheck": "astro check && tsc --noEmit",
    "format": "prettier --write \"**/*.{astro,ts,js,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{astro,ts,js,json,css,md}\"",
    "studio": "npm --prefix studio run dev",
    "studio:deploy": "npm --prefix studio run deploy"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@sanity/client": "7.26.0",
    "@sanity/image-url": "1.2.0",
    "astro": "7.3.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.3",
    "prettier": "3.9.8",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "wrangler": "4.135.0"
  }
}
