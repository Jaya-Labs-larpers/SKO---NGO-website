{
  "name": "sko-website",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Bilingual (km/en) website for Samatapheap Khnom Organization",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/csp.mjs",
    "preview:astro": "astro preview",
    "preview": "npm run build && wrangler pages dev dist --compatibility-date=2026-01-01",
    "verify": "npm run build && node scripts/check-build.mjs",
    "typecheck": "astro check && tsc --noEmit",
    "format": "prettier --write \"**/*.{astro,ts,js,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{astro,ts,js,json,css,md}\"",
    "studio": "npm --prefix studio run dev",
    "studio:deploy": "npm --prefix studio run deploy"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "@sanity/client": "7.26.0",
    "@sanity/image-url": "1.2.0",
    "astro": "7.1.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.3",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.6.14",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "wrangler": "4.118.0"
  }
}
