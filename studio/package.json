{
  "name": "sko-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Sanity Studio for the SKO website",
  "comment": "Deliberately NOT an npm workspace of the root project. Cloudflare Pages runs `npm install` at the repo root on every build; a workspace would drag Sanity's React toolchain into a production build of a site that ships no React. Run `cd studio && npm install` once, locally.",
  "scripts": {
    "dev": "sanity dev",
    "start": "sanity start",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@sanity/vision": "6.20.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanity": "6.20.0",
    "styled-components": "6.6.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.3.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@vercel/frameworks": {
      "js-yaml": "3.15.2",
      "smol-toml": "1.9.1"
    },
    "@module-federation/dts-plugin": {
      "adm-zip": "0.6.1",
      "undici": "7.30.1"
    },
    "typeid-js": {
      "uuid": "11.1.1"
    },
    "undici@7.29.1": "7.30.1",
    "vite": "8.3.4",
    "dompurify": "3.4.17",
    "zod": "4.6.7"
  }
}
